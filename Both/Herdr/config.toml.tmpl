onboarding = false

[keys]
prefix = "ctrl+b"
help = "prefix+?"
settings = "prefix+shift+s"
detach = "prefix+d"
reload_config = "prefix+r"
open_notification_target = "prefix+shift+o"
workspace_picker = "prefix+s"
goto = "prefix+w"
new_workspace = "prefix+c"
new_worktree = "prefix+shift+g"
open_worktree = ""
remove_worktree = ""
rename_workspace = "prefix+comma"
close_workspace = ""
previous_workspace = "prefix+p"
next_workspace = "prefix+n"
previous_agent = ""
next_agent = ""
focus_agent = ""
remote_image_paste = "ctrl+v"
new_tab = "prefix+shift+c"
rename_tab = "prefix+shift+comma"
previous_tab = "prefix+shift+p"
next_tab = "prefix+shift+n"
switch_tab = "prefix+1..9"
switch_workspace = ""
close_tab = ""
rename_pane = "prefix+<"
edit_scrollback = "prefix+e"
copy_mode = ["prefix+[", "prefix+y"]
focus_pane_left = "ctrl+h"
focus_pane_down = "ctrl+l"
focus_pane_up = "ctrl+k"
focus_pane_right = "ctrl+j"
swap_pane_left = "prefix+h"
swap_pane_down = "prefix+j"
swap_pane_up = "prefix+k"
swap_pane_right = "prefix+l"
cycle_pane_next = "prefix+o"
cycle_pane_previous = ""
last_pane = "prefix+;"
split_vertical = "prefix+%"
split_horizontal = 'prefix+"'
close_pane = "prefix+x"
zoom = "prefix+z"
resize_mode = "prefix+shift+r"
toggle_sidebar = "prefix+b"
navigate_workspace_up = "up"
navigate_workspace_down = "down"
navigate_pane_left = "h"
navigate_pane_down = "j"
navigate_pane_up = "k"
navigate_pane_right = "l"

[keys.indexed]
tabs = ""
workspaces = ""
agents = ""

[[keys.command]]
key = "prefix+ctrl+p"
type = "popup"
{{ if eq .OS "windows" -}}
command = "powershell.exe -NoLogo"
{{ else -}}
command = "exec \"${SHELL:-sh}\""
{{ end -}}
description = "open scratch shell"
width = "90%"
height = "90%"
