{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "editorMode": "vim",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "code-documentation@claude-code-workflows": true,
    "code-refactoring@claude-code-workflows": true,
    "codebase-cleanup@claude-code-workflows": true,
    "comprehensive-review@claude-code-workflows": true,
    "database-design@claude-code-workflows": true,
    "database-migrations@claude-code-workflows": true,
    "debugging-toolkit@claude-code-workflows": true,
    "dependency-management@claude-code-workflows": true,
    "deployment-strategies@claude-code-workflows": true,
    "deployment-validation@claude-code-workflows": true,
    "framework-migration@claude-code-workflows": true,
    "full-stack-orchestration@claude-code-workflows": true,
    "gopls-lsp@claude-plugins-official": true,
    "javascript-typescript@claude-code-workflows": true,
    "openviking-memory@openviking-local": true,
    "performance-testing-review@claude-code-workflows": true,
    "rdbg-debugger@rdbg": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "safety-net@cc-marketplace": true,
    "security-scanning@claude-code-workflows": true,
    "shell-scripting@claude-code-workflows": true,
    "superpowers@claude-plugins-official": true,
    "systems-programming@claude-code-workflows": true,
    "tdd-workflows@claude-code-workflows": true,
    "ui-design@claude-code-workflows": true,
    "unit-testing@claude-code-workflows": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "cc-marketplace": {
      "autoUpdate": true,
      "source": {
        "repo": "kenryu42/cc-marketplace",
        "source": "github"
      }
    },
    "claude-code-workflows": {
      "autoUpdate": true,
      "source": {
        "repo": "wshobson/agents",
        "source": "github"
      }
    },
    "openviking-local": {
      "autoUpdate": true,
      "source": {
        "path": "/home/antoinegs/.local/share/openviking-marketplace",
        "source": "directory"
      }
    },
    "rdbg": {
      "source": {
        "source": "url",
        "url": "https://sundaymorning.app/rdbg/.claude-plugin/marketplace.json"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/tmux-mark-window.sh waiting",
            "type": "command"
          },
          {
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\" >/dev/null 2>&1; true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\a.simard.MULTIDEV\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/antoinegs/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/tmux-mark-window.sh completed",
            "type": "command"
          },
          {
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\" >/dev/null 2>&1; true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/tmux-mark-window.sh clear",
            "type": "command"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen"
}