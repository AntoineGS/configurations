[Unit]
Description=Wake the primary monitor and hide the panels during %i remote sessions
After=graphical-session.target
PartOf=graphical-session.target
ConditionHost=antoinews-linux

[Service]
Type=simple
ExecStart=%h/.local/bin/remote-wake-monitor --watch %i
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
