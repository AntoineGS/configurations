#!/usr/bin/env bash
set -Eeuo pipefail

readonly PACKAGE_NAME=outlook-for-linux
readonly PACKAGE_VERSION=2.0.0_test.11-1
readonly PACKAGE_URL=https://github.com/AntoineGS/outlook-for-linux/releases/download/temp-build-11/outlook-for-linux-2.0.0-test.11-x86_64.pkg.tar.zst
readonly PACKAGE_SHA256=90fdf32e895e4d7af7d8d0c45fad5668ab06984ab59150c30815bdd1670c80c4

tmp_package=

cleanup() {
  if [[ -n $tmp_package ]]; then
    rm -f -- "$tmp_package"
  fi
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

check_installation() {
  local installed
  installed=$(pacman -Q "$PACKAGE_NAME" 2>/dev/null) || return 1
  [[ $installed == "$PACKAGE_NAME $PACKAGE_VERSION" ]]
}

apply_installation() {
  local required_command
  [[ $(uname -m) == x86_64 ]] || die 'Outlook preview installation requires x86_64'
  [[ $(id -u) == 0 ]] || die 'Outlook preview installation requires root'
  for required_command in curl sha256sum pacman mktemp; do
    command -v "$required_command" >/dev/null || die "Required command not found: $required_command"
  done

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  tmp_package=$(mktemp --tmpdir "$PACKAGE_NAME.XXXXXXXX.pkg.tar.zst")

  curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 3 \
    --output "$tmp_package" "$PACKAGE_URL"
  if ! printf '%s  %s\n' "$PACKAGE_SHA256" "$tmp_package" | sha256sum --check --status -; then
    die 'Outlook preview package checksum verification failed'
  fi
  pacman --noconfirm -U -- "$tmp_package"
  check_installation || die 'Outlook preview post-install verification failed'
}

if [[ $# != 1 ]]; then
  die 'Usage: install-outlook-preview --check|--apply'
fi

case $1 in
  --check) check_installation ;;
  --apply) apply_installation ;;
  *) die 'Usage: install-outlook-preview --check|--apply' ;;
esac
