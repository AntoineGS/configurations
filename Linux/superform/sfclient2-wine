#!/usr/bin/env bash
# Superform client (SFClient2.exe, Delphi 2010 Win32) from the multidev
# checkout, in the shared multidev Wine prefix (X11/XWayland driver). Arguments
# are passed to SFClient2, e.g. /ALIAS=MDEVAPPS /USER=... /PASSWORD=... /emDev=Y.
# Prepare the prefix with setup-multidev-wine; build SFClient2 and its
# packages with the headless Delphi tools (headless-make build).
set -Eeuo pipefail

exe="$HOME/.local/share/wineprefixes/multidev/drive_c/Multidev/Projects/Superform/SFClient2.exe"
if [[ ! -f $exe ]]; then
    printf 'SFClient2 executable is missing: %s\n' "$exe" >&2
    exit 1
fi
if [[ -z "${DISPLAY:-}" ]]; then
    printf 'Run this launcher from a desktop session with an X11/XWayland DISPLAY.\n' >&2
    exit 1
fi

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sfclient2"
mkdir -p "$log_dir"
# SFClient2 reads DATABASES.ini and SF.ini from its own folder.
cd "$(dirname "$exe")"
exec "$HOME/.local/bin/multidev-wine" 'C:\Multidev\Projects\Superform\SFClient2.exe' "$@" >> "$log_dir/sfclient2.log" 2>&1
