#!/usr/bin/env bash
# Prepare the shared Wine prefix the multidev applications (MDExplorer,
# SFClient2, and any other .exe from the checkout) run in (see tidydots.yaml,
# app "multidev-wine"). The launcher is multidev-wine.
#
# --check exit codes follow the tidydots `check_mode: status` protocol:
#   0  set up            1  needs setup (prefix, symlink, folder, runtime DLL or
#                            WebView2 runtime missing)
#   2  outdated          3  check failed (wine, the multidev checkout or the
#                            O: applications share is absent; tidydots cannot
#                            fix that, so --apply is blocked)
#
# The check is read-only and fast: it never launches wine, it only inspects the
# prefix directory, greps user.reg and compares file sizes.
set -Eeuo pipefail

readonly PREFIX="$HOME/.local/share/wineprefixes/multidev"
readonly MULTIDEV="$HOME/gits/multidev"
readonly DRIVE_C_LINK="$PREFIX/drive_c/Multidev"
readonly SYSWOW64="$PREFIX/drive_c/windows/syswow64"
readonly SERVICES="$PREFIX/drive_c/windows/system32/drivers/etc/services"
# MDExplorer keeps its favorites, history and state here.
readonly APPDATA_DIR="$PREFIX/drive_c/users/$USER/AppData/Local/MDExplorer"
# The InterBase installer registers the default port; the client resolves
# database paths without an explicit port through it.
readonly GDS_DB_SERVICE='gds_db           3050/tcp                           #InterBase Server'
readonly REG_SECTION='[Software\\Wine\\Drivers]'
# WebView2 runtime for the Wails builds (mdexplorer-go). Its updater services
# are disabled: they would start with every wine session in the prefix.
readonly WEBVIEW2_URL='https://go.microsoft.com/fwlink/?linkid=2124701'
readonly WEBVIEW2_CLIENT='[Software\\Wow6432Node\\Microsoft\\EdgeUpdate\\Clients\\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}]'
readonly WEBVIEW2_DIR="$PREFIX/drive_c/Program Files (x86)/Microsoft/EdgeWebView/Application"
readonly -a WEBVIEW2_UPDATERS=(edgeupdate edgeupdatem)
# 32-bit InterBase client, and the Delphi 2010 runtime packages that a Delphi
# 2010 installation puts in SysWOW64. Headless builds produce the other
# packages SFClient2 loads; multidev-wine puts them on WINEPATH. The 64-bit
# InterBase client (system32/ibclient64.dll) is linked in by tidydots.
readonly SHARE="$HOME/Shares/O-applications"
readonly -a RUNTIME=(
  Interbase/gds32.dll
  HO/Superform/rtl140.bpl HO/Superform/vcl140.bpl HO/Superform/vclx140.bpl
  HO/Superform/vclimg140.bpl HO/Superform/VclSmp140.bpl HO/Superform/dbrtl140.bpl
  HO/Superform/vcldb140.bpl HO/Superform/adortl140.bpl HO/Superform/bdertl140.bpl
  HO/Superform/dsnap140.bpl HO/Superform/inet140.bpl HO/Superform/soaprtl140.bpl
  HO/Superform/xmlrtl140.bpl HO/Superform/Tee8140.bpl HO/Superform/vclactnband140.bpl
  HO/Superform/vclie140.bpl HO/Superform/dbxcommondriver140.bpl
  HO/Superform/pkiectrl14.bpl
)

usage() {
  printf 'Usage: %s --check|--apply|--help\n' "${0##*/}"
}

fail() {
  printf '%s: %s\n' "${0##*/}" "$*" >&2
}

require_tools() {
  if ! command -v wine >/dev/null 2>&1; then
    fail 'wine is not installed'
    return 3
  fi
  if [[ ! -d $MULTIDEV/DBExplorer || ! -d $MULTIDEV/Projects/Superform ]]; then
    fail "multidev checkout is missing: $MULTIDEV (clone it first)"
    return 3
  fi
}

# Prints the data of a value under a section of a Wine .reg file, as stored
# (strings keep their quotes); nothing when the file, section or value is
# absent.
reg_value() {
  local file=$1 section=$2 name=$3
  [[ -f $file ]] || return 0
  # Passed via ENVIRON, not -v: awk -v would unescape the doubled backslashes
  # that .reg files use in section names.
  WANT_SECTION="$section" WANT_NAME="\"$name\"=" awk '
    BEGIN { section = ENVIRON["WANT_SECTION"]; name = ENVIRON["WANT_NAME"] }
    index($0, section) == 1 { in_section = 1; next }
    /^\[/ { in_section = 0 }
    in_section && index($0, name) == 1 { print substr($0, length(name) + 1); exit }
  ' "$file"
}

# True when user.reg carries Graphics=x11 under Software\Wine\Drivers.
graphics_driver_set() {
  [[ $(reg_value "$PREFIX/user.reg" "$REG_SECTION" Graphics) == '"x11"' ]]
}

webview2_installed() {
  local version
  version=$(reg_value "$PREFIX/system.reg" "$WEBVIEW2_CLIENT" pv)
  version=${version//\"/}
  [[ -n $version && -f $WEBVIEW2_DIR/$version/msedgewebview2.exe ]]
}

# Prints the WebView2 updater services that are not disabled.
enabled_webview2_updaters() {
  local service start
  for service in "${WEBVIEW2_UPDATERS[@]}"; do
    start=$(reg_value "$PREFIX/system.reg" \
      "[System\\\\ControlSet001\\\\Services\\\\$service]" Start)
    if [[ -n $start && $start != dword:00000004 ]]; then
      printf '%s\n' "$service"
    fi
  done
}

# The installer leaves MicrosoftEdgeUpdate.exe running with its output
# inherited, so the output goes to a file: a caller reading a pipe would
# otherwise wait for the updater to exit.
install_webview2() {
  local dir status=0
  # The prefix uses the x11 driver; without a display the installer exits 8.
  if [[ -z ${DISPLAY:-} ]]; then
    fail 'installing the WebView2 runtime needs a graphical session (DISPLAY is unset)'
    return 1
  fi
  dir=$(mktemp -d)
  if ! curl -fsSL --retry 3 -o "$dir/webview2-installer.exe" "$WEBVIEW2_URL"; then
    fail 'could not download the WebView2 runtime installer'
    rm -rf -- "$dir"
    return 1
  fi
  run_wine wine "$dir/webview2-installer.exe" /silent /install \
    >"$dir/install.log" 2>&1 || status=$?
  run_wine wine taskkill /f /im MicrosoftEdgeUpdate.exe >/dev/null 2>&1 || true
  run_wine wineserver -w
  if ((status != 0)) || ! webview2_installed; then
    fail "the WebView2 runtime installer failed (exit $status):"
    tail -n 20 -- "$dir/install.log" >&2
    status=1
  fi
  rm -rf -- "$dir"
  return "$status"
}

prefix_initialized() {
  [[ -f $PREFIX/system.reg && -d $PREFIX/drive_c/windows ]]
}

# Prints the runtime files whose prefix copy is missing or differs in size
# from the share. Without the share, only missing copies are reported.
stale_runtime() {
  local file target
  for file in "${RUNTIME[@]}"; do
    target=$SYSWOW64/${file##*/}
    if [[ ! -f $target ]]; then
      printf '%s\n' "$file"
    elif [[ -f $SHARE/$file ]] &&
        [[ $(stat -c %s -- "$target") != $(stat -c %s -- "$SHARE/$file") ]]; then
      printf '%s\n' "$file"
    fi
  done
}

check_setup() {
  require_tools || return $?

  if ! prefix_initialized; then
    fail 'wine prefix is not initialized'
    return 1
  fi
  if ! grep -q '^#arch=win64$' "$PREFIX/system.reg"; then
    fail 'wine prefix is not win64; move it aside and re-run --apply'
    return 3
  fi
  if [[ $(readlink -- "$DRIVE_C_LINK" 2>/dev/null || true) != "$MULTIDEV" ]]; then
    fail "drive_c/Multidev does not link to $MULTIDEV"
    return 1
  fi
  if [[ ! -d $APPDATA_DIR ]]; then
    fail "missing $APPDATA_DIR"
    return 1
  fi
  local stale
  stale=$(stale_runtime)
  if [[ -n $stale ]]; then
    if [[ ! -d $SHARE/HO/Superform ]]; then
      fail "runtime DLLs are missing and $SHARE is not mounted"
      return 3
    fi
    fail "runtime DLLs missing or outdated: ${stale//$'\n'/ }"
    return 1
  fi
  if ! grep -q '^gds_db[[:space:]]' "$SERVICES"; then
    fail 'the gds_db service is not registered'
    return 1
  fi
  if ! webview2_installed; then
    fail 'the WebView2 runtime is not installed'
    return 1
  fi
  local updaters
  updaters=$(enabled_webview2_updaters)
  if [[ -n $updaters ]]; then
    fail "WebView2 updater services are enabled: ${updaters//$'\n'/ }"
    return 2
  fi
  if ! graphics_driver_set; then
    fail 'Graphics=x11 is not set in user.reg'
    return 2
  fi
}

run_wine() {
  WINEPREFIX="$PREFIX" WINEARCH=win64 WINEDEBUG=-all \
    WINEDLLOVERRIDES='mscoree=d;mshtml=d' "$@"
}

apply_setup() {
  require_tools

  if ! prefix_initialized; then
    mkdir -p -- "$PREFIX"
    run_wine wineboot -u
    run_wine wineserver -w
  fi

  if [[ -e $DRIVE_C_LINK && ! -L $DRIVE_C_LINK ]]; then
    fail "refusing to replace non-symlink: $DRIVE_C_LINK"
    return 1
  fi
  ln -sfn -- "$MULTIDEV" "$DRIVE_C_LINK"

  mkdir -p -- "$APPDATA_DIR"

  local file
  while IFS= read -r file; do
    [[ -n $file ]] || continue
    if [[ ! -f $SHARE/$file ]]; then
      fail "missing on the share: $SHARE/$file"
      return 3
    fi
    install -m 0644 -- "$SHARE/$file" "$SYSWOW64/${file##*/}"
  done < <(stale_runtime)

  if ! grep -q '^gds_db[[:space:]]' "$SERVICES"; then
    printf '%s\r\n' "$GDS_DB_SERVICE" >> "$SERVICES"
  fi

  if ! webview2_installed; then
    install_webview2
  fi

  local service updaters
  updaters=$(enabled_webview2_updaters)
  if [[ -n $updaters ]]; then
    while IFS= read -r service; do
      run_wine wine reg add "HKLM\\System\\CurrentControlSet\\Services\\$service" \
        /v Start /t REG_DWORD /d 4 /f >/dev/null
    done <<< "$updaters"
    run_wine wineserver -w
  fi

  if ! graphics_driver_set; then
    run_wine wine reg add 'HKCU\Software\Wine\Drivers' /v Graphics /t REG_SZ \
      /d 'x11' /f >/dev/null
    run_wine wineserver -w
  fi

  check_setup
}

if (($# != 1)); then
  usage >&2
  exit 2
fi

case $1 in
  --check) check_setup ;;
  --apply) apply_setup ;;
  --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
