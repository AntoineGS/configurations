#!/usr/bin/env bash
# Prompt for domain authentication when no valid office-share ticket exists.
# Minimum Bash version: 4.4

set -Eeuo pipefail
shopt -s inherit_errexit

readonly realm='MULTIDEV.LOCAL'

principal_user="$(id -un)"
principal_user="${principal_user%@*}"
expected_principal="${principal_user}@${realm}"
cache_dir="${OFFICE_SHARES_CACHE_DIR:-/tmp}"

log() {
  printf 'check-office-shares-auth: %s\n' "$*" >&2
}

require_commands() {
  local command_name

  for command_name in "$@"; do
    command -v "$command_name" >/dev/null 2>&1 || {
      log "required command is unavailable: $command_name"
      return 1
    }
  done
}

has_valid_cache() {
  local candidate principal
  local -a candidates

  shopt -s nullglob
  candidates=("$cache_dir"/"krb5cc_${UID}"*)
  shopt -u nullglob

  for candidate in "${candidates[@]}"; do
    [[ -f "$candidate" && -O "$candidate" ]] || continue
    if ! LC_ALL=C KRB5CCNAME="FILE:$candidate" klist -s >/dev/null 2>&1; then
      continue
    fi
    principal="$(LC_ALL=C KRB5CCNAME="FILE:$candidate" klist 2>/dev/null | awk '/^Default principal:/ { print $3; exit }')"
    if [[ "$principal" == "$expected_principal" ]]; then
      return 0
    fi
  done

  return 1
}

authenticate() {
  require_commands kinit systemctl || return 1
  export KRB5CCNAME="FILE:${cache_dir}/krb5cc_${UID}"

  if ! kinit "$expected_principal"; then
    log 'domain authentication failed'
    return 1
  fi

  systemctl --user start office-shares-mount.service
}

check_authentication() {
  local action

  require_commands klist notify-send || return 1
  if has_valid_cache; then
    return 0
  fi

  action="$(notify-send \
    --app-name='Office Shares' \
    --icon=dialog-password \
    --urgency=critical \
    --expire-time=0 \
    --action=authenticate=Authenticate \
    --wait \
    -- \
    'Domain authentication required' \
    'Network shares need a fresh Kerberos ticket.')" || {
    log 'could not display the authentication notification'
    return 1
  }

  [[ "$action" == authenticate ]] || return 0
  require_commands systemd-run uwsm ghostty || return 1
  systemd-run \
    --user \
    --unit=office-shares-authenticate \
    --collect \
    -- \
    uwsm app -- ghostty --class=office-shares-auth -e "$0" --authenticate
}

main() {
  if [[ $# -eq 0 ]]; then
    check_authentication
  elif [[ $# -eq 1 && "$1" == --authenticate ]]; then
    authenticate
  else
    printf 'Usage: %s [--authenticate]\n' "${0##*/}" >&2
    return 2
  fi
}

main "$@"
