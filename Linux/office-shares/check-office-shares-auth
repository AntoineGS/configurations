#!/usr/bin/env bash
# Prompt for domain authentication when no valid office-share ticket exists.
# Minimum Bash version: 4.4

set -Eeuo pipefail
shopt -s inherit_errexit

readonly realm='MULTIDEV.LOCAL'
readonly polkit_helper='/usr/local/libexec/antoinews-linux/refresh-office-shares-credentials'

session_user="$(id -un)"
principal_user="${session_user%@*}"
expected_principal="${principal_user}@${realm}"
cache_dir="${OFFICE_SHARES_CACHE_DIR:-/tmp}"

log() {
  printf 'check-office-shares-auth: %s\n' "$*" >&2
}

require_commands() {
  local command_name

  for command_name in "$@"; do
    command -v "$command_name" >/dev/null 2>&1 || {
      log "required command is unavailable: $command_name"
      return 1
    }
  done
}

has_valid_cache() {
  local candidate principal

  while IFS= read -r -d '' candidate; do
    if ! LC_ALL=C KRB5CCNAME="FILE:$candidate" klist -s >/dev/null 2>&1; then
      continue
    fi
    principal="$(LC_ALL=C KRB5CCNAME="FILE:$candidate" klist 2>/dev/null | awk '/^Default principal:/ { print $3; exit }')"
    if [[ "$principal" == "$expected_principal" ]]; then
      return 0
    fi
  done < <(find "$cache_dir" -maxdepth 1 -type f -user "$UID" -name "krb5cc_${UID}*" -print0)

  return 1
}

authenticate() {
  require_commands pkexec systemctl || return 1
  if ! pkexec --disable-internal-agent --user "$session_user" "$polkit_helper"; then
    log 'polkit domain authentication failed'
    return 1
  fi
  if ! has_valid_cache; then
    log 'polkit authentication did not create a Kerberos ticket'
    return 1
  fi

  systemctl --user start office-shares-mount.service
}

check_authentication() {
  local action

  require_commands klist notify-send || return 1
  if has_valid_cache; then
    return 0
  fi

  action="$(notify-send \
    --app-name='Office Shares' \
    --icon=dialog-password \
    --urgency=critical \
    --expire-time=0 \
    --action=default=Authenticate \
    --wait \
    -- \
    'Domain authentication required' \
    'Network shares need a fresh Kerberos ticket.')" || {
    log 'could not display the authentication notification'
    return 1
  }

  [[ "$action" == default ]] || return 0
  authenticate
}

main() {
  if [[ $# -ne 0 ]]; then
    printf 'Usage: %s\n' "${0##*/}" >&2
    return 2
  fi

  check_authentication
}

main "$@"
