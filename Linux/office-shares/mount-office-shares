#!/usr/bin/env bash
# Mount the office shares using the current user's selected Kerberos cache.
# The four md-fs01 shares are required; the Embarcadero share lives on the
# Windows VM and is skipped without failure whenever the VM is unreachable.
# Minimum Bash version: 4.4

set -Eeuo pipefail
shopt -s inherit_errexit

readonly office_server='md-fs01.multidev.local'
readonly vm_server='antoinews.multidev.local'
readonly realm='MULTIDEV.LOCAL'
readonly smb_port=445
readonly probe_timeout='2s'

unix_user="$(id -un)"
unix_user="${unix_user%@*}"
expected_principal="${unix_user}@${realm}"
cache_dir="${OFFICE_SHARES_CACHE_DIR:-/tmp}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
legacy_root="${OFFICE_SHARES_GVFS_ROOT:-$runtime_dir/gvfs}"
shares_dir="${OFFICE_SHARES_DIR:-$HOME/Shares}"

share_servers=("$office_server" "$office_server" "$office_server" "$office_server" "$vm_server")
remote_shares=(serveurgdb fichierscommuns applications qa Embarcadero)
link_names=(G-serveurgdb J-fichierscommuns O-applications Z-QA Embarcadero)
optional_servers=("$vm_server")

declare -A probe_results=()

log() {
  printf 'mount-office-shares: %s\n' "$*" >&2
}

is_optional_server() {
  local server="$1" candidate

  for candidate in "${optional_servers[@]}"; do
    [[ "$candidate" == "$server" ]] && return 0
  done
  return 1
}

# Optional servers (the VM) are probed once per run on the SMB port so an
# offline VM does not turn every timer run into a slow, noisy mount failure.
server_reachable() {
  local server="$1"

  if [[ -z "${probe_results[$server]+set}" ]]; then
    # shellcheck disable=SC2016 # $0/$1 are expanded by the inner bash, on purpose
    if timeout "$probe_timeout" bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$server" "$smb_port" 2>/dev/null; then
      probe_results[$server]=0
    else
      probe_results[$server]=1
    fi
  fi

  return "${probe_results[$server]}"
}

find_cache() {
  local candidate principal mtime
  local -a candidates
  local selected=''
  local selected_mtime=-1

  shopt -s nullglob
  candidates=("$cache_dir"/"krb5cc_${UID}"*)
  shopt -u nullglob

  for candidate in "${candidates[@]}"; do
    [[ -f "$candidate" && -O "$candidate" ]] || continue
    if ! KRB5CCNAME="FILE:$candidate" klist -s >/dev/null 2>&1; then
      continue
    fi
    principal="$(KRB5CCNAME="FILE:$candidate" klist 2>/dev/null | awk '/^Default principal:/ { print $3; exit }')"
    [[ "$principal" == "$expected_principal" ]] || continue
    if ! mtime="$(stat -c %Y -- "$candidate")"; then
      continue
    fi
    if (( mtime > selected_mtime )); then
      selected="$candidate"
      selected_mtime="$mtime"
    fi
  done

  [[ -n "$selected" ]] || return 1
  printf 'FILE:%s\n' "$selected"
}

legacy_target() {
  local server="$1"
  local share="$2"
  printf '%s/smb-share:server=%s,share=%s' "$legacy_root" "$server" "$share"
}

reconcile_path() {
  local server="$1"
  local share="$2"
  local mountpoint_path="$3"
  local expected_legacy_target

  if [[ -L "$mountpoint_path" ]]; then
    expected_legacy_target="$(legacy_target "$server" "$share")"
    if [[ "$(readlink -- "$mountpoint_path")" == "$expected_legacy_target" ]]; then
      rm -- "$mountpoint_path"
    else
      log "refusing unrelated path: $mountpoint_path"
      return 1
    fi
  elif [[ -e "$mountpoint_path" && ! -d "$mountpoint_path" ]]; then
    log "refusing non-directory path: $mountpoint_path"
    return 1
  fi

  if [[ ! -d "$mountpoint_path" ]]; then
    mkdir -- "$mountpoint_path" || return 1
  fi

  if mountpoint -q "$mountpoint_path"; then
    return 0
  fi

  if ! timeout 15s mount "$mountpoint_path" </dev/null; then
    log "failed to mount $mountpoint_path"
    return 1
  fi
}

prepare_shares_root() {
  if [[ -L "$shares_dir" ]]; then
    log "refusing symlinked Shares root: $shares_dir"
    return 1
  fi
  if [[ -e "$shares_dir" && ! -d "$shares_dir" ]]; then
    log "refusing non-directory Shares root: $shares_dir"
    return 1
  fi
  mkdir -p -- "$shares_dir" || {
    log "could not create share directory: $shares_dir"
    return 1
  }
}

main() {
  local ccache server share mountpoint_path index
  local failures=0

  ccache="$(find_cache)" || {
    log 'no valid current-principal Kerberos cache; waiting for a later retry'
    return 0
  }
  export KRB5CCNAME="$ccache"

  for command_name in mountpoint timeout mount; do
    command -v "$command_name" >/dev/null 2>&1 || {
      log "required command is unavailable: $command_name"
      return 1
    }
  done

  prepare_shares_root || return 1

  for index in "${!remote_shares[@]}"; do
    server="${share_servers[$index]}"
    share="${remote_shares[$index]}"
    mountpoint_path="$shares_dir/${link_names[$index]}"
    if is_optional_server "$server" && ! server_reachable "$server"; then
      log "skipping $mountpoint_path: $server is not reachable"
      continue
    fi
    if ! reconcile_path "$server" "$share" "$mountpoint_path"; then
      failures=1
    fi
  done

  return "$failures"
}

main "$@"
