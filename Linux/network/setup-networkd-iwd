#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'Usage: %s --check|--apply|--help\n' "${0##*/}"
}

require_systemctl() {
  if ! command -v systemctl >/dev/null 2>&1; then
    printf '%s\n' 'setup-networkd-iwd: systemctl is required' >&2
    return 1
  fi
}

case "${1:-}" in
  --check)
    require_systemctl
    systemctl is-enabled --quiet systemd-networkd.service &&
      systemctl is-enabled --quiet systemd-resolved.service &&
      systemctl is-enabled --quiet iwd.service
    ;;
  --apply)
    require_systemctl
    systemctl daemon-reload
    systemctl enable --now systemd-networkd.service systemd-resolved.service iwd.service
    ;;
  --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
