{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "instructions": [
    "~/.config/opencode/lsp-first.md",
    "~/.config/opencode/worktree-preferences.md"
  ],
  "plugin": [
    "opencode-with-claude",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "cc-safety-net"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "permission": "allow",
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  }
}
