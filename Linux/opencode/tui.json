{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin",
  "mouse": false,
  "keybinds": {
    "app_exit": "ctrl+c,<leader>q",
    "prompt_submit": "alt+return",
    "input_newline": "shift+return,ctrl+return,ctrl+j",
    "messages_page_up": "ctrl+u",
    "messages_page_down": "ctrl+d",
    "sidebar_page_up": "ctrl+shift+u",
    "sidebar_page_down": "ctrl+shift+d"
  }
}
