{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin",
  "plugin": [
    [
      "@leohenon/opencode-vim-plugin",
      {
        "enabled": true,
        "vim_initial_mode": "insert",
        "indicator": true,
        "vim_enter_submit": true
      }
    ]
  ],
  "keybinds": {
    "app_exit": "ctrl+c,<leader>q",
    "input_submit": "alt+return",
    "input_newline": "return,shift+return,ctrl+return,ctrl+j",
    "messages_page_up": "ctrl+u",
    "messages_page_down": "ctrl+d"
  }
}
