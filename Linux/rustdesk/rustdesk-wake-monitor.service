[Unit]
Description=Wake the RustDesk monitor on incoming desktop connections
After=graphical-session.target
PartOf=graphical-session.target
ConditionHost=antoinews-linux

[Service]
Type=simple
ExecStart=%h/.local/bin/rustdesk-wake-monitor --watch
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
