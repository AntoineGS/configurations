#!/usr/bin/env bash
set -Eeuo pipefail

readonly PACKAGE_NAME=rustdesk-drm-preview-bin
readonly PACKAGE_VERSION=1.5.0.drmfix4-1
readonly PACKAGE_URL=https://github.com/AntoineGS/rustdesk/releases/download/temp-build/rustdesk-drm-preview-bin-1.5.0.drmfix4-1-x86_64.pkg.tar.zst
readonly PACKAGE_SHA256=5c979735ab45d2f9845b0a8fc70d4b14f0f76e176a2a5baf6623d936387b0e56
readonly SERVICE_EXECUTABLE=/usr/lib/rustdesk-drm-preview/rustdesk

tmp_package=

cleanup() {
  if [[ -n $tmp_package ]]; then
    rm -f -- "$tmp_package"
  fi
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

check_installation() {
  local installed
  installed=$(pacman -Q "$PACKAGE_NAME" 2>/dev/null) || return 1
  [[ $installed == "$PACKAGE_NAME $PACKAGE_VERSION" ]] || return 1
  [[ -x $SERVICE_EXECUTABLE ]]
}

apply_installation() {
  local required_command
  [[ $(id -u) == 0 ]] || die 'RustDesk DRM preview installation requires root'
  for required_command in curl sha256sum pacman systemctl mktemp; do
    command -v "$required_command" >/dev/null || die "Required command not found: $required_command"
  done

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  tmp_package=$(mktemp --tmpdir "$PACKAGE_NAME.XXXXXXXX.pkg.tar.zst")

  curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 3 \
    --output "$tmp_package" "$PACKAGE_URL"
  printf '%s  %s\n' "$PACKAGE_SHA256" "$tmp_package" | sha256sum --check --status -
  pacman --noconfirm -U -- "$tmp_package"
  check_installation || die 'RustDesk DRM preview post-install verification failed'
}

case ${1:-} in
  --check) check_installation ;;
  --apply) apply_installation ;;
  *) die 'Usage: install-rustdesk-drm-preview --check|--apply' ;;
esac
