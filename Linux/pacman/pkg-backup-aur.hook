[Trigger]
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
When = PostTransaction
# Tidydots symlinks this hook into the repo; resolve it instead of root's home.
Exec = /bin/bash -ec 'test -L /usr/share/libalpm/hooks/pkg-backup-aur.hook; hook=$(readlink -e /usr/share/libalpm/hooks/pkg-backup-aur.hook); pacman -Qqemt > "$(dirname "$hook")/pkglist-aur-$(hostname).txt"'
