general {
    {{- if or (eq .Hostname "omarchbook") (eq .Hostname "antoinews-linux") }}
    lock_cmd = lock-screen                                  # lock screen and 1password
    before_sleep_cmd = loginctl lock-session                # lock before suspend.
    inhibit_sleep = 3                                       # wait until screen is locked
    {{- end }}
    after_sleep_cmd = sleep 1 && hyprctl eval 'hl.dispatch(hl.dsp.dpms({action="on"}))'   # to avoid having to press a key twice to turn on the display.
}

{{ if or (eq .Hostname "omarchbook") (eq .Hostname "antoinews-linux") }}
listener {
    timeout = 300
    on-timeout = pidof hyprlock || loginctl lock-session     # lock screen on idle (if we haven't locked already)
}
{{ end }}

listener {
    timeout = 30 
    on-timeout = brightnessctl -sd '*::kbd_backlight' set 0  # save state and turn off keyboard backlight
    on-resume = brightnessctl -rd '*::kbd_backlight'         # restore keyboard backlight
}

listener {
    timeout = 630
    on-timeout = hyprctl eval 'hl.dispatch(hl.dsp.dpms({action="off"}))'                   # screen off shortly after lock
    {{- if eq .Hostname "omarchbook" }}
    on-resume = recover-keyball-bluetooth >/dev/null 2>&1 & hyprctl eval 'hl.dispatch(hl.dsp.dpms({action="on"}))' && brightnessctl -r # recover Keyball without delaying screen wake
    {{- else }}
    on-resume = hyprctl eval 'hl.dispatch(hl.dsp.dpms({action="on"}))' && brightnessctl -r # screen on when activity is detected
    {{- end }}
}
