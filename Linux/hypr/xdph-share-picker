#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $(hostname) != antoinews-linux ]]; then
  exec hyprland-preview-share-picker "$@"
fi

command -v hyprctl >/dev/null
command -v jq >/dev/null

# Prepare synchronously so source selection cannot race the connection watcher.
rustdesk-wake-monitor --prepare-monitor >&2

if ! hyprctl monitors -j | jq -e 'any(.[]; .name == "DP-1" and .disabled == false)' >/dev/null; then
  exit 1
fi

printf '%s\n' '[SELECTION]r/screen:DP-1'
