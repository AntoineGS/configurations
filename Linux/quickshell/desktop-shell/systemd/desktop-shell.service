[Unit]
Description=Repository desktop shell
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
Environment=DESKTOP_SHELL_NOTIFICATIONS_REGISTER=1
Environment=DESKTOP_SHELL_POLKIT_REGISTER=1
# Work around NVIDIA sync_file descriptor leaks when popup windows hide/show.
Environment=__NV_DISABLE_EXPLICIT_SYNC=1
ExecStart=%h/.local/share/helpers/desktop-shell-launch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
