{
  "version": 1,
  "remoteBar": {
{{ if eq .Hostname "antoinews-linux" }}
    "publish": true,
    "host": "antoinews-linux"
{{ else if or (eq .Hostname "DESKTOP-E07VTRN") (eq .Hostname "omarchbook") }}
    "target": "antoinews-linux",
    "sourceHost": "{{ .Hostname }}"
{{ else }}
    "enabled": false
{{ end }}
  },
  "bar": {
    "id": "desktop.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "desktop.clock",
    "layout": {
      "left": [{ "id": "desktop.workspaces", "labels": {
{{ if eq .Hostname "DESKTOP-E07VTRN" }}
        "1": "chat", "2": "main", "3": "secondary", "4": "obsidian", "5": "shell",
        "6": "git", "7": "browser", "8": "work", "9": "work", "10": "explorer"
{{ end }}
{{ if eq .Hostname "antoinews-linux" }}
        "2": "main", "3": "secondary", "5": "shell", "6": "git",
        "8": "browser", "9": "sql", "10": "explorer"
{{ end }}
      } }],
      "center": [
        { "id": "desktop.recording" },
        { "id": "desktop.configuration-updates" },
        { "id": "desktop.clock", "format": "dddd MMMM dd yyyy - HH:mm:ss" }
      ],
      "right": [
        { "id": "desktop.agents" },
        { "id": "desktop.tray" },
        { "id": "desktop.tailscale" },
        { "id": "desktop.bluetooth" },
        { "id": "desktop.network" },
        { "id": "desktop.audio" },
{{ if eq .Hostname "omarchbook" }}
        { "id": "desktop.monitor" },
        { "id": "desktop.power" },
{{ end }}
        { "id": "disk", "type": "command", "exec": "desktop-shell-status disk", "interval": 300, "onClick": "launch-or-focus org.float.ncdu 'uwsm-app -- xdg-terminal-exec --app-id=org.float.ncdu --title=System -e sudo ncdu /'" },
{{ if eq .Hostname "antoinews-linux" }}
        { "id": "desktop.monitor-layout" },
{{ end }}
        { "id": "desktop.vm" }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": []
}
