#!/bin/sh
set -eu

if [ -n "${MONITOR_FIXTURE_ACTION_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$MONITOR_FIXTURE_ACTION_LOG"
fi

mode=""
if [ -n "${MONITOR_FIXTURE_ACTION_MODE:-}" ]; then
  mode=$(tr -d '\r\n' < "$MONITOR_FIXTURE_ACTION_MODE")
fi
case "$mode" in
  hold)
    while [ ! -r "${MONITOR_FIXTURE_ACTION_RELEASE:?}" ] \
      || [ "$(tr -d '\r\n' < "$MONITOR_FIXTURE_ACTION_RELEASE")" != release ]; do
      sleep 0.01
    done
    ;;
  fail-exit)
    printf '%s\n' 'fixture monitor action failed' >&2
    exit 7
    ;;
esac
exit 0
