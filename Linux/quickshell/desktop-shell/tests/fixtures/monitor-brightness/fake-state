#!/usr/bin/env bash
set -eu

mode=$(tr -d '\r\n' < "${MONITOR_BRIGHTNESS_STATE_MODE:?}")
command_name=${1:?}
previous=${2:?}
requested_connector=${3:-}
log_path=${MONITOR_BRIGHTNESS_STATE_LOG:-}
entered_path=${MONITOR_BRIGHTNESS_STATE_ENTERED:-}
hold_path=${MONITOR_BRIGHTNESS_STATE_HOLD:-}
release_path=${MONITOR_BRIGHTNESS_STATE_RELEASE:-}
old_callback_release_path=${MONITOR_BRIGHTNESS_STATE_OLD_CALLBACK_RELEASE:-}
old_callback_path=${MONITOR_BRIGHTNESS_STATE_OLD_CALLBACK:-}
new_release_path=${MONITOR_BRIGHTNESS_STATE_NEW_RELEASE:-}
helper_entered_path=${MONITOR_BRIGHTNESS_STATE_HELPER_ENTERED:-}

[ "$command_name" = monitor ] || exit 64
jq -e 'type == "object"' <<<"$previous" >/dev/null

fixture_root=$(cd -- "$(dirname "$0")/../../../../../os/tests/fixtures/monitor-brightness" && pwd -P)
edid_a=$(tr -d '\r\n[:space:]' <"$fixture_root/display-a.edid.hex")
edid_b=$(tr -d '\r\n[:space:]' <"$fixture_root/display-b.edid.hex")
edid_c=$(tr -d '\r\n[:space:]' <"$fixture_root/display-c.edid.hex")

hash_text() { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }
identity() { hash_text "$1"$'\n'"$2"$'\n'"$3"$'\n'"$4"$'\n'"$5"$'\n'"$6"; }

topology_old=$(hash_text "$(printf 'card0-DP-1\tDP-1\t%s\t3\tnone\ncard0-HDMI-1\tHDMI-1\t%s\t4\tnone' "$edid_a" "$edid_b")")
topology_new=$(hash_text "$(printf 'card0-DP-1\tDP-1\t%s\t3\tnone\ncard0-HDMI-1\tHDMI-1\t%s\t4\tnone' "$edid_c" "$edid_b")")
topology_three=$(hash_text "$(printf 'card0-DP-1\tDP-1\t%s\t3\tnone\ncard0-DP-2\tDP-2\t%s\t5\tnone\ncard0-HDMI-1\tHDMI-1\t%s\t4\tnone' "$edid_a" "$edid_c" "$edid_b")")
identity_a_old=$(identity DP-1 ddc "$edid_a" "$topology_old" bus 3)
identity_b_old=$(identity HDMI-1 ddc "$edid_b" "$topology_old" bus 4)
identity_a_new=$(identity DP-1 ddc "$edid_c" "$topology_new" bus 3)
identity_b_new=$(identity HDMI-1 ddc "$edid_b" "$topology_new" bus 4)
identity_a_three=$(identity DP-1 ddc "$edid_a" "$topology_three" bus 3)
identity_b_three=$(identity HDMI-1 ddc "$edid_b" "$topology_three" bus 4)
identity_c_three=$(identity DP-2 ddc "$edid_c" "$topology_three" bus 5)

expected_connector=
case "$mode" in
  target-a-70|target-a-80|target-a-90|target-a-95|mismatch-a-75|cancel-a-65|timeout|malformed-confirmation|changed-a-55|targeted-failure) expected_connector=DP-1 ;;
  target-b-20) expected_connector=HDMI-1 ;;
  initial|hold-old|hold-old-callback|hold-new|restart-old|new-full|ordinary-failure|cached-stale|budget-seed|budget-unknown|budget) expected_connector= ;;
  *) printf '%s\n' "unknown state mode: $mode" >&2; exit 2 ;;
esac
if [ -n "$expected_connector" ]; then
  if [ -z "$requested_connector" ] && [ "$mode" = target-a-70 ]; then
    :
  elif [ "$requested_connector" != "$expected_connector" ]; then
    printf '%s\n' "unexpected requested connector for $mode" >&2
    exit 3
  fi
elif [ -n "$requested_connector" ]; then
  printf '%s\n' "full state mode received a targeted connector" >&2
  exit 3
fi

if [ -n "$helper_entered_path" ]; then
  printf '%s\n' "$mode" >>"$helper_entered_path"
fi

if [ "$mode" = ordinary-failure ] || [ "$mode" = targeted-failure ]; then
  exit 1
fi

if [ "$mode" = budget ]; then
  sleep "${MONITOR_BRIGHTNESS_STATE_DELAY:-0.15}"
fi

if [ -n "$log_path" ]; then
  jq -cn --arg mode "$mode" --argjson previous "$previous" --arg connector "$requested_connector" \
    '{mode:$mode,previous:$previous,connector:$connector}' >>"$log_path"
fi

if [ "$mode" = timeout ]; then
  if [ -n "$entered_path" ]; then
    printf '%s\n' "started:$mode" >"$entered_path"
  fi
  trap 'exit 124' TERM INT
  while :; do sleep 1; done
fi

if [ "$mode" = target-a-95 ] && [ -n "${MONITOR_BRIGHTNESS_STATE_FINAL_HOLD:-}" ]; then
  hold_path=$MONITOR_BRIGHTNESS_STATE_FINAL_HOLD
  release_path=${MONITOR_BRIGHTNESS_STATE_FINAL_RELEASE:?}
fi

record() {
  connector=$1
  identity=$2
  topology=$3
  percent=$4
  edid=$5
  selector=$6
  selector_kind=$7
  jq -cn \
    --arg connector "$connector" \
    --arg identity "$identity" \
    --arg topology "$topology" \
    --arg edid "$edid" \
    --arg selector "$selector" \
    --arg selectorKind "$selector_kind" \
    --argjson percent "$percent" \
    '{connector:$connector,backend:"ddc",available:true,stale:false,error:"",current:$percent,maximum:100,
      percent:$percent,identity:$identity,topology:$topology,edid:$edid,selector:{kind:$selectorKind,value:$selector}}'
}

snapshot() {
  topology=$1
  percent_a=$2
  percent_b=$3
  identity_a=$4
  identity_b=$5
  edid_a=$6
  edid_b=$7
  selector_a=$8
  selector_b=$9
  record_a=$(record DP-1 "$identity_a" "$topology" "$percent_a" "$edid_a" "$selector_a" bus)
  record_b=$(record HDMI-1 "$identity_b" "$topology" "$percent_b" "$edid_b" "$selector_b" bus)
  jq -cn \
    --arg topology "$topology" \
    --argjson recordA "$record_a" \
    --argjson recordB "$record_b" \
    --argjson percentA "$percent_a" \
    '{available:true,stale:false,error:null,data:{monitors:[{name:"DP-1",enabled:true},{name:"HDMI-1",enabled:true}],focusedMonitor:"DP-1",internalMonitor:"",internalEnabled:false,brightness:{available:true,percent:$percentA,device:"fixture"},keyboardBrightness:{available:false,percent:0},brightnessSnapshot:{version:1,topology:$topology,monitors:{"DP-1":$recordA,"HDMI-1":$recordB}}}}'
}

snapshot_three() {
  record_a=$(record DP-1 "$identity_a_three" "$topology_three" 40 "$edid_a" 3 bus)
  record_b=$(record HDMI-1 "$identity_b_three" "$topology_three" 60 "$edid_b" 4 bus)
  record_c=$(record DP-2 "$identity_c_three" "$topology_three" 55 "$edid_c" 5 bus)
  jq -cn \
    --arg topology "$topology_three" \
    --argjson recordA "$record_a" \
    --argjson recordB "$record_b" \
    --argjson recordC "$record_c" \
    '{available:true,stale:false,error:null,data:{monitors:[{name:"DP-1",enabled:true},{name:"HDMI-1",enabled:true},{name:"DP-2",enabled:true}],focusedMonitor:"DP-1",internalMonitor:"",internalEnabled:false,brightness:{available:true,percent:40,device:"fixture"},keyboardBrightness:{available:false,percent:0},brightnessSnapshot:{version:1,topology:$topology,monitors:{"DP-1":$recordA,"HDMI-1":$recordB,"DP-2":$recordC}}}}'
}

partial() {
  topology=$1
  connector=$2
  identity=$3
  percent=$4
  edid=$5
  selector=$6
  record_value=$(record "$connector" "$identity" "$topology" "$percent" "$edid" "$selector" bus)
  jq -cn \
    --arg topology "$topology" \
    --arg connector "$connector" \
    --argjson record "$record_value" \
    --argjson percent "$percent" \
    '{available:true,stale:false,error:null,data:{monitors:[{name:"DP-1",enabled:true},{name:"HDMI-1",enabled:true}],focusedMonitor:"DP-1",internalMonitor:"",internalEnabled:false,mirrorEnabled:false,brightness:{available:true,percent:$percent,device:"fixture"},keyboardBrightness:{available:false,percent:0},brightnessSnapshot:{version:1,topology:$topology,monitors:{($connector):$record}}}}'
}

malformed_partial() {
  topology=$1
  connector=$2
  identity=$3
  percent=$4
  edid=$5
  selector=$6
  record_value=$(record "$connector" "$identity" "$topology" "$percent" "$edid" "$selector" bus)
  record_value=$(jq -c '.current = "malformed"' <<<"$record_value")
  jq -cn \
    --arg topology "$topology" \
    --arg connector "$connector" \
    --argjson record "$record_value" \
    --argjson percent "$percent" \
    '{available:true,stale:false,error:null,data:{monitors:[{name:"DP-1",enabled:true},{name:"HDMI-1",enabled:true}],focusedMonitor:"DP-1",internalMonitor:"",internalEnabled:false,mirrorEnabled:false,brightness:{available:true,percent:$percent,device:"fixture"},keyboardBrightness:{available:false,percent:0},brightnessSnapshot:{version:1,topology:$topology,monitors:{($connector):$record}}}}'
}

if [ "$mode" = hold-old-callback ]; then
  release_path=${old_callback_release_path:?}
elif [ "$mode" = hold-new ]; then
  release_path=${new_release_path:?}
fi

if [ "$mode" = hold-old-callback ] || [ "$mode" = hold-new ] \
  || { [ -n "$hold_path" ] && [ "$(tr -d '\r\n' <"$hold_path" 2>/dev/null || true)" = hold ]; }; then
  if [ -n "$entered_path" ]; then
    printf '%s\n' "held:$mode" >"$entered_path"
  fi
  if [ "$mode" = hold-old-callback ] || [ "$mode" = hold-new ]; then
    :
  else
    trap 'case "$mode" in hold-old|restart-old) snapshot "$topology_old" 40 65 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4 ;; *) snapshot "$topology_old" 40 60 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4 ;; esac; exit 0' TERM INT
  fi
  while [ ! -r "$release_path" ] \
    || [ "$(tr -d '\r\n' <"$release_path" 2>/dev/null || true)" != release ]; do
    sleep 0.01
  done
  if [ "$mode" = hold-old-callback ]; then
    snapshot "$topology_old" 10 20 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4
    printf '%s\n' "callback:$mode" >"$old_callback_path"
    exit 0
  elif [ "$mode" = hold-new ]; then
    snapshot "$topology_old" 45 65 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4
    exit 0
  fi
fi

case "$mode" in
  initial)
    snapshot "$topology_old" 40 60 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4
    ;;
  hold-old)
    snapshot "$topology_old" 40 60 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4
    ;;
  restart-old)
    snapshot "$topology_old" 45 65 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4
    ;;
  target-a-70)
    if [ -n "$requested_connector" ]; then partial "$topology_old" DP-1 "$identity_a_old" 70 "$edid_a" 3
    else snapshot "$topology_old" 70 60 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4; fi
    ;;
  target-a-80)
    partial "$topology_old" DP-1 "$identity_a_old" 80 "$edid_a" 3
    ;;
  target-b-20)
    partial "$topology_old" HDMI-1 "$identity_b_old" 20 "$edid_b" 4
    ;;
  mismatch-a-75)
    partial "$topology_old" DP-1 "$identity_a_old" 75 "$edid_a" 3
    ;;
  cancel-a-65)
    partial "$topology_old" DP-1 "$identity_a_old" 65 "$edid_a" 3
    ;;
  malformed-confirmation)
    malformed_partial "$topology_old" DP-1 "$identity_a_old" 40 "$edid_a" 3
    ;;
  changed-a-55)
    partial "$topology_new" DP-1 "$identity_a_new" 55 "$edid_c" 3
    ;;
  cached-stale)
    snapshot "$topology_old" 40 60 "$identity_a_old" "$identity_b_old" "$edid_a" "$edid_b" 3 4 \
      | jq -c '.stale = true | .error = "cached monitor state is stale"'
    ;;
  budget-unknown|budget)
    snapshot_three
    ;;
  budget-seed)
    snapshot_three
    ;;
  new-full)
    snapshot "$topology_new" 55 65 "$identity_a_new" "$identity_b_new" "$edid_c" "$edid_b" 3 4
    ;;
  target-a-90)
    partial "$topology_new" DP-1 "$identity_a_new" 90 "$edid_c" 3
    ;;
  target-a-95)
    partial "$topology_new" DP-1 "$identity_a_new" 95 "$edid_c" 3
    ;;
esac
