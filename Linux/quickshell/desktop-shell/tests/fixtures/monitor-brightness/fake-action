#!/bin/sh
set -eu

mode=$(tr -d '\r\n' < "${MONITOR_BRIGHTNESS_ACTION_MODE:?}")
log_path=${MONITOR_BRIGHTNESS_ACTION_LOG:-}
entered_path=${MONITOR_BRIGHTNESS_ACTION_ENTERED:-}
hold_path=${MONITOR_BRIGHTNESS_ACTION_HOLD:-}
release_path=${MONITOR_BRIGHTNESS_ACTION_RELEASE:-}
old_callback_release_path=${MONITOR_BRIGHTNESS_ACTION_OLD_CALLBACK_RELEASE:-}
old_callback_path=${MONITOR_BRIGHTNESS_ACTION_OLD_CALLBACK:-}
new_release_path=${MONITOR_BRIGHTNESS_ACTION_NEW_RELEASE:-}
helper_entered_path=${MONITOR_BRIGHTNESS_ACTION_HELPER_ENTERED:-}

percent=${3:?}
target=${4:?}
connector=$(jq -er '.connector' <<EOF
$target
EOF
)

if [ -n "$helper_entered_path" ]; then
  printf '%s\n' "$mode" >>"$helper_entered_path"
fi

if [ -n "$log_path" ]; then
  printf '%s:%s\n' "$connector" "$percent" >>"$log_path"
fi
if [ -n "$entered_path" ]; then
  printf '%s:%s\n' "$connector" "$percent" >"$entered_path"
fi

if [ "$mode" = timeout ]; then
  trap 'exit 124' TERM INT
  while :; do sleep 1; done
fi

if [ "$mode" = hold-old-callback ]; then
  release_path=${old_callback_release_path:?}
elif [ "$mode" = hold-new ]; then
  release_path=${new_release_path:?}
fi

if [ "$mode" = hold-old-callback ] || [ "$mode" = hold-new ] || [ "$mode" = hold ] \
  || { [ -n "$hold_path" ] && [ "$(tr -d '\r\n' <"$hold_path" 2>/dev/null || true)" = hold ]; }; then
  if [ "$mode" = hold-old-callback ] || [ "$mode" = hold-new ]; then
    :
  else
    trap 'printf "%s\n" "$target"; if [ "$mode" = osd-fail ]; then exit 3; fi; exit 0' TERM INT
  fi
  while [ ! -r "$release_path" ] \
    || [ "$(tr -d '\r\n' <"$release_path" 2>/dev/null || true)" != release ]; do
    sleep 0.01
  done
  if [ "$mode" != hold-old-callback ] && [ "$mode" != hold-new ]; then
    printf '%s\n' wait >"$release_path"
  fi
  if [ "$mode" = hold-old-callback ]; then
    printf '%s\n' "$target"
    printf '%s\n' "callback:$mode" >"$old_callback_path"
    exit 0
  elif [ "$mode" = hold-new ]; then
    jq -c --argjson percent "$percent" '.current=$percent | .percent=$percent | .error=""' <<EOF
$target
EOF
    exit 0
  fi
fi

if [ "$mode" = malformed ]; then
  printf '%s\n' "not-json"
  exit 0
fi

jq -c --argjson percent "$percent" '.current=$percent | .percent=$percent | .error=""' <<EOF
$target
EOF
if [ "$mode" = osd-fail ]; then
  exit 3
fi
exit 0
