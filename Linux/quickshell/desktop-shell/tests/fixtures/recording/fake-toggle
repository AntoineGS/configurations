#!/bin/sh
set -eu

count_file=${RECORDING_FIXTURE_COUNT:?}
log_file=${RECORDING_FIXTURE_TOGGLE_LOG:-$count_file.toggle.log}
active_file=${RECORDING_FIXTURE_TOGGLE_ACTIVE:-$count_file.toggle-active}
release_file=${RECORDING_FIXTURE_TOGGLE_RELEASE:-$count_file.toggle-release}
overlap_file=${RECORDING_FIXTURE_TOGGLE_OVERLAP:-$count_file.toggle-overlap}

if [ -e "$active_file" ]; then
  : >"$overlap_file"
  exit 2
fi

: >"$active_file"
trap 'rm -f "$active_file"' EXIT INT TERM
printf 'toggle %s\n' "$*" >>"$log_file"
while [ ! -e "$release_file" ]; do sleep 0.01; done
