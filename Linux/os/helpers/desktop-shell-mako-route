#!/usr/bin/env bash
set -Eeuo pipefail

: "${XDG_RUNTIME_DIR:=/run/user/$UID}"
readonly ROUTE_DIR="$XDG_RUNTIME_DIR/desktop-shell"
readonly ROUTE_FILE="$XDG_RUNTIME_DIR/desktop-shell/notification-route.json"
readonly LEASE_FILE="$XDG_RUNTIME_DIR/desktop-shell/notification-route-lease.json"
readonly CUE_FILE="$XDG_RUNTIME_DIR/rustdesk-notification-cue"
readonly HIDDEN_MODE="rustdesk-route-hidden"
readonly CUE_MODE="rustdesk-cue"
readonly -a MANAGED_MODES=(
  "rustdesk-route-DVI-D-1"
  "rustdesk-route-HDMI-A-1"
  "rustdesk-route-DP-2"
  "rustdesk-route-DP-1"
  "rustdesk-route-eDP-1"
  "$HIDDEN_MODE"
  "$CUE_MODE"
)

ROUTE_MODE=""
CUE_TEXT=""
LAST_SIGNATURE=""

apply_modes() {
  local route_mode=$1
  local cue_text=$2
  local -a mode_args=(mode)
  local managed_mode

  for managed_mode in "${MANAGED_MODES[@]}"; do
    mode_args+=(-r "$managed_mode")
  done
  mode_args+=(-a "$route_mode")
  [[ -n $cue_text ]] && mode_args+=(-a "$CUE_MODE")

  makoctl "${mode_args[@]}"
}

write_cue() {
  local cue_text=$1
  local temporary_file=""

  if [[ -f $CUE_FILE && ! -L $CUE_FILE ]]; then
    local current_cue
    local file_mode

    current_cue=$(<"$CUE_FILE")
    file_mode=$(stat -c '%a' -- "$CUE_FILE")
    [[ $current_cue == "$cue_text" && $file_mode == 600 ]] && return 0
  fi

  if ! temporary_file=$(umask 077 && mktemp "${CUE_FILE}.XXXXXX"); then
    return 1
  fi
  if ! printf '%s\n' "$cue_text" >"$temporary_file"; then
    rm -f -- "$temporary_file"
    return 1
  fi
  if ! chmod 0600 -- "$temporary_file"; then
    rm -f -- "$temporary_file"
    return 1
  fi
  if ! mv -f -- "$temporary_file" "$CUE_FILE"; then
    rm -f -- "$temporary_file"
    return 1
  fi
}

route_dir_is_secure() {
  local owner mode

  [[ -d $ROUTE_DIR && ! -L $ROUTE_DIR ]] || return 1
  if ! read -r owner mode < <(stat -c '%u %a' -- "$ROUTE_DIR"); then
    return 1
  fi
  [[ $owner == "$UID" && $mode == 700 ]]
}

route_file_is_secure() {
  local path=$1
  local owner mode

  [[ -f $path && ! -L $path ]] || return 1
  if ! read -r owner mode < <(stat -c '%u %a' -- "$path"); then
    return 1
  fi
  [[ $owner == "$UID" && $mode == 600 ]]
}

read_route() {
  local now
  local now_ms
  local route_values

  route_dir_is_secure || return 1
  route_file_is_secure "$ROUTE_FILE" || return 1
  route_file_is_secure "$LEASE_FILE" || return 1
  now=$(date +%s)
  now_ms=$(date +%s%3N)
  [[ $now =~ ^[0-9]+$ ]] || return 1
  [[ $now_ms =~ ^[0-9]+$ ]] || return 1

  if ! route_values=$(jq -ner --argjson now "$now" --argjson now_ms "$now_ms" \
    --slurpfile route "$ROUTE_FILE" --slurpfile lease "$LEASE_FILE" '
    def non_negative_integer($label):
      if (type != "number") or (floor != .) or . < 0 then error($label + " is invalid") else . end;
    def supported_output:
      . == "DVI-D-1" or . == "HDMI-A-1" or . == "DP-2" or
      . == "DP-1" or . == "eDP-1";

    if ($route | length) != 1 then error("missing route") else . end
    | if ($lease | length) != 1 then error("missing lease") else . end
    | $route[0] as $route_json
    | $lease[0] as $lease_json
    | if ($route_json | type) != "object" or ($route_json | type) == "array" then error("route must be an object") else . end
    | if ($lease_json | type) != "object" or ($lease_json | type) == "array" then error("lease must be an object") else . end
    | if $route_json.version != 1 then error("unsupported route version") else . end
    | if $lease_json.version != 2 then error("unsupported lease version") else . end
    | if ($route_json.visible | type) != "boolean" then error("route visibility is invalid") else . end
    | ($route_json.updatedAt | non_negative_integer("route timestamp")) as $route_updated_at
    | ($lease_json.refreshedAtMs | non_negative_integer("lease refresh time")) as $lease_refreshed_at_ms
    | ($lease_json.expiresAtMs | non_negative_integer("lease expiration time")) as $lease_expires_at_ms
    | ($lease_json.routeUpdatedAt | non_negative_integer("lease route timestamp")) as $lease_route_updated_at
    | if $route_updated_at > $now then error("route timestamp is from the future") else . end
    | if ($now - $route_updated_at) > 45 then error("route is stale") else . end
    | if $lease_refreshed_at_ms > $now_ms then error("lease refresh time is from the future") else . end
    | if $lease_expires_at_ms <= $now_ms then error("lease is stale") else . end
    | if $lease_expires_at_ms < $lease_refreshed_at_ms then error("lease lifetime is invalid") else . end
    | if ($lease_expires_at_ms - $lease_refreshed_at_ms) > 1500 then error("lease lifetime is too long") else . end
    | if $lease_route_updated_at != $route_updated_at then error("lease route timestamp does not match") else . end
    | if ($route_json.output != null and (($route_json.output | type) != "string" or ($route_json.output | supported_output | not))) then error("unsupported route output") else . end
    | if ($route_json.cueOutput != null and (($route_json.cueOutput | type) != "string" or ($route_json.cueOutput | supported_output | not))) then error("unsupported route cue output") else . end
    | if ($route_json.direction != null and (($route_json.direction | type) != "string" or ($route_json.direction | test("^(left|right|up|down)$") | not))) then error("route direction is invalid") else . end
    | if ($route_json.visible and $route_json.output == null) then error("visible route has no output") else . end
    | if ($route_json.cueOutput == null and $route_json.direction != null) then error("route direction requires cue output") else . end
    | (if $route_json.visible then
          if $route_json.output == "DVI-D-1" then "rustdesk-route-DVI-D-1"
          elif $route_json.output == "HDMI-A-1" then "rustdesk-route-HDMI-A-1"
          elif $route_json.output == "DP-2" then "rustdesk-route-DP-2"
          elif $route_json.output == "DP-1" then "rustdesk-route-DP-1"
          elif $route_json.output == "eDP-1" then "rustdesk-route-eDP-1"
          else error("unsupported route output")
         end
       else "rustdesk-route-hidden"
       end) as $route_mode
    | (if $route_json.cueOutput == null then ""
       else $route_json.cueOutput + "|" + (if $route_json.direction == null then "none" else $route_json.direction end)
       end) as $cue_text
    | [$route_mode, $cue_text]
    | @tsv
  ' 2>/dev/null); then
    return 1
  fi

  IFS=$'\t' read -r ROUTE_MODE CUE_TEXT <<<"$route_values"
}

remove_cue() {
  rm -f -- "$CUE_FILE"
}

reconcile_route() {
  local route_mode
  local cue_text
  local signature

  if read_route; then
    route_mode=$ROUTE_MODE
    cue_text=$CUE_TEXT
  else
    route_mode=$HIDDEN_MODE
    cue_text=""
  fi
  signature="$route_mode|$cue_text"

  if [[ $signature == "$LAST_SIGNATURE" ]]; then
    if [[ -n $cue_text ]]; then
      write_cue "$cue_text" || true
    else
      remove_cue || true
    fi
    return 0
  fi

  if [[ -n $cue_text ]]; then
    write_cue "$cue_text" || {
      LAST_SIGNATURE=""
      return 1
    }
  else
    remove_cue || {
      LAST_SIGNATURE=""
      return 1
    }
  fi

  if apply_modes "$route_mode" "$cue_text"; then
    LAST_SIGNATURE=$signature
  else
    LAST_SIGNATURE=""
    return 1
  fi
}

cleanup() {
  trap - EXIT
  apply_modes "$HIDDEN_MODE" "" || true
  remove_cue || true
}

run_adapter() {
  local poll_interval=${POLL_INTERVAL:-0.25}

  if [[ ! $poll_interval =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    ! awk -v value="$poll_interval" 'BEGIN { exit !(value > 0 && value <= 0.25) }'; then
    poll_interval=0.25
  fi

  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap cleanup EXIT

  if apply_modes "$HIDDEN_MODE" ""; then
    LAST_SIGNATURE="$HIDDEN_MODE|"
  else
    LAST_SIGNATURE=""
  fi
  remove_cue || true

  while :; do
    reconcile_route || true
    sleep "$poll_interval"
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  run_adapter
fi
