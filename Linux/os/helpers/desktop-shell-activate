#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'usage: %s\n' "${0##*/}" >&2
}

if (($# != 0)); then
  usage
  exit 2
fi

: "${XDG_RUNTIME_DIR:=/run/user/$UID}"
readonly CUE_FILE="$XDG_RUNTIME_DIR/rustdesk-notification-cue"
readonly LIFECYCLE_LOCK_FILE="$XDG_RUNTIME_DIR/desktop-shell-lifecycle.lock"
readonly MAX_WAIT_ATTEMPTS=50
readonly READINESS_MAX_WAIT_ATTEMPTS=20
readonly WAIT_INTERVAL=0.1
readonly READINESS_CALL_TIMEOUT=0.5s

die() {
  printf 'desktop-shell activation failed: %s\n' "$1" >&2
  exit 1
}

exec {lifecycle_lock_fd}>"$LIFECYCLE_LOCK_FILE"
flock -n "$lifecycle_lock_fd" || die 'another desktop-shell lifecycle operation is running'
readonly lifecycle_lock_fd

query_named_pids() {
  local name=$1
  local result
  local status

  if result=$(pgrep -x -- "$name" 2>/dev/null); then
    printf '%s\n' "$result"
    return 0
  else
    status=$?
    ((status == 1)) && return 0
    return "$status"
  fi
}

pid_in_set() {
  local expected_pid=$1
  local pids=$2
  local pid

  while IFS= read -r pid; do
    [[ $pid == "$expected_pid" ]] && return 0
  done <<<"$pids"
  return 1
}

verify_named_process_pid() {
  local pid=$1
  local name=$2
  local pids
  local executable
  local status

  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  if pids=$(query_named_pids "$name"); then
    :
  else
    status=$?
    return "$status"
  fi
  pid_in_set "$pid" "$pids" || return 1
  if ! executable=$(readlink -- "/proc/$pid/exe" 2>/dev/null); then
    return 2
  fi
  [[ ${executable##*/} == "$name" ]]
}

wait_for_unit_active() {
  local unit=$1
  local attempt
  local -a command=(systemctl --user is-active --quiet "$unit")

  for ((attempt = 0; attempt < MAX_WAIT_ATTEMPTS; attempt++)); do
    "${command[@]}" && return 0
    sleep "$WAIT_INTERVAL"
  done

  printf 'systemd user unit did not become active: %s\n' "$unit" >&2
  return 1
}

query_notification_owner_pid() {
  local response
  local type=''
  local owner_pid=''
  local extra=''
  local -a command=(
    timeout --signal=TERM --kill-after=0.5s "$READINESS_CALL_TIMEOUT"
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus
    org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.Notifications
  )

  if ! response=$("${command[@]}" 2>/dev/null); then
    return 1
  fi
  [[ $response != *$'\n'* ]] || return 1
  read -r type owner_pid extra <<<"$response"
  [[ $type == u && $owner_pid =~ ^[1-9][0-9]*$ && -z $extra ]] || return 1
  printf '%s\n' "$owner_pid"
}

verify_notification_owner() {
  local expected_pids=$1
  local process_name=$2
  local owner_pid

  owner_pid=$(query_notification_owner_pid) || return 1
  pid_in_set "$owner_pid" "$expected_pids" || return 1
  verify_named_process_pid "$owner_pid" "$process_name"
}

wait_for_notification_owner() {
  local expected_pids=$1
  local process_name=$2
  local attempt

  for ((attempt = 0; attempt < READINESS_MAX_WAIT_ATTEMPTS; attempt++)); do
    verify_notification_owner "$expected_pids" "$process_name" && return 0
    sleep "$WAIT_INTERVAL"
  done

  printf 'notification owner did not become ready\n' >&2
  return 1
}

read_shell_pid() {
  local shell_pid
  local -a command=(systemctl --user show desktop-shell.service --property=MainPID --value)

  if ! shell_pid=$("${command[@]}" 2>/dev/null); then
    return 1
  fi
  [[ $shell_pid =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$shell_pid"
}

verify_shell_health() {
  local shell_pid=$1
  local raw_health
  local health
  local route_error
  local polkit_registered
  local -a command=(
    timeout --signal=TERM --kill-after=0.5s "$READINESS_CALL_TIMEOUT"
    desktop-shell --pid "$shell_pid" health
  )

  if ! raw_health=$("${command[@]}" 2>/dev/null); then
    return 1
  fi
  if ! health=$(jq -e -s '
    if length != 1 then error("expected one health response")
    elif (.[0] | type) == "string" then .[0] | fromjson
    else .[0]
    end
  ' <<<"$raw_health" 2>/dev/null); then
    return 1
  fi
  jq -e '
    type == "object"
    and .notificationsOwned == true
    and .polkitRegistered == true
    and .osdAvailable == true
    and (.notificationRouteError | type) == "string"
  ' <<<"$health" >/dev/null || return 1

  route_error=$(jq -r '.notificationRouteError' <<<"$health")
  if [[ -n $route_error ]]; then
    printf 'warning: notification route is fail-closed: %s\n' "$route_error" >&2
  fi
  polkit_registered=$(jq -r '.polkitRegistered' <<<"$health")
  printf '%s\n' "$polkit_registered"
}

wait_for_shell_ping() {
  local shell_pid=$1
  local attempt
  local ping_result
  local -a command=(
    timeout --signal=TERM --kill-after=0.5s "$READINESS_CALL_TIMEOUT"
    desktop-shell --pid "$shell_pid" ping
  )

  for ((attempt = 0; attempt < READINESS_MAX_WAIT_ATTEMPTS; attempt++)); do
    if ping_result=$("${command[@]}" 2>/dev/null) && [[ $ping_result == pong ]]; then
      return 0
    fi
    sleep "$WAIT_INTERVAL"
  done

  printf 'desktop-shell IPC did not become ready\n' >&2
  return 1
}

wait_for_shell_health() {
  local shell_pid=$1
  local attempt
  local polkit_registered

  for ((attempt = 0; attempt < READINESS_MAX_WAIT_ATTEMPTS; attempt++)); do
    if polkit_registered=$(verify_shell_health "$shell_pid"); then
      printf '%s\n' "$polkit_registered"
      return 0
    fi
    sleep "$WAIT_INTERVAL"
  done

  printf 'desktop-shell health did not become ready\n' >&2
  return 1
}

remove_cue=(rm -f -- "$CUE_FILE")
"${remove_cue[@]}" || die 'could not remove stale RustDesk cue state'

restart_route_publisher=(systemctl --user restart watch-rustdesk-submap.service)
"${restart_route_publisher[@]}" || die 'could not restart notification route publisher'
wait_for_unit_active watch-rustdesk-submap.service || die 'notification route publisher is not active'

start_shell=(systemctl --user start desktop-shell.service)
"${start_shell[@]}" || die 'could not start desktop-shell.service'
wait_for_unit_active desktop-shell.service || die 'desktop-shell.service is not active'

shell_pid=$(read_shell_pid) || die 'could not read desktop-shell.service MainPID'
wait_for_notification_owner "$shell_pid" quickshell || die 'Quickshell does not own notifications'

wait_for_shell_ping "$shell_pid" || die 'desktop-shell ping failed'

polkit_registered=$(wait_for_shell_health "$shell_pid") || die 'desktop-shell health rejected activation'
final_shell_pid=$(read_shell_pid) || die 'could not revalidate desktop-shell.service MainPID'
[[ $final_shell_pid == "$shell_pid" ]] || die 'desktop-shell.service MainPID changed during activation'
verify_notification_owner "$final_shell_pid" quickshell || die 'Quickshell notification ownership changed during activation'

printf '%s\n' \
  'desktop-shell activation status' \
  'desktop-shell.service: active' \
  "desktop-shell.pid: $shell_pid" \
  'notification-owner: desktop-shell' \
  "polkit-registered: $polkit_registered"
