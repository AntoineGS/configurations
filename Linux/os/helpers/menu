#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'usage: %s [route]\n' "${0##*/}" >&2
  exit 2
}

(( $# <= 1 )) || usage

payload='{"menu":"root"}'
if (($# == 1)); then
  route=$1
  [[ $route =~ ^[a-z0-9]+([.-][a-z0-9-]+)*$ ]] || usage
  printf -v payload '{"menu":"%s"}' "$route"
fi

exec desktop-shell summon desktop.menu "$payload"
