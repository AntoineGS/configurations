#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'usage: desktop-shell [--pid PID] <ping|health|list-plugins|reload-config|toggle-bar|summon|hide|call> ...\n' >&2
}

target_pid=""
if [[ ${1-} == --pid ]]; then
  if (($# < 2)) || [[ ! ${2-} =~ ^[1-9][0-9]*$ ]]; then
    usage
    exit 2
  fi
  target_pid=$2
  shift 2
fi

command_name="${1-}"
if (($# > 0)); then
  shift
fi

target="desktop-shell"
method=""
args=()

is_plugin_id() {
  [[ "${1-}" =~ ^desktop\.[a-z0-9-]+$ ]]
}

case "$command_name" in
  ping|health)
    if (($# != 0)); then usage; exit 2; fi
    method="$command_name"
    ;;
  list-plugins)
    if (($# != 0)); then usage; exit 2; fi
    method="listPlugins"
    ;;
  reload-config)
    if (($# != 0)); then usage; exit 2; fi
    method="reloadConfig"
    ;;
  toggle-bar)
    (($# == 0)) || { usage; exit 2; }
    method="toggleBar"
    ;;
  summon)
    if (($# < 1 || $# > 2)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "${2-}")
    method="summon"
    ;;
  hide)
    if (($# != 1)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1")
    method="hide"
    ;;
  call)
    if (($# < 2 || $# > 3)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "$2" "${3-}")
    method="call"
    ;;
  *)
    usage
    exit 2
    ;;
esac

ipc_scope=(--any-display)
if [[ -n $target_pid ]]; then
  ipc_scope=(--pid "$target_pid")
fi

exec quickshell ipc "${ipc_scope[@]}" -p "$HOME/.config/quickshell/desktop-shell" \
  call -- "$target" "$method" "${args[@]}"
