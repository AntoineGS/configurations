#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'usage: desktop-shell [--pid PID] <ping|health|list-plugins|reload-config|toggle-bar|summon|hide|call|plugin-rescan|plugin-list|plugin-enable|plugin-set-enabled|plugin-put|plugin-move|plugin-set-widget|toggle|list-shell-config> ...\n' >&2
}

target_pid=""
if [[ ${1-} == --pid ]]; then
  if (($# < 2)) || [[ ! ${2-} =~ ^[1-9][0-9]*$ ]]; then
    usage
    exit 2
  fi
  target_pid=$2
  shift 2
fi

command_name="${1-}"
if (($# > 0)); then
  shift
fi

target="desktop-shell"
method=""
args=()

is_plugin_id() {
  [[ ${1-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${1-} != *..* ]]
}

case "$command_name" in
  ping|health)
    if (($# != 0)); then usage; exit 2; fi
    method="$command_name"
    ;;
  list-plugins)
    if (($# != 0)); then usage; exit 2; fi
    method="listPlugins"
    ;;
  plugin-rescan)
    if (($# != 0)); then usage; exit 2; fi
    method="rescanPlugins"
    ;;
  plugin-list)
    if (($# != 0)); then usage; exit 2; fi
    method="listPlugins"
    ;;
  plugin-enable)
    if (($# < 1 || $# > 2)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "${2-}")
    method="enablePlugin"
    ;;
  plugin-set-enabled)
    if (($# != 2)) || ! is_plugin_id "$1" || [[ $2 != true && $2 != false ]]; then usage; exit 2; fi
    args=("$1" "$2")
    method="setPluginEnabled"
    ;;
  plugin-put)
    if (($# < 1 || $# > 2)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "${2-}")
    method="putBarWidget"
    ;;
  plugin-move)
    if (($# < 1 || $# > 2)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "${2-}")
    method="moveBarWidget"
    ;;
  plugin-set-widget)
    if (($# < 3 || $# > 4)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "$2" "$3" "${4-}")
    method="setBarWidget"
    ;;
  reload-config)
    if (($# != 0)); then usage; exit 2; fi
    method="reloadConfig"
    ;;
  toggle-bar)
    (($# == 0)) || { usage; exit 2; }
    method="toggleBar"
    ;;
  toggle)
    if (($# < 1 || $# > 2)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "${2-}")
    method="toggle"
    ;;
  list-shell-config)
    if (($# != 0)); then usage; exit 2; fi
    method="listShellConfig"
    ;;
  summon)
    if (($# < 1 || $# > 2)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "${2-}")
    method="summon"
    ;;
  hide)
    if (($# != 1)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1")
    method="hide"
    ;;
  call)
    if (($# < 2 || $# > 3)) || ! is_plugin_id "$1"; then usage; exit 2; fi
    args=("$1" "$2" "${3-}")
    method="call"
    ;;
  *)
    usage
    exit 2
    ;;
esac

ipc_scope=(--any-display -p "$HOME/.config/quickshell/desktop-shell")
if [[ -n $target_pid ]]; then
  unset QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST
  ipc_scope=(--pid "$target_pid")
fi

exec quickshell ipc "${ipc_scope[@]}" call -- "$target" "$method" "${args[@]}"
