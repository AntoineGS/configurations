#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
shopt -s inherit_errexit

readonly script_name=${0##*/}
script_path=$(realpath -- "${BASH_SOURCE[0]}")
readonly script_path
script_dir=$(dirname -- "$script_path")
readonly script_dir
readonly plugins_dir=${DESKTOP_SHELL_PLUGINS_DIR:-$HOME/.config/omarchy/plugins}
readonly artifact_root_name=.plugin-artifacts
readonly validator=${DESKTOP_SHELL_PLUGIN_VALIDATE:-$script_dir/desktop-shell-plugin-validate}
readonly ipc=${DESKTOP_SHELL_PLUGIN_IPC:-$script_dir/omarchy-shell}

export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS=/bin/false
export GIT_SSH_COMMAND=${GIT_SSH_COMMAND:-'ssh -oBatchMode=yes'}

stage_dir=
installed_target=
installed_identity=
candidate_dir=
candidate_fd=-1
candidate_identity=
candidate_real=
publication_armed=0
publication_public_name=
publication_rollback_name=
publication_rejected_name=
publication_old_identity=
publication_new_identity=
publication_rollback_identity=
publication_rejected_identity=
publication_rollback_reserved_identity=
reserved_identity=
publication_public_fd=-1
add_lock_fd=-1
root_fd=-1
root_path=
root_identity=
target_path=
target_real=
target_identity=
target_fd=-1
quarantine_fd=-1
update_target_fd=-1
update_target_path=
update_target_real=
update_target_identity=
git_fd=-1
common_fd=-1
git_path=
common_path=
git_identity=
common_identity=
metadata_ready=0
cleanup_running=0
cleanup_failure=0
placement_section=
placement_index=
placement_before=
placement_after=

fail() {
  printf '%s: %s\n' "$script_name" "$1" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    "usage: $script_name add|install URL [--enable] [--yes] [--expected-id ID]" \
    "       $script_name validate DIR" \
    "       $script_name list [--json]" \
    "       $script_name enable ID [SECTION] [--section SECTION] [--index N] [--before ID|--after ID]" \
    "       $script_name disable ID" \
    "       $script_name update [ID] [--yes]" \
    "       $script_name remove ID [--yes]" \
    "       $script_name sanitize-url URL" >&2
  exit 2
}

quarantine_owned_target() {
  [[ -n $installed_target && -n $installed_identity ]] || return 0
  [[ -d $installed_target && ! -L $installed_target ]] || return 0
  safe_remove_artifact_path "$installed_target" "$installed_identity" artifact-after-open || true
  installed_target=
  installed_identity=
}

cleanup() {
  (( cleanup_running )) && return 0
  cleanup_running=1
  trap - HUP INT TERM
  if (( publication_armed )); then
    if ! restore_armed_publication; then
      cleanup_failure=1
      printf '%s: ERROR: publication restoration failed; preserving uncertain objects at %q, %q, and %q\n' \
        "$script_name" "$root_path/$publication_public_name" "$root_path/$publication_rollback_name" \
        "$root_path/$publication_rejected_name" >&2
    fi
  fi
  if [[ -n $stage_dir ]]; then
    if ! safe_remove_artifact_path "$stage_dir" "$candidate_identity" artifact-after-open; then
      printf '%s: warning: retaining staging artifact: %s\n' "$script_name" "$stage_dir" >&2
    fi
  fi
  if (( candidate_fd >= 0 )); then
    exec {candidate_fd}<&-
    candidate_fd=-1
  fi
  if (( publication_public_fd >= 0 )); then
    exec {publication_public_fd}<&-
    publication_public_fd=-1
  fi
  quarantine_owned_target
  if (( add_lock_fd >= 0 )); then
    flock -u "$add_lock_fd" || true
    exec {add_lock_fd}>&-
    add_lock_fd=-1
  fi
  if (( root_fd >= 0 )); then
    exec {root_fd}<&-
    root_fd=-1
  fi
  if (( target_fd >= 0 )); then
    exec {target_fd}<&-
    [[ $update_target_fd == "$target_fd" ]] && update_target_fd=-1
    target_fd=-1
  fi
  if (( quarantine_fd >= 0 )); then
    exec {quarantine_fd}<&-
    quarantine_fd=-1
  fi
  if (( update_target_fd >= 0 )); then
    exec {update_target_fd}<&-
    update_target_fd=-1
  fi
  if (( git_fd >= 0 )); then
    exec {git_fd}<&-
    git_fd=-1
  fi
  if (( common_fd >= 0 )); then
    exec {common_fd}<&-
    common_fd=-1
  fi
  (( cleanup_failure == 0 ))
}

handle_signal() {
  local signal=$1 status
  case $signal in
    HUP) status=129 ;;
    INT) status=130 ;;
    TERM) status=143 ;;
    *) status=1 ;;
  esac
  cleanup
  exit "$status"
}

trap cleanup EXIT
trap 'handle_signal HUP' HUP
trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM

require_commands() {
  local command
  for command in git jq mktemp realpath stat flock findmnt; do
    command -v "$command" >/dev/null 2>&1 || fail "required command not found: $command"
  done
}

validate_safe_id() {
  local id=$1
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $id != *..* ]] || fail "unsafe plugin id: $id"
}

validate_third_party_id() {
  local id=$1
  validate_safe_id "$id"
  [[ $id != desktop.* && $id != omarchy.* ]] || fail "plugin id uses reserved namespace: $id"
}

sanitize_url() {
  local url=$1 sanitized rest authority path host
  [[ $url != *[[:cntrl:]]* ]] || fail "URL contains control characters"
  sanitized=${url%%\?*}
  sanitized=${sanitized%%\#*}
  if [[ $sanitized == *://* ]]; then
    rest=${sanitized#*://}
    if [[ $rest == */* ]]; then
      authority=${rest%%/*}
      path=/${rest#*/}
    else
      authority=$rest
      path=
    fi
    host=${authority##*@}
    sanitized=${sanitized%%://*}://$host$path
  elif [[ $sanitized =~ ^[^/@:]+@[^:]+: ]]; then
    sanitized=${sanitized#*@}
  fi
  printf '%s' "$sanitized"
}

validate_url() {
  local url=$1
  [[ $url != *[[:cntrl:]]* ]] || fail "URL contains control characters"
}

run_ipc() {
  local response
  response=$("$ipc" shell "$@") || fail "IPC failed: $*"
  printf '%s' "$response"
}

validate_plugin() {
  local directory=$1
  [[ -x $validator ]] || fail "validator is missing or not executable: $validator"
  "$validator" "$directory" || fail "plugin validation failed"
}

manifest_id() {
  local directory=$1 id
  id=$(jq -e -r '.id | select(type == "string" and length > 0)' -- "$directory/manifest.json") ||
    fail "validated manifest has no string id"
  validate_third_party_id "$id"
  printf '%s' "$id"
}

find_duplicate_id() {
  local requested_id=$1 exclude_dir=${2-} manifest candidate
  [[ -d $plugins_dir && ! -L $plugins_dir ]] || return 0
  while IFS= read -r -d '' manifest; do
    [[ $manifest == "$stage_dir/manifest.json" ]] && continue
    if [[ ${manifest%/manifest.json} == "$plugins_dir/$requested_id" ]] || \
      { [[ -n $exclude_dir ]] && [[ $(realpath -- "${manifest%/manifest.json}") == "$(realpath -- "$exclude_dir")" ]]; }; then
      continue
    fi
    candidate=$(jq -r '.id // empty' -- "$manifest" 2>/dev/null || true)
    if [[ $candidate == "$requested_id" ]]; then
      printf '%s: plugin id already installed: %s\n' "$script_name" "$requested_id" >&2
      return 1
    fi
  done < <(find "$plugins_dir" -mindepth 2 -maxdepth 2 -name manifest.json \
    -not -path "$plugins_dir/.*" -print0)
}

acquire_add_lock() {
  capture_mutation_root
  exec {add_lock_fd}>"/proc/self/fd/$root_fd/.plugin-manager.lock" || fail "cannot open plugin add lock"
  flock -x "$add_lock_fd" || fail "cannot acquire plugin add lock"
  revalidate_mutation_root || fail "plugin root changed while acquiring lock"
}

confirm_install() {
  local url=$1 answer display_url
  if [[ ! -t 0 || ! -t 1 ]]; then
    fail "refusing non-interactive install without --yes"
  fi
  display_url=$(sanitize_url "$url")
  printf 'Warning: plugins execute unsandboxed code. Install %s? [y/N] ' "$display_url" >&2
  IFS= read -r answer || fail "installation not confirmed"
  [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || fail "installation not confirmed"
}

confirm_mutation() {
  local action=$1 answer
  if [[ ! -t 0 || ! -t 1 ]]; then
    fail "refusing non-interactive $action without --yes"
  fi
  printf 'Warning: plugins execute unsandboxed code. %s? [y/N] ' "$action" >&2
  IFS= read -r answer || fail "$action not confirmed"
  [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || fail "$action not confirmed"
}

rescan() {
  if ! "$ipc" shell rescanPlugins >/dev/null; then
    printf '%s: plugin rescan IPC failed\n' "$script_name" >&2
    return 1
  fi
}

list_json() {
  local response id
  response=$(run_ipc listPlugins)
  jq -e 'type == "array" and all(.[]; type == "object" and (.id | type) == "string")' \
    >/dev/null <<< "$response" || fail "IPC returned an invalid plugin list"
  while IFS= read -r id; do
    validate_safe_id "$id"
  done < <(jq -r '.[].id' <<< "$response")
  printf '%s\n' "$response"
}

wait_for_discovery() {
  local id=$1 attempt response
  for ((attempt = 0; attempt < 40; attempt++)); do
    response=$(list_json)
    if jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null <<< "$response"; then
      return 0
    fi
    sleep 0.1
  done
  fail "plugin was not discovered after rescan: $id"
}

install_plugin() {
  local url=$1 expected_id=$2 enable=$3 yes=$4 id target response stage_identity stage_suffix renamed_stage
  [[ -z $expected_id ]] || validate_third_party_id "$expected_id"
  validate_url "$url"
  (( yes )) || confirm_install "$url"
  mkdir -p -- "$plugins_dir"
  [[ -d $plugins_dir && ! -L $plugins_dir ]] || fail "plugin root is not a real directory"
  acquire_add_lock
  mkdir -p -- "$plugins_dir/$artifact_root_name/unassigned" || fail "cannot create artifact namespace"
  stage_dir=$(mktemp -d "$plugins_dir/$artifact_root_name/unassigned/add.XXXXXX") || fail "cannot create staging directory"
  candidate_identity=$(stat -c '%d:%i' -- "$stage_dir") || fail "cannot identify staging directory"
  if ! git -c credential.helper= -c core.askPass=/bin/false clone --no-recurse-submodules -- "$url" "$stage_dir" \
    >/dev/null 2>&1; then
    fail "clone failed"
  fi
  validate_plugin "$stage_dir"
  id=$(manifest_id "$stage_dir")
  [[ -z $expected_id ]] || [[ $id == "$expected_id" ]] || fail "expected id $expected_id, got $id"
  stage_suffix=${stage_dir##*.}
  [[ $stage_suffix =~ ^[A-Za-z0-9_-]+$ ]] || fail "malformed add staging name: $stage_dir"
  mkdir -p -- "$(root_name_path "$artifact_root_name/$id")" || fail "cannot create artifact namespace: $id"
  renamed_stage=$(artifact_path "$id" add "$stage_suffix")
  revalidate_mutation_root || fail "plugin root changed before add staging rename"
  [[ $(artifact_identity "$stage_dir") == "$candidate_identity" ]] || fail "add staging identity changed: $id"
  [[ ! -e $renamed_stage && ! -L $renamed_stage ]] || fail "add staging target already exists: $id"
  mv -T -- "$stage_dir" "$renamed_stage" || fail "cannot correlate add staging artifact: $id"
  stage_dir=$(artifact_path "$id" add "$stage_suffix")
  assert_no_plugin_artifacts "$id" "$stage_dir" || fail "plugin artifacts block installation: $id"
  find_duplicate_id "$id" || fail "plugin id already installed: $id"
  target=$plugins_dir/$id
  [[ ! -e $target && ! -L $target ]] || fail "plugin target already exists: $id"
  stage_identity=$(stat -c '%d:%i' -- "$stage_dir") || fail "cannot capture staging identity"
  installed_target=$target
  installed_identity=$stage_identity
  mv -T -- "$stage_dir" "$target" || fail "cannot install plugin: $id"
  stage_dir=
  rescan || printf '%s: warning: plugin reload failed after publication\n' "$script_name" >&2
  if (( enable )); then
    wait_for_discovery "$id"
    enable_plugin "$id" ""
  fi
  installed_target=
  installed_identity=
  printf '%s\n' "$id"
}

build_placement() {
  jq -cn --arg section "$placement_section" --arg index "$placement_index" \
    --arg before "$placement_before" --arg after "$placement_after" \
    '({} + (if $section != "" then {section:$section} else {} end)
      + (if $index != "" then {index:($index|tonumber)} else {} end)
      + (if $before != "" then {before:$before} else {} end)
      + (if $after != "" then {after:$after} else {} end))'
}

enable_plugin() {
  local id=$1 placement response
  validate_safe_id "$id"
  placement=$(build_placement)
  response=$(run_ipc enablePlugin "$id" "$placement")
  [[ $response == ok ]] || fail "plugin enable failed: $response"
}

parse_enable_options() {
  local section_seen=0 option value
  placement_section=''
  placement_index=''
  placement_before=''
  placement_after=''
  while (($#)); do
    option=$1
    case $option in
      --)
        shift
        (($# == 0)) || usage
        ;;
      --section|--index|--before|--after)
        (($# >= 2)) || usage
        value=$2
        shift 2
        case $option in
          --section)
            (( section_seen == 0 )) || fail "duplicate section placement"
            [[ $value == left || $value == center || $value == right ]] || fail "invalid placement section"
            placement_section=$value
            section_seen=1
            ;;
          --index)
            [[ -z $placement_index ]] || fail "duplicate placement index"
            [[ $value =~ ^[0-9]+$ ]] || fail "placement index must be an integer"
            placement_index=$value
            ;;
          --before)
            [[ -z $placement_before && -z $placement_after ]] || fail "conflicting before/after placement"
            validate_safe_id "$value"
            placement_before=$value
            ;;
          --after)
            [[ -z $placement_before && -z $placement_after ]] || fail "conflicting before/after placement"
            validate_safe_id "$value"
            placement_after=$value
            ;;
        esac
        ;;
      -*)
        usage
        ;;
      *)
        (( section_seen == 0 )) || fail "duplicate section placement"
        [[ $option == left || $option == center || $option == right ]] || fail "invalid placement section"
        placement_section=$option
        section_seen=1
        shift
        ;;
    esac
  done
}

disable_plugin() {
  local id=$1 response
  validate_safe_id "$id"
  response=$(run_ipc setPluginEnabled "$id" false)
  [[ $response == ok ]] || fail "plugin disable failed: $response"
}

path_identity() {
  stat -Lc '%d:%i' -- "$1" 2>/dev/null
}

run_test_hook() {
  local hook=${DESKTOP_SHELL_PLUGIN_TEST_HOOK:-}
  [[ -z $hook ]] && return 0
  [[ -x $hook ]] || fail "test hook is not executable"
  "$hook" "$@"
}

capture_mutation_root() {
  local initial_path initial_identity current_path current_identity fd_identity
  [[ -d $plugins_dir && ! -L $plugins_dir ]] || fail "plugin root is not a real directory"
  initial_path=$(realpath -- "$plugins_dir") || fail "cannot resolve plugin root"
  initial_identity=$(path_identity "$plugins_dir") || fail "cannot identify plugin root"
  exec {root_fd}<"$plugins_dir" || fail "cannot open plugin root"
  run_test_hook root-open "$plugins_dir"
  [[ -d $plugins_dir && ! -L $plugins_dir ]] || fail "plugin root changed while opening"
  current_path=$(realpath -- "$plugins_dir") || fail "cannot resolve plugin root"
  current_identity=$(path_identity "$plugins_dir") || fail "cannot identify plugin root"
  fd_identity=$(path_identity "/proc/self/fd/$root_fd") || fail "cannot identify plugin root"
  [[ $initial_path == "$current_path" && $initial_identity == "$current_identity" && $current_identity == "$fd_identity" ]] ||
    fail "plugin root changed while opening"
  root_path=$current_path
  root_identity=$current_identity
}

revalidate_mutation_root() {
  local current_identity current_path
  (( root_fd >= 0 )) || return 1
  [[ -d $plugins_dir && ! -L $plugins_dir ]] || return 1
  current_identity=$(path_identity "/proc/self/fd/$root_fd") || return 1
  [[ $current_identity == "$root_identity" ]] || return 1
  current_identity=$(path_identity "$plugins_dir") || return 1
  [[ $current_identity == "$root_identity" ]] || return 1
  current_path=$(realpath -- "$plugins_dir") || return 1
  [[ $current_path == "$root_path" ]]
}

capture_target() {
  local id=$1 initial_path initial_identity current_path current_identity fd_identity
  target_path=$(plugin_directory "$id")
  initial_path=$(realpath -- "$target_path") || fail "cannot resolve plugin directory: $id"
  initial_identity=$(path_identity "$target_path") || fail "cannot identify plugin directory: $id"
  exec {target_fd}<"$target_path" || fail "cannot open plugin directory: $id"
  [[ -d $target_path && ! -L $target_path ]] || fail "plugin changed while opening: $id"
  current_path=$(realpath -- "$target_path") || fail "cannot resolve plugin directory: $id"
  current_identity=$(path_identity "$target_path") || fail "cannot identify plugin directory: $id"
  fd_identity=$(path_identity "/proc/self/fd/$target_fd") || fail "cannot identify plugin directory: $id"
  [[ $initial_path == "$current_path" && $initial_identity == "$current_identity" && $current_identity == "$fd_identity" ]] ||
    fail "plugin changed while opening: $id"
  target_real=$current_path
  target_identity=$current_identity
}

revalidate_target() {
  local current_identity current_real fd_identity
  revalidate_mutation_root || return 1
  (( target_fd >= 0 )) || return 1
  [[ -d $target_path && ! -L $target_path ]] || return 1
  current_identity=$(path_identity "$target_path") || return 1
  [[ $current_identity == "$target_identity" ]] || return 1
  fd_identity=$(path_identity "/proc/self/fd/$target_fd") || return 1
  [[ $fd_identity == "$target_identity" ]] || return 1
  current_real=$(realpath -- "$target_path") || return 1
  [[ $current_real == "$target_real" ]]
}

capture_update_target() {
  local directory=$1 initial_path initial_identity current_path current_identity fd_identity
  initial_path=$(realpath -- "$directory") || return 1
  initial_identity=$(path_identity "$directory") || return 1
  exec {update_target_fd}<"$directory" || return 1
  [[ -d $directory && ! -L $directory ]] || return 1
  current_path=$(realpath -- "$directory") || return 1
  current_identity=$(path_identity "$directory") || return 1
  fd_identity=$(path_identity "/proc/self/fd/$update_target_fd") || return 1
  [[ $initial_path == "$current_path" && $initial_identity == "$current_identity" && $current_identity == "$fd_identity" ]] || return 1
  update_target_path=$directory
  update_target_real=$current_path
  update_target_identity=$current_identity
}

capture_git_metadata() {
  local raw_common current_git current_common git_fd_identity common_fd_identity
  revalidate_update_target || return 1
  git_path=$(git -C "$update_target_path" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  raw_common=$(git -C "$update_target_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  common_path=$raw_common
  [[ $git_path == /* && $common_path == /* ]] || return 1
  [[ -d $git_path && ! -L $git_path && -d $common_path && ! -L $common_path ]] || return 1
  exec {git_fd}<"$git_path" || return 1
  exec {common_fd}<"$common_path" || return 1
  git_fd_identity=$(path_identity "/proc/self/fd/$git_fd") || return 1
  common_fd_identity=$(path_identity "/proc/self/fd/$common_fd") || return 1
  [[ $git_fd_identity == "$(path_identity "$git_path")" && $common_fd_identity == "$(path_identity "$common_path")" ]] || return 1
  [[ $git_fd_identity == "$(path_identity "$git_path")" && $common_fd_identity == "$(path_identity "$common_path")" ]] || return 1
  git_identity=$git_fd_identity
  common_identity=$common_fd_identity
  metadata_ready=1
}

revalidate_update_target() {
  local current_path current_identity fd_identity
  revalidate_mutation_root || return 1
  (( update_target_fd >= 0 )) || return 1
  [[ -d $update_target_path && ! -L $update_target_path ]] || return 1
  current_path=$(realpath -- "$update_target_path") || return 1
  current_identity=$(path_identity "$update_target_path") || return 1
  fd_identity=$(path_identity "/proc/self/fd/$update_target_fd") || return 1
  [[ $current_path == "$update_target_real" && $current_identity == "$update_target_identity" && $fd_identity == "$update_target_identity" ]]
}

revalidate_git_metadata() {
  local current_git current_common git_fd_identity common_fd_identity path_git_identity path_common_identity raw_common
  (( metadata_ready )) || return 1
  revalidate_update_target || return 1
  current_git=$(git -C "$update_target_path" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  raw_common=$(git -C "$update_target_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  current_common=$raw_common
  [[ $current_git == /* && $current_common == /* ]] || return 1
  [[ $current_git == "$git_path" && $current_common == "$common_path" ]] || return 1
  git_fd_identity=$(path_identity "/proc/self/fd/$git_fd") || return 1
  common_fd_identity=$(path_identity "/proc/self/fd/$common_fd") || return 1
  path_git_identity=$(path_identity "$git_path") || return 1
  path_common_identity=$(path_identity "$common_path") || return 1
  [[ $git_fd_identity == "$git_identity" && $common_fd_identity == "$common_identity" &&
    $path_git_identity == "$git_identity" && $path_common_identity == "$common_identity" ]]
}

stable_git() {
  GIT_DIR="/proc/self/fd/$git_fd/." GIT_COMMON_DIR="/proc/self/fd/$common_fd/." \
    git --work-tree="/proc/self/fd/$update_target_fd/." "$@"
}

release_update_target() {
  if (( update_target_fd >= 0 && update_target_fd != target_fd )); then
    exec {update_target_fd}<&-
  fi
  update_target_fd=-1
  update_target_path=
  update_target_real=
  update_target_identity=
  if (( git_fd >= 0 )); then
    exec {git_fd}<&-
    git_fd=-1
  fi
  if (( common_fd >= 0 )); then
    exec {common_fd}<&-
    common_fd=-1
  fi
  metadata_ready=0
  git_path=
  common_path=
  git_identity=
  common_identity=
}

revalidate_quarantine() {
  local path_identity_value fd_identity
  revalidate_mutation_root || return 1
  (( quarantine_fd >= 0 )) || return 1
  [[ -d $backup && ! -L $backup ]] || return 1
  path_identity_value=$(path_identity "$backup") || return 1
  fd_identity=$(path_identity "/proc/self/fd/$quarantine_fd") || return 1
  [[ $path_identity_value == "$target_identity" && $fd_identity == "$target_identity" ]]
}

restore_quarantine_source() {
  local source="/proc/self/fd/$root_fd/$1" quarantine_identity source_identity fd_identity
  [[ ! -e $source && ! -L $source ]] || return 1
  quarantine_identity=$(path_identity "$backup") || return 1
  fd_identity=$(path_identity "/proc/self/fd/$quarantine_fd") || return 1
  [[ $quarantine_identity == "$fd_identity" ]] || return 1
  mv -T -- "$backup" "$source" || return 1
  source_identity=$(path_identity "$source") || return 1
  [[ $source_identity == "$fd_identity" ]]
}

repo_identity_matches() {
  local directory=$1 expected_identity=$2 current_identity top top_real directory_real
  [[ -d $directory && ( $directory == /proc/self/fd/* || ! -L $directory ) ]] || return 1
  current_identity=$(path_identity "$directory") || return 1
  [[ $current_identity == "$expected_identity" ]] || return 1
  top=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || return 1
  top_real=$(realpath -- "$top") || return 1
  directory_real=$(realpath -- "$directory") || return 1
  [[ $top_real == "$directory_real" ]]
}

plugin_directory() {
  local id=$1 directory root_real directory_real
  validate_safe_id "$id"
  [[ -d $plugins_dir && ! -L $plugins_dir ]] || fail "plugin root is not a real directory"
  directory=$plugins_dir/$id
  [[ -d $directory && ! -L $directory ]] || fail "plugin not found: $id"
  root_real=$(realpath -- "$plugins_dir") || fail "cannot resolve plugin root"
  directory_real=$(realpath -- "$directory") || fail "cannot resolve plugin directory: $id"
  [[ $directory_real == "$root_real"/* ]] || fail "plugin directory escapes plugin root: $id"
  printf '%s' "$directory"
}

is_git_plugin() {
  local directory=$1 top top_real directory_real
  [[ -d $directory && ( $directory == /proc/self/fd/* || ! -L $directory ) ]] || return 1
  top=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || return 1
  top_real=$(realpath -- "$top") || return 1
  directory_real=$(realpath -- "$directory") || return 1
  [[ $top_real == "$directory_real" ]]
}

root_name_path() {
  printf '/proc/self/fd/%s/%s' "$root_fd" "$1"
}

artifact_identity() {
  path_identity "$1"
}

safe_remove_artifact_path() {
  local path=$1 expected_identity=${2-} hook_name=${3-} fd=-1 identity fd_path mount_output mount_target canonical_path
  [[ -n $path && -n $expected_identity ]] || return 1
  revalidate_mutation_root || return 1
  [[ -d $path && ! -L $path ]] || return 1
  exec {fd}<"$path" || return 1
  identity=$(artifact_identity "/proc/self/fd/$fd") || { exec {fd}<&-; return 1; }
  [[ $identity == "$expected_identity" ]] || { exec {fd}<&-; return 1; }
  if [[ -n $hook_name ]]; then
    run_test_hook "$hook_name" "$path" || { exec {fd}<&-; return 1; }
  fi
  revalidate_mutation_root || { exec {fd}<&-; return 1; }
  [[ $(artifact_identity "$path") == "$identity" ]] || { exec {fd}<&-; return 1; }
  canonical_path=$(realpath -- "$path") || { exec {fd}<&-; return 1; }
  local -a mount_targets=()
  mount_output=$(mktemp) || { exec {fd}<&-; return 1; }
  if ! findmnt -R -n -o TARGET --target "$canonical_path" >"$mount_output"; then
    rm -f -- "$mount_output"
    exec {fd}<&-
    return 1
  fi
  mapfile -t mount_targets <"$mount_output" || {
    rm -f -- "$mount_output"
    exec {fd}<&-
    return 1
  }
  rm -f -- "$mount_output"
  for mount_target in "${mount_targets[@]}"; do
    [[ -z $mount_target || $mount_target == / || $mount_target == "$canonical_path" ||
      $canonical_path == "$mount_target"/* ]] || {
      exec {fd}<&-
      return 1
    }
  done
  fd_path="/proc/self/fd/$fd/."
  if ! find "$fd_path" -xdev -depth -mindepth 1 -delete; then
    exec {fd}<&-
    return 1
  fi
  revalidate_mutation_root || { exec {fd}<&-; return 1; }
  [[ $(artifact_identity "$path") == "$identity" ]] || { exec {fd}<&-; return 1; }
  rmdir -- "$path" || { exec {fd}<&-; return 1; }
  exec {fd}<&-
}

capture_candidate() {
  local path=$1 initial_path initial_identity current_path current_identity fd_identity
  initial_path=$(realpath -- "$path") || return 1
  initial_identity=$(artifact_identity "$path") || return 1
  exec {candidate_fd}<"$path" || return 1
  current_path=$(realpath -- "$path") || return 1
  current_identity=$(artifact_identity "$path") || return 1
  fd_identity=$(artifact_identity "/proc/self/fd/$candidate_fd") || return 1
  [[ -d $path && ! -L $path && $initial_path == "$current_path" && $initial_identity == "$current_identity" &&
    $current_identity == "$fd_identity" ]] || return 1
  candidate_dir=$path
  candidate_real=$current_path
  candidate_identity=$current_identity
}

revalidate_candidate() {
  local current_path current_identity fd_identity
  revalidate_mutation_root || return 1
  (( candidate_fd >= 0 )) || return 1
  [[ -d $candidate_dir && ! -L $candidate_dir ]] || return 1
  current_path=$(realpath -- "$candidate_dir") || return 1
  current_identity=$(artifact_identity "$candidate_dir") || return 1
  fd_identity=$(artifact_identity "/proc/self/fd/$candidate_fd") || return 1
  [[ $current_path == "$candidate_real" && $current_identity == "$candidate_identity" && $fd_identity == "$candidate_identity" ]]
}

artifact_type() {
  local path=$1
  if [[ -L $path ]]; then
    printf 'symbolic-link'
  elif [[ -d $path ]]; then
    printf 'directory'
  elif [[ -f $path ]]; then
    printf 'regular-file'
  else
    printf 'other'
  fi
}

artifact_root_path() {
  printf '%s/%s' "$root_path" "$artifact_root_name"
}

artifact_path() {
  local id=$1 kind=$2 suffix=$3
  printf '%s/%s/%s/%s.%s' "$root_path" "$artifact_root_name" "$id" "$kind" "$suffix"
}

artifact_name_kind() {
  local name=${1##*/}
  [[ $name =~ ^(add|update|rollback|rejected|removed)\.[A-Za-z0-9_-]+$ ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

discover_artifacts() {
  local output=$1 artifact_root
  artifact_root=$(artifact_root_path)
  : >"$output" || return 1
  [[ ! -e $artifact_root && ! -L $artifact_root ]] && return 0
  [[ -d $artifact_root && ! -L $artifact_root ]] || return 1
  find "$artifact_root" -mindepth 1 -maxdepth 2 -print0 >"$output" || return 1
}

artifact_record_valid() {
  local path=$1 relative id kind parent
  relative=${path#"$(artifact_root_path)/"}
  [[ $relative != "$path" ]] || return 1
  [[ $relative == unassigned ]] && return 0
  parent=${relative%%/*}
  [[ $parent == unassigned ]] && { [[ $relative != */*/* ]] || return 1; artifact_name_kind "$relative" >/dev/null; return $?; }
  validate_safe_id "$parent" >/dev/null 2>&1 || return 1
  [[ $relative == */* && ${relative#*/} != */* ]] || return 0
  kind=$(artifact_name_kind "${relative#*/}") || return 1
  [[ -n $kind ]] || return 1
  [[ -d $path && ! -L $path ]] || return 1
}

collect_plugin_artifacts() {
  local id=$1 result_name=$2
  local -n result=$result_name
  local artifact scan_file relative owner
  # shellcheck disable=SC2034
  result=()
  scan_file=$(mktemp) || return 1
  if ! discover_artifacts "$scan_file"; then rm -f -- "$scan_file"; return 1; fi
  while IFS= read -r -d '' artifact; do
    relative=${artifact#"$(artifact_root_path)/"}
    owner=${relative%%/*}
    [[ $owner == "$id" ]] && result+=("$artifact")
  done <"$scan_file"
  rm -f -- "$scan_file"
  if ((${#result[@]})); then
    mapfile -t result < <(printf '%s\n' "${result[@]}" | sort)
  fi
}

report_plugin_artifacts() {
  local id=$1 artifacts_name=$2 artifact rollback rollback_count=0
  local public_path=$root_path/$id
  local -n items=$artifacts_name
  printf '%s: plugin artifacts block mutation for %s:\n' "$script_name" "$id" >&2
  for artifact in "${items[@]}"; do
    printf '  %q (%s)\n' "$artifact" "$(artifact_type "$artifact")" >&2
    [[ ${artifact##*/} == rollback.* && -d $artifact && ! -L $artifact ]] && {
      rollback=$artifact
      rollback_count=$((rollback_count + 1))
    }
  done
  printf '%s: manually inspect each artifact; no automatic recovery or deletion is performed.\n' "$script_name" >&2
  for artifact in "${items[@]}"; do
    printf '  stat -- %q\n' "$artifact" >&2
    printf '  findmnt -R -n -o TARGET --target %q\n' "$artifact" >&2
    printf '  find -- %q -xdev -depth -print\n' "$artifact" >&2
  done
  if [[ ! -e $public_path && ! -L $public_path && $rollback_count == 1 ]]; then
    printf '  mv -T -- %q %q\n' "$rollback" "$public_path" >&2
  fi
}

assert_no_plugin_artifacts() {
  local id=$1 exclude_path=${2-} artifact scan_file relative owner
  local -a artifacts=() all_artifacts=()
  validate_safe_id "$id"
  scan_file=$(mktemp) || return 1
  if ! discover_artifacts "$scan_file"; then rm -f -- "$scan_file"; return 1; fi
  mapfile -d '' all_artifacts <"$scan_file"
  rm -f -- "$scan_file"
  for artifact in "${all_artifacts[@]}"; do
    [[ -n $exclude_path && $artifact == "$exclude_path" ]] && continue
    relative=${artifact#"$(artifact_root_path)/"}
    owner=${relative%%/*}
    [[ $relative == "$owner" || $relative == unassigned ]] && continue
    artifact_record_valid "$artifact" || { artifacts+=("$artifact"); continue; }
    [[ $owner == "$id" || $owner == unassigned ]] || continue
    artifacts+=("$artifact")
  done
  ((${#artifacts[@]} == 0)) && return 0
  report_plugin_artifacts "$id" artifacts
  return 1
}

build_update_candidate() {
  local id=$1 public_dir=$2 remote_commit=$3 origin_url candidate transfer_ref clone_status descriptor source_dir
  origin_url=$(stable_git remote get-url origin 2>/dev/null) || fail "plugin has no origin: $id"
  [[ -n $origin_url ]] || fail "plugin has no origin: $id"
  mkdir -p -- "$(root_name_path "$artifact_root_name/$id")" || fail "cannot create update artifact namespace: $id"
  stage_dir=$(mktemp -d "$(root_name_path "$artifact_root_name/$id/update.XXXXXX")") || fail "cannot create update staging directory: $id"
  candidate=$stage_dir
  source_dir="/proc/self/fd/$update_target_fd/."
  transfer_ref="refs/omarchy/update/$id"
  stable_git update-ref "$transfer_ref" "$remote_commit" || fail "cannot stage fetched update commit: $id"
  git -c credential.helper= -c core.askPass=/bin/false clone --no-local --no-checkout --no-recurse-submodules \
    -- "$source_dir" "$candidate" >/dev/null 2>&1 || clone_status=$?
  stable_git update-ref -d "$transfer_ref" || true
  [[ ${clone_status:-0} == 0 ]] || fail "cannot clone update candidate: $id"
  git -C "$candidate" remote set-url origin "$origin_url" || fail "cannot restore candidate origin: $id"
  git -C "$candidate" fetch --quiet --no-tags -- "$source_dir" "$remote_commit" || fail "cannot transfer update commit: $id"
  git -C "$candidate" checkout --detach --quiet "$remote_commit" || fail "cannot checkout update candidate: $id"
  capture_candidate "$candidate" || fail "cannot capture update candidate: $id"
  descriptor="/proc/self/fd/$candidate_fd/."
  [[ -z $(git -C "$descriptor" status --porcelain --untracked-files=all) ]] || fail "candidate checkout is dirty: $id"
  is_git_plugin "$descriptor" || fail "candidate Git root is invalid: $id"
  [[ $(git -C "$descriptor" rev-parse HEAD) == "$remote_commit" ]] || fail "candidate commit is invalid: $id"
  [[ $(git -C "$descriptor" remote get-url origin) == "$origin_url" ]] || fail "candidate origin is invalid: $id"
  validate_plugin "$descriptor"
  [[ $(manifest_id "$descriptor") == "$id" ]] || fail "plugin update changed manifest ID: $id"
  find_duplicate_id "$id" "$public_dir" || fail "plugin update duplicated an installed manifest ID: $id"
  run_test_hook candidate-after-validation "$candidate"
  revalidate_candidate || fail "candidate changed after validation: $id"
  candidate_dir=$candidate
}

reserve_hidden_name() {
  local kind=$1 id=$2 path
  mkdir -p -- "$(root_name_path "$artifact_root_name/$id")" || return 1
  path=$(mktemp -d "$(root_name_path "$artifact_root_name/$id/$kind.XXXXXX")") || return 1
  reserved_identity=$(artifact_identity "$path") || return 1
  rmdir -- "$path" || return 1
  printf '%s' "${path##*/}"
}

restore_armed_publication() {
  local public_path rollback_path rejected_path public_identity
  (( publication_armed )) || return 0
  revalidate_mutation_root || return 1
  public_path=$(root_name_path "$publication_public_name")
  rollback_path=$(root_name_path "$publication_rollback_name")
  rejected_path=$(root_name_path "$publication_rejected_name")
  if [[ -e $public_path || -L $public_path ]]; then
    public_identity=$(artifact_identity "$public_path") || return 1
    if [[ $public_identity == "$publication_old_identity" ]]; then
      if [[ -e $rollback_path || -L $rollback_path ]]; then
        [[ -d $rollback_path && ! -L $rollback_path ]] || return 1
        safe_remove_artifact_path "$rollback_path" "$publication_rollback_reserved_identity" artifact-after-open || return 1
      fi
      [[ ! -e $rejected_path && ! -L $rejected_path ]] ||
        safe_remove_artifact_path "$rejected_path" "$publication_rejected_identity" artifact-after-open || return 1
      publication_armed=0
      return 0
    fi
    [[ $public_identity == "$publication_new_identity" ]] || return 1
    [[ ! -e $rejected_path && ! -L $rejected_path ]] || return 1
    mv -T -- "$public_path" "$rejected_path" || return 1
    publication_rejected_identity=$(artifact_identity "$rejected_path") || return 1
  fi
  [[ ! -e $public_path && ! -L $public_path ]] || return 1
  [[ -d $rollback_path && ! -L $rollback_path ]] || return 1
  if [[ $(artifact_identity "$rollback_path") != "$publication_old_identity" ]]; then
    printf '%s: rollback object identity was not original; restoring moved object to %q and failing\n' \
      "$script_name" "$root_path/$publication_public_name" >&2
    mv -T -- "$rollback_path" "$public_path" || return 1
    [[ $(artifact_identity "$public_path") == "$publication_old_identity" ]] || return 1
    publication_armed=0
    return 1
  fi
  mv -T -- "$rollback_path" "$public_path" || return 1
  [[ $(artifact_identity "$public_path") == "$publication_old_identity" ]] || return 1
  publication_armed=0
  safe_remove_artifact_path "$rejected_path" "$publication_rejected_identity" artifact-after-open || true
  return 0
}

publish_update_candidate() {
  local id=$1 stage=$2 public_dir=$3 expected_commit=$4 origin_url=$5
  local rollback_name rejected_name public_name descriptor current_identity
  : "$stage"
  revalidate_mutation_root || fail "plugin root changed before publication: $id"
  revalidate_update_target || fail "plugin changed before publication: $id"
  revalidate_candidate || fail "candidate changed before publication: $id"
  rollback_name=$(reserve_hidden_name rollback "$id") || fail "cannot reserve rollback path: $id"
  rollback_name="$artifact_root_name/$id/$rollback_name"
  publication_rollback_reserved_identity=$reserved_identity
  publication_rollback_identity=$target_identity
  rejected_name=$(reserve_hidden_name rejected "$id") || fail "cannot reserve rejected path: $id"
  rejected_name="$artifact_root_name/$id/$rejected_name"
  publication_rejected_identity=$reserved_identity
  public_name=${public_dir##*/}
  publication_armed=1
  publication_public_name=$public_name
  publication_rollback_name=$rollback_name
  publication_rejected_name=$rejected_name
  publication_old_identity=$target_identity
  publication_new_identity=$candidate_identity
  revalidate_mutation_root || fail "plugin root changed before publication: $id"
  revalidate_update_target || fail "plugin changed before publication: $id"
  revalidate_candidate || fail "candidate changed before publication: $id"
  run_test_hook before-publication
  revalidate_mutation_root || fail "plugin root changed at publication boundary: $id"
  revalidate_update_target || fail "plugin changed at publication boundary: $id"
  revalidate_candidate || fail "candidate changed at publication boundary: $id"
  [[ ! -e $(root_name_path "$rollback_name") && ! -L $(root_name_path "$rollback_name") &&
    ! -e $(root_name_path "$rejected_name") && ! -L $(root_name_path "$rejected_name") ]] ||
    fail "publication destinations changed before first rename: $id"
  mv -T -- "$(root_name_path "$public_name")" "$(root_name_path "$rollback_name")" || fail "cannot move current plugin for publication: $id"
  revalidate_mutation_root || fail "plugin root changed during publication: $id"
  revalidate_candidate || fail "candidate changed during publication: $id"
  run_test_hook after-first-publication-rename "$(root_name_path "$rollback_name")"
  [[ -d $(root_name_path "$rollback_name") && ! -L $(root_name_path "$rollback_name") ]] ||
    fail "rollback destination type changed during publication: $id"
  [[ $(artifact_identity "$(root_name_path "$rollback_name")") == "$publication_rollback_identity" ]] ||
    fail "rollback destination identity changed during publication: $id"
  [[ ! -e $(root_name_path "$public_name") && ! -L $(root_name_path "$public_name") ]] || fail "public target was repopulated during publication: $id"
  run_test_hook before-candidate-publication
  revalidate_mutation_root || fail "plugin root changed before candidate publication: $id"
  revalidate_candidate || fail "candidate changed before candidate publication: $id"
  [[ ! -e $(root_name_path "$public_name") && ! -L $(root_name_path "$public_name") &&
    ! -e $(root_name_path "$rejected_name") && ! -L $(root_name_path "$rejected_name") ]] ||
    fail "candidate publication destinations changed: $id"
  mv -T -- "$stage" "$(root_name_path "$public_name")" || fail "plugin update publication failed: $id"
  run_test_hook after-candidate-publication
  descriptor=$(root_name_path "$public_name")
  current_identity=$(artifact_identity "$descriptor") || fail "cannot identify published plugin: $id"
  [[ $current_identity == "$candidate_identity" ]] || fail "published plugin identity mismatch: $id"
  exec {publication_public_fd}<"$descriptor" || fail "cannot open published plugin: $id"
  [[ $(artifact_identity "/proc/self/fd/$publication_public_fd") == "$candidate_identity" ]] || fail "published plugin changed: $id"
  is_git_plugin "/proc/self/fd/$publication_public_fd/." || fail "published Git root is invalid: $id"
  [[ $(git -C "/proc/self/fd/$publication_public_fd/." rev-parse HEAD) == "$expected_commit" ]] || fail "published commit is invalid: $id"
  [[ $(git -C "/proc/self/fd/$publication_public_fd/." remote get-url origin) == "$origin_url" ]] || fail "published origin is invalid: $id"
  [[ -z $(git -C "/proc/self/fd/$publication_public_fd/." status --porcelain --untracked-files=all) ]] || fail "published checkout is dirty: $id"
  validate_plugin "/proc/self/fd/$publication_public_fd/."
  [[ $(artifact_identity "$descriptor") == "$candidate_identity" &&
    $(artifact_identity "/proc/self/fd/$publication_public_fd") == "$candidate_identity" ]] ||
    fail "published plugin changed during verification: $id"
  [[ $(manifest_id "/proc/self/fd/$publication_public_fd/.") == "$id" ]] || fail "published manifest ID is invalid: $id"
  publication_armed=0
  exec {publication_public_fd}<&-
  publication_public_fd=-1
  safe_remove_artifact_path "$(root_name_path "$rollback_name")" "$publication_rollback_identity" artifact-after-open ||
    printf '%s: warning: retaining rollback artifact: %s\n' "$script_name" "$rollback_name" >&2
  safe_remove_artifact_path "$(root_name_path "$rejected_name")" "$publication_rejected_identity" artifact-after-open ||
    printf '%s: warning: retaining rejected artifact: %s\n' "$script_name" "$rejected_name" >&2
  stage_dir=
  candidate_dir=
}

update_plugin() {
  local id=$1 directory=$2 expected_id=${3-} prior remote origin_url status_output status_code repo current_id
  if [[ $directory == "$target_path" && $target_fd -ge 0 ]]; then
    update_target_fd=$target_fd
    update_target_path=$target_path
    update_target_real=$target_real
    update_target_identity=$target_identity
  elif ! capture_update_target "$directory"; then
    printf '%s: plugin changed while opening: %s\n' "$script_name" "$id" >&2
    return 1
  fi
  target_path=$directory
  target_real=$update_target_real
  target_identity=$update_target_identity
  repo="/proc/self/fd/$update_target_fd/."
  if (( ! metadata_ready )) && ! capture_git_metadata "$repo"; then
    printf '%s: cannot capture Git metadata: %s\n' "$script_name" "$id" >&2
    return 1
  fi
  if ! is_git_plugin "$repo"; then
    printf '%s: plugin is not Git-managed: %s\n' "$script_name" "$id" >&2
    return 1
  fi
  prior=$(stable_git rev-parse HEAD 2>/dev/null) || {
    printf '%s: invalid Git HEAD: %s\n' "$script_name" "$id" >&2
    return 1
  }
  current_id=$(manifest_id "$repo") || {
    printf '%s: invalid public manifest: %s\n' "$script_name" "$id" >&2
    return 1
  }
  [[ $current_id == "$expected_id" ]] || {
    printf '%s: public manifest ID changed: %s\n' "$script_name" "$id" >&2
    return 1
  }
  if status_output=$(stable_git status --porcelain --untracked-files=normal); then
    :
  else
    status_code=$?
    printf '%s: unable to inspect plugin status (%s): %s\n' "$script_name" "$status_code" "$id" >&2
    return 1
  fi
  [[ -z $status_output ]] || {
    printf '%s: plugin has local changes: %s\n' "$script_name" "$id" >&2
    return 1
  }
  run_test_hook update-after-status "$update_target_path"
  origin_url=$(stable_git remote get-url origin 2>/dev/null) || {
    printf '%s: plugin has no origin: %s\n' "$script_name" "$id" >&2
    return 1
  }
  [[ -n $origin_url ]] || {
    printf '%s: plugin has no origin: %s\n' "$script_name" "$id" >&2
    return 1
  }
  revalidate_git_metadata "$repo" || {
    printf '%s: plugin changed before fetch: %s\n' "$script_name" "$id" >&2
    return 1
  }
  stable_git fetch --quiet origin HEAD >/dev/null 2>&1 || {
    printf '%s: plugin fetch failed: %s\n' "$script_name" "$id" >&2
    return 1
  }
  run_test_hook update-after-fetch "$update_target_path"
  remote=$(stable_git rev-parse FETCH_HEAD 2>/dev/null) || {
    printf '%s: invalid remote HEAD: %s\n' "$script_name" "$id" >&2
    return 1
  }
  [[ -n $remote ]] || {
    printf '%s: invalid remote HEAD: %s\n' "$script_name" "$id" >&2
    return 1
  }
  if stable_git merge-base --is-ancestor "$remote" "$prior"; then
    printf '%s: %s is up to date\n' "$script_name" "$id"
    return 2
  else
    status_code=$?
    (( status_code == 1 )) || {
      printf '%s: cannot compare plugin history: %s\n' "$script_name" "$id" >&2
      return 1
    }
  fi
  revalidate_git_metadata "$repo" || {
    printf '%s: plugin changed before merge: %s\n' "$script_name" "$id" >&2
    return 1
  }
  stable_git merge-base --is-ancestor "$prior" "$remote" || {
    printf '%s: plugin update is not a fast-forward: %s\n' "$script_name" "$id" >&2
    return 1
  }
  revalidate_mutation_root || {
    printf '%s: plugin root changed before update: %s\n' "$script_name" "$id" >&2
    return 1
  }
  revalidate_git_metadata "$repo" || {
    printf '%s: plugin changed before update: %s\n' "$script_name" "$id" >&2
    return 1
  }
  build_update_candidate "$id" "$directory" "$remote"
  publish_update_candidate "$id" "$candidate_dir" "$directory" "$remote" "$origin_url"
  return 0
}

run_update_plugin() {
  trap cleanup EXIT
  trap 'handle_signal HUP' HUP
  trap 'handle_signal INT' INT
  trap 'handle_signal TERM' TERM
  update_plugin "$@"
}

update_plugins() {
  local requested_id=${1-} id directory artifact artifact_id changed=0 failed=0 status_code return_status=0 global_artifact_block=0
  local scan_file relative owner
  # shellcheck disable=SC2034
  local -a directories=() artifacts=() id_artifacts=()
  declare -A blocked_ids=()
  if [[ -n $requested_id ]]; then
    directory=$(plugin_directory "$requested_id")
    if (run_update_plugin "$requested_id" "$directory" "$requested_id"); then
      changed=1
    else
      status_code=$?
      if [[ $status_code != 2 ]]; then
        failed=1
        [[ $status_code == 129 || $status_code == 130 || $status_code == 143 ]] && return_status=$status_code
      fi
    fi
    release_update_target
  else
    revalidate_mutation_root || fail "plugin root changed before bulk update"
    scan_file=$(mktemp) || fail "cannot inspect plugin artifacts"
    discover_artifacts "$scan_file" || { rm -f -- "$scan_file"; fail "cannot inspect plugin artifacts"; }
    mapfile -d '' artifacts <"$scan_file"
    rm -f -- "$scan_file"
    for artifact in "${artifacts[@]}"; do
      relative=${artifact#"$(artifact_root_path)/"}
      owner=${relative%%/*}
      if ! artifact_record_valid "$artifact"; then
        printf '%s: hidden artifact blocks bulk update: %q (%s); manually inspect and recover/remove it\n' \
          "$script_name" "$artifact" "$(artifact_type "$artifact")" >&2
        failed=1
        global_artifact_block=1
        continue
      fi
      [[ $relative == "$owner" ]] && continue
      if [[ $owner == unassigned ]]; then
        failed=1
        global_artifact_block=1
        continue
      fi
      blocked_ids["$owner"]=1
    done
    while IFS= read -r artifact_id; do
      [[ -n $artifact_id ]] || continue
      collect_plugin_artifacts "$artifact_id" id_artifacts
      report_plugin_artifacts "$artifact_id" id_artifacts
      failed=1
    done < <(printf '%s\n' "${!blocked_ids[@]}" | sort)
    mapfile -d '' directories < <(find "$root_path" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print0)
    for directory in "${directories[@]}"; do
      id=${directory##*/}
      validate_safe_id "$id" >/dev/null 2>&1 || continue
      is_git_plugin "$directory" || continue
      if (( global_artifact_block )) || [[ ${blocked_ids[$id]+yes} ]]; then
        failed=1
        continue
      fi
      if (run_update_plugin "$id" "$directory" "$id"); then
        changed=1
      else
        status_code=$?
        [[ $status_code == 2 ]] || failed=1
      fi
      release_update_target
    done
  fi
  if (( changed )); then
    run_test_hook before-rescan || true
    if ! rescan; then
      printf '%s: warning: plugin reload failed after publication\n' "$script_name" >&2
    fi
  fi
  (( return_status == 0 )) || return "$return_status"
  return "$failed"
}

remove_plugin() {
  local id=$1 directory backup timestamp quarantine_identity quarantine_path
  directory=$target_path
  revalidate_target || fail "plugin changed before disable: $id"
  disable_plugin "$id"
  revalidate_target || fail "plugin changed during disable: $id"
  timestamp=$(date -u +%Y%m%dT%H%M%SZ) || fail "cannot create removal timestamp"
  mkdir -p -- "$(root_name_path "$artifact_root_name/$id")" || fail "cannot create removal artifact namespace: $id"
  backup=$(artifact_path "$id" removed "$timestamp")
  mkdir -- "$backup" 2>/dev/null || fail "removal backup already exists: $id"
  rmdir -- "$backup" || fail "cannot reserve removal backup: $id"
  revalidate_target || fail "plugin changed before quarantine: $id"
  run_test_hook remove-before-quarantine "$target_path"
  revalidate_target || fail "plugin changed before quarantine: $id"
  run_test_hook remove-after-revalidate "$target_path"
  revalidate_target || fail "plugin changed before quarantine: $id"
  mv -T -- "/proc/self/fd/$root_fd/$id" "$backup" || fail "cannot quarantine plugin: $id"
  exec {quarantine_fd}<"$backup" || fail "cannot open quarantined plugin: $id"
  [[ -d $backup && ! -L $backup ]] || fail "quarantined plugin path changed: $id"
  quarantine_identity=$(path_identity "$backup") || fail "cannot identify quarantined plugin: $id"
  if [[ $quarantine_identity != "$target_identity" ]]; then
    restore_quarantine_source "$id" || true
    fail "quarantined plugin identity changed: $id"
  fi
  run_test_hook quarantine-after-identity "$backup"
  revalidate_quarantine || fail "quarantined plugin changed: $id"
  quarantine_path="/proc/self/fd/$quarantine_fd/."
  if is_git_plugin "$quarantine_path"; then
    revalidate_quarantine || fail "quarantined Git plugin changed: $id"
    safe_remove_artifact_path "$backup" "$target_identity" quarantine-after-delete ||
      fail "cannot remove Git plugin safely: $id"
  fi
  run_test_hook before-rescan
  revalidate_mutation_root || fail "plugin root changed before removal rescan: $id"
  [[ ! -e "/proc/self/fd/$root_fd/$id" && ! -L "/proc/self/fd/$root_fd/$id" ]] ||
    fail "removed plugin was repopulated before rescan: $id"
  rescan || printf '%s: warning: plugin reload failed after removal\n' "$script_name" >&2
  revalidate_mutation_root || fail "plugin root changed during removal rescan: $id"
  [[ ! -e "/proc/self/fd/$root_fd/$id" && ! -L "/proc/self/fd/$root_fd/$id" ]] ||
    fail "removed plugin was repopulated during rescan: $id"
}

main() {
  local command=${1-} url expected_id='' enable=0 yes=0 id placement response
  require_commands
  [[ -n $command ]] || usage
  shift
  case $command in
    sanitize-url)
      (($# == 1)) || usage
      sanitize_url "$1" ;;
    add|install)
      (($# >= 1)) || usage
      url=$1; shift
      while (($#)); do
        case $1 in
          --enable) enable=1 ;;
          --yes) yes=1 ;;
          --expected-id) (($# >= 2)) || usage; expected_id=$2; shift ;;
          --) shift; (($# == 0)) || usage; break ;;
          *) usage ;;
        esac
        shift
      done
      install_plugin "$url" "$expected_id" "$enable" "$yes" ;;
    validate)
      (($# == 1)) || usage
      validate_plugin "$1" ;;
    list)
      if [[ $# == 1 && $1 == --json ]]; then list_json; else (($# == 0)) || usage; list_json | jq -r '.[] | [ .id, (if .enabled then "enabled" else "disabled" end), (.clonedFrom // ""), ((.kinds // []) | join(",")), (.name // .id) ] | @tsv'; fi ;;
    enable)
      (($# >= 1)) || usage
      id=$1
      shift
      parse_enable_options "$@"
      enable_plugin "$id" ;;
    disable)
      (($# == 1)) || usage; disable_plugin "$1" ;;
    update)
      (($# <= 2)) || usage
      id=''
      while (($#)); do
        case $1 in
          --yes) yes=1 ;;
          --) shift; (($# == 0)) || usage; break ;;
          -*) usage ;;
          *) [[ -z $id ]] || usage; id=$1 ;;
        esac
        shift
      done
      mkdir -p -- "$plugins_dir"
      acquire_add_lock
      if [[ -n $id ]]; then
        assert_no_plugin_artifacts "$id" || fail "plugin artifacts block update: $id"
        capture_target "$id"
        update_target_fd=$target_fd
        update_target_path=$target_path
        update_target_real=$target_real
        update_target_identity=$target_identity
        capture_git_metadata "/proc/self/fd/$update_target_fd/." || fail "cannot capture Git metadata: $id"
        (( yes )) || confirm_mutation "update $id"
        revalidate_target || fail "plugin changed before update: $id"
      else
        (( yes )) || confirm_mutation "update all plugins"
        revalidate_mutation_root || fail "plugin root changed before update"
      fi
      update_plugins "$id" ;;
    remove)
      (($# >= 1 && $# <= 2)) || usage
      id=$1; shift
      while (($#)); do
        case $1 in
          --yes) yes=1 ;;
          --) shift; (($# == 0)) || usage; break ;;
          *) usage ;;
        esac
        shift
      done
      acquire_add_lock
      assert_no_plugin_artifacts "$id" || fail "plugin artifacts block removal: $id"
      capture_target "$id"
      (( yes )) || confirm_mutation "remove $id (destructive)"
      revalidate_target || fail "plugin changed before removal: $id"
      remove_plugin "$id" ;;
    --help|-h) usage ;;
    *) usage ;;
  esac
}

main "$@"
