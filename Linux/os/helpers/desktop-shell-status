#!/usr/bin/env bash
set -Eeuo pipefail

if (($# != 1)); then
  printf 'usage: %s <codex|disk>\n' "${0##*/}" >&2
  exit 2
fi

case $1 in
  codex|disk) ;;
  *)
    printf 'unknown status adapter: %s\n' "$1" >&2
    exit 2
    ;;
esac

readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/desktop-shell/status"
ERROR_FILE=$(mktemp)
readonly ERROR_FILE

trap 'rm -f "$ERROR_FILE"' EXIT

error_message() {
  local message=$1
  local detail=""

  if [[ -s $ERROR_FILE ]]; then
    detail=$(<"$ERROR_FILE")
    detail=${detail//$'\n'/ }
    detail=${detail//$'\r'/ }
  fi

  if [[ -n $detail ]]; then
    printf '%s: %s' "$message" "$detail"
  else
    printf '%s' "$message"
  fi
}

validate_status() {
  jq -cse '
    if length != 1 then
      error("status payload requires exactly one JSON value")
    elif (.[0] | type) != "object" then
      error("status payload is not an object")
    elif (.[0].text | type) != "string" or
      (.[0].tooltip | type) != "string" or
      (.[0].class | type) != "string" then
      error("status payload requires string text, tooltip, and class")
    elif ((.[0] | has("icon")) or (.[0] | has("value"))) and
      ((.[0].icon | type) != "string" or (.[0].value | type) != "string") then
      error("status payload requires icon and value to both be strings")
    else
      .[0]
    end
  '
}

adapter_error() {
  local kind=$1
  local message=$2
  local cache_file="$CACHE_DIR/$kind.json"
  local cached
  local transformed
  local jq_status

  if [[ -s $cache_file ]] && cached=$(validate_status <"$cache_file" 2>/dev/null); then
    if transformed=$(jq -ce --arg error "$message" '
        .class = "muted"
        | .tooltip = ((.tooltip // "") + (if (.tooltip // "") == "" then "error: " else " · error: " end) + $error)
      ' <<<"$cached"); then
      printf '%s\n' "$transformed"
      return 0
    else
      jq_status=$?
      return "$jq_status"
    fi
  fi

  printf '%s\n' "$message" >&2
  return 1
}

write_result() {
  local kind=$1
  local result=$2
  local normalized
  local temp_file=""

  : >"$ERROR_FILE"
  if ! normalized=$(validate_status <<<"$result" 2>"$ERROR_FILE"); then
    adapter_error "$kind" "$(error_message "invalid $kind result")"
    return $?
  fi

  if ! mkdir -p "$CACHE_DIR"; then
    adapter_error "$kind" "$(error_message "cannot create status cache")"
    return $?
  fi

  if ! temp_file=$(mktemp "$CACHE_DIR/.$kind.XXXXXX"); then
    adapter_error "$kind" "$(error_message "cannot create temporary status cache")"
    return $?
  fi

  if ! printf '%s\n' "$normalized" >"$temp_file" || ! mv -f "$temp_file" "$CACHE_DIR/$kind.json"; then
    rm -f "$temp_file"
    adapter_error "$kind" "$(error_message "cannot commit status cache")"
    return $?
  fi

  printf '%s\n' "$normalized"
}

json_metric_output() {
  jq -cn --arg icon "$1" --arg value "$2" --arg tooltip "$3" --arg class "$4" \
    '{icon: $icon, value: $value, text: ($icon + " " + $value), tooltip: $tooltip, class: $class}'
}

codex_status() {
  local source
  local now
  local result

  : >"$ERROR_FILE"
  if ! source=$(codexbar usage --provider codex --source oauth --format json --json-only 2>"$ERROR_FILE"); then
    adapter_error codex "$(error_message "Codex status query failed")"
    return $?
  fi

  : >"$ERROR_FILE"
  if ! now=$(date +%s 2>"$ERROR_FILE"); then
    adapter_error codex "$(error_message "Codex status query failed")"
    return $?
  fi

  : >"$ERROR_FILE"
  if ! result=$(jq -ce --argjson now "$now" '
    def countdown($timestamp):
      (($timestamp | fromdateiso8601) - $now | if . < 0 then 0 else floor end) as $seconds
      | ($seconds / 86400 | floor) as $days
      | (($seconds % 86400) / 3600 | floor) as $hours
      | (($seconds % 3600) / 60 | floor) as $minutes
      | if $days > 0 then "\($days)d\($hours)h"
        elif $hours > 0 then "\($hours)h\($minutes)m"
        else "\($minutes)m"
        end;

    def codex_provider:
      if type == "array" then
        map(select(.provider == "codex"))
        | if length == 1 then .[0] else error("expected exactly one Codex provider") end
      elif type == "object" and .provider == "codex" then .
      else error("expected one Codex provider")
      end;

    codex_provider as $provider
    | $provider.usage.secondary as $weekly
    | if ($weekly.usedPercent | type) != "number"
        or ($weekly.resetsAt | type) != "string"
        or ((($weekly.resetsAt | try fromdateiso8601 catch null) | type) != "number") then
        error("Codex weekly usage is missing or invalid")
      else
        ($provider.usage.extraRateWindows
          | if type == "array" then . else [] end) as $windows
        | (["Weekly: \($weekly.usedPercent)% used, resets in \(countdown($weekly.resetsAt))"]
          + [$windows[]
              | select(type == "object")
              | select((.window | type) == "object")
              | select((.title | type) == "string"
                and (.window.usedPercent | type) == "number"
                and (.window.resetsAt | type) == "string"
                and ((.window.resetsAt | try fromdateiso8601 catch null) | type) == "number")
              | "\(.title): \(.window.usedPercent)% used, resets in \(countdown(.window.resetsAt))"])
          as $tooltip
        | {
            text: "\($weekly.usedPercent)%/\(countdown($weekly.resetsAt))",
            tooltip: ($tooltip | join("\n")),
            class: "muted"
          }
      end
  ' <<<"$source" 2>"$ERROR_FILE"); then
    adapter_error codex "$(error_message "invalid CodexBar usage JSON")"
    return $?
  fi

  write_result codex "$result"
}

format_kib_gib() {
  local kib=$1
  local tenths=$(((kib * 10 + 524288) / 1048576))

  printf '%d.%d' "$((tenths / 10))" "$((tenths % 10))"
}

disk_status() {
  local raw
  local line
  local filesystem
  local total
  local used
  local capacity
  local percentage
  local device
  local result

  : >"$ERROR_FILE"
  if ! raw=$(df -Pk / 2>"$ERROR_FILE"); then
    adapter_error disk "$(error_message "disk status query failed")"
    return $?
  fi

  line=${raw##*$'\n'}
  if [[ $line == "$raw" || -z $line ]]; then
    adapter_error disk "df returned no filesystem row"
    return $?
  fi

  read -r filesystem total used _ capacity _ <<<"$line"
  percentage=${capacity%\%}
  if [[ -z $filesystem || ! $total =~ ^[0-9]+$ || ! $used =~ ^[0-9]+$ || ! $percentage =~ ^[0-9]+$ ]]; then
    adapter_error disk "df returned an invalid filesystem row"
    return $?
  fi

  device=${filesystem##*/}
  result=$(json_metric_output '' "$capacity" \
    "$device: $(format_kib_gib "$used") / $(format_kib_gib "$total") GiB" '')
  write_result disk "$result"
}

case $1 in
  codex) codex_status ;;
  disk) disk_status ;;
  *)
    printf 'unknown status adapter: %s\n' "$1" >&2
    exit 2
    ;;
esac
