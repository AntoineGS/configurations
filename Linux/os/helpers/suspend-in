#!/bin/bash
set -Eeuo pipefail

minutes=${1:-}

if (( $# != 1 )) || [[ ! $minutes =~ ^0*[1-9][0-9]*$ ]]; then
  notify-send -a "desktop-shell" -u critical "Suspend not scheduled" "Enter a positive whole number of minutes."
  exit 1
fi

if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then
  notify-send -a "desktop-shell" -u critical "Suspend not scheduled" "Could not lock the suspend timer."
  exit 1
fi

if ! exec {lock_fd}>"$XDG_RUNTIME_DIR/desktop-shell-suspend.lock" || ! flock "$lock_fd"; then
  notify-send -a "desktop-shell" -u critical "Suspend not scheduled" "Could not lock the suspend timer."
  exit 1
fi

if ! suspend_at=$(date --date="+$minutes minutes" "+%H:%M"); then
  exec {lock_fd}>&-
  notify-send -a "desktop-shell" -u critical "Suspend not scheduled" "The requested delay is too large."
  exit 1
fi

systemctl --user stop vicinae-suspend.timer vicinae-suspend.service desktop-shell-suspend.timer desktop-shell-suspend.service 2>/dev/null || true
systemctl --user reset-failed vicinae-suspend.timer vicinae-suspend.service desktop-shell-suspend.timer desktop-shell-suspend.service 2>/dev/null || true

if ! systemd-run --user --unit=desktop-shell-suspend --on-active="${minutes}m" --collect systemctl suspend >/dev/null 2>&1; then
  exec {lock_fd}>&-
  notify-send -a "desktop-shell" -u critical "Suspend not scheduled" "Could not create the suspend timer."
  exit 1
fi

exec {lock_fd}>&-
notify-send -a "desktop-shell" "Suspend scheduled" "Suspending in $minutes minutes, at $suspend_at." || true
exit 0
