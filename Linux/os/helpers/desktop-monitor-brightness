#!/usr/bin/env bash
# shellcheck disable=SC2016
set -Eeuo pipefail
shopt -s extglob inherit_errexit nullglob

export LC_ALL=C

readonly HELPER_NAME=${0##*/}
readonly VCP_BRIGHTNESS_CODE=10
readonly DDC_DETECT_TIMEOUT=15s
readonly HARDWARE_COMMAND_TIMEOUT=5s
readonly HARDWARE_KILL_GRACE=1s

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: Bash 4.4 or newer is required\n' "$HELPER_NAME" >&2
  exit 1
fi

usage() {
  printf 'usage: %s snapshot <previous-snapshot-json> <monitors-json> [connector]\n' "$HELPER_NAME" >&2
  printf '       %s set <step> <target-record-json>\n' "$HELPER_NAME" >&2
  exit 2
}

invocation_error() {
  printf '%s: %s\n' "$HELPER_NAME" "$1" >&2
  exit 2
}

operational_error() {
  printf '%s: %s\n' "$HELPER_NAME" "$1" >&2
  exit 1
}

resolve_command() {
  command -v "$1" 2>/dev/null
}

if ! JQ_COMMAND=$(resolve_command jq); then
  operational_error 'jq is required'
fi
if ! OD_COMMAND=$(resolve_command od); then
  operational_error 'od is required'
fi
if ! READLINK_COMMAND=$(resolve_command readlink); then
  operational_error 'readlink is required'
fi
if ! SORT_COMMAND=$(resolve_command sort); then
  operational_error 'sort is required'
fi
if HASH_COMMAND=$(resolve_command sha256sum); then
  :
elif HASH_COMMAND=$(resolve_command shasum); then
  HASH_MODE=shasum
else
  operational_error 'sha256sum or shasum is required'
fi
HASH_MODE=${HASH_MODE:-sha256sum}

SYSFS_ROOT=${DESKTOP_MONITOR_BRIGHTNESS_SYSFS_ROOT:-/sys}

declare -a CONNECTOR_NAMES=()
declare -a CONNECTOR_BASENAMES=()
declare -a CONNECTOR_PATHS=()
declare -a CONNECTOR_EDIDS=()
declare -a CONNECTOR_BUSES=()
declare -a BACKLIGHT_NAMES=()
declare -a BACKLIGHT_PATHS=()
declare -a MONITOR_NAMES=()
declare -a PENDING_CONNECTORS=()
declare -a DISCOVERY_BUSES=()
declare -a DISCOVERY_EDIDS=()
declare -a DISCOVERY_CONNECTORS=()

declare -A BACKLIGHT_FOR_CONNECTOR=()
declare -A BACKLIGHT_PATH_BY_NAME=()
declare -A MAP_BACKEND=()
declare -A MAP_KIND=()
declare -A MAP_VALUE=()
declare -A MAP_EDID=()
declare -A MAP_ERROR=()

EDID_HEX=''
NATIVE_CURRENT=''
NATIVE_MAXIMUM=''
VCP_CURRENT=''
VCP_MAXIMUM=''
LAST_ERROR=''
DETECT_BLOCK_BUS=''
DETECT_BLOCK_EDID=''
DETECT_BLOCK_CONNECTOR=''
DETECT_IN_EDID=false

valid_connector_name() {
  [[ $1 =~ ^[[:alnum:]_.:-]+$ ]]
}

valid_device_name() {
  [[ $1 =~ ^[[:alnum:]_.+-]+$ ]]
}

normalize_decimal() {
  local value=$1

  while [[ ${#value} -gt 1 && $value == 0* ]]; do
    value=${value:1}
  done
  printf '%s\n' "$value"
}

validate_edid_hex() {
  local edid=$1
  local byte
  local offset
  local normalized
  local checksum=0

  [[ ${#edid} -eq 256 && $edid =~ ^[[:xdigit:]]{256}$ ]] || return 1
  normalized=${edid,,}
  [[ ${normalized:0:16} == 00ffffffffffff00 ]] || return 1
  for ((offset = 0; offset < 256; offset += 2)); do
    byte=${edid:offset:2}
    checksum=$((checksum + 16#$byte))
  done
  ((checksum % 256 == 0)) || return 1
}

read_edid_file() {
  local path=$1
  local raw

  [[ -r $path ]] || return 1
  if ! raw=$("$OD_COMMAND" -An -tx1 -v "$path" 2>/dev/null); then
    return 1
  fi
  raw=${raw//[[:space:]]/}
  [[ ${#raw} -ge 256 ]] || return 1
  raw=${raw:0:256}
  raw=${raw,,}
  validate_edid_hex "$raw" || return 1
  EDID_HEX=$raw
}

read_connector_bus() {
  local connector_path=$1
  local resolved

  [[ -e $connector_path/ddc ]] || return 1
  if ! resolved=$("$READLINK_COMMAND" -f -- "$connector_path/ddc" 2>/dev/null); then
    return 1
  fi
  if [[ $resolved =~ (^|/)i2c-([0-9]+)(/|$) ]]; then
    normalize_decimal "${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

collect_connected_connectors() {
  local connector_path
  local connector_basename
  local connector_name
  local status
  local edid
  local bus

  CONNECTOR_NAMES=()
  CONNECTOR_BASENAMES=()
  CONNECTOR_PATHS=()
  CONNECTOR_EDIDS=()
  CONNECTOR_BUSES=()

  for connector_path in "$SYSFS_ROOT"/class/drm/*; do
    [[ -d $connector_path && -r $connector_path/status ]] || continue
    if ! status=$(<"$connector_path/status"); then
      continue
    fi
    status=${status//$'\r'/}
    [[ $status == connected ]] || continue

    connector_basename=${connector_path##*/}
    if [[ $connector_basename =~ ^card[0-9]+-(.+)$ ]]; then
      connector_name=${BASH_REMATCH[1]}
    else
      connector_name=$connector_basename
    fi
    valid_connector_name "$connector_name" || continue

    edid=''
    if read_edid_file "$connector_path/edid"; then
      edid=$EDID_HEX
    fi
    bus=''
    if bus=$(read_connector_bus "$connector_path"); then
      :
    fi

    CONNECTOR_NAMES+=([${#CONNECTOR_NAMES[@]}]="$connector_name")
    CONNECTOR_BASENAMES+=([${#CONNECTOR_BASENAMES[@]}]="$connector_basename")
    CONNECTOR_PATHS+=([${#CONNECTOR_PATHS[@]}]="$connector_path")
    CONNECTOR_EDIDS+=([${#CONNECTOR_EDIDS[@]}]="$edid")
    CONNECTOR_BUSES+=([${#CONNECTOR_BUSES[@]}]="$bus")
  done
}

is_internal_connector() {
  local connector=${1,,}

  [[ $connector == edp-* || $connector == lvds-* || $connector == dsi-* ]]
}

backlight_attributable_to_connector() {
  local backlight_path=$1
  local connector_path=$2
  local connector_basename=${connector_path##*/}
  local backlight_target
  local connector_backlight_target
  local device_target

  if [[ -e $connector_path/backlight ]]; then
    if connector_backlight_target=$("$READLINK_COMMAND" -f -- "$connector_path/backlight" 2>/dev/null) \
      && backlight_target=$("$READLINK_COMMAND" -f -- "$backlight_path" 2>/dev/null) \
      && [[ $connector_backlight_target == "$backlight_target" ]]; then
      return 0
    fi
  fi

  if [[ -e $backlight_path/device ]] \
    && device_target=$("$READLINK_COMMAND" -f -- "$backlight_path/device" 2>/dev/null); then
    if [[ $device_target == */"$connector_basename" || $device_target == */"$connector_basename"/* ]]; then
      return 0
    fi
  fi
  return 1
}

enumerate_backlights() {
  local pattern
  local candidate
  local device
  local current
  local maximum
  local -a candidates=()

  BACKLIGHT_NAMES=()
  BACKLIGHT_PATHS=()
  BACKLIGHT_PATH_BY_NAME=()

  for pattern in 'amdgpu_bl*' 'intel_backlight' 'acpi_video*' '*'; do
    # The pattern is expanded only below the selected sysfs root.
    # shellcheck disable=SC2206
    candidates=("$SYSFS_ROOT"/class/backlight/$pattern)
    for candidate in "${candidates[@]}"; do
      [[ -d $candidate && -r $candidate/brightness && -r $candidate/max_brightness ]] || continue
      device=${candidate##*/}
      valid_device_name "$device" || continue
      current=$(<"$candidate/brightness") || continue
      maximum=$(<"$candidate/max_brightness") || continue
      validate_native_pair "$current" "$maximum" || continue
      [[ -n ${BACKLIGHT_PATH_BY_NAME[$device]:-} ]] && continue
      BACKLIGHT_NAMES+=([${#BACKLIGHT_NAMES[@]}]="$device")
      BACKLIGHT_PATHS+=([${#BACKLIGHT_PATHS[@]}]="$candidate")
      BACKLIGHT_PATH_BY_NAME["$device"]=$candidate
    done
  done
}

build_backlight_mappings() {
  local index
  local backlight_index
  local connector
  local device
  local associated
  local internal_count=0
  local valid_count

  BACKLIGHT_FOR_CONNECTOR=()
  enumerate_backlights
  valid_count=${#BACKLIGHT_NAMES[@]}

  for index in "${!CONNECTOR_NAMES[@]}"; do
    connector=${CONNECTOR_NAMES[index]}
    is_internal_connector "$connector" || continue
    ((internal_count += 1))
    for backlight_index in "${!BACKLIGHT_NAMES[@]}"; do
      device=${BACKLIGHT_NAMES[backlight_index]}
      if backlight_attributable_to_connector "${BACKLIGHT_PATHS[backlight_index]}" \
        "${CONNECTOR_PATHS[index]}"; then
        associated=${BACKLIGHT_FOR_CONNECTOR[$connector]:-}
        [[ -z $associated ]] && BACKLIGHT_FOR_CONNECTOR["$connector"]=$device
      fi
    done
  done

  if ((internal_count == 1 && valid_count == 1)); then
    for connector in "${CONNECTOR_NAMES[@]}"; do
      if is_internal_connector "$connector" && [[ -z ${BACKLIGHT_FOR_CONNECTOR[$connector]:-} ]]; then
        BACKLIGHT_FOR_CONNECTOR["$connector"]=${BACKLIGHT_NAMES[0]}
      fi
    done
  fi
}

hash_text() {
  local input=$1
  local output

  if [[ $HASH_MODE == shasum ]]; then
    output=$(printf '%s' "$input" | "$HASH_COMMAND" -a 256)
  else
    output=$(printf '%s' "$input" | "$HASH_COMMAND")
  fi
  printf '%s\n' "${output%% *}"
}

compute_topology() {
  local index
  local connector
  local line
  local sorted
  local -a lines=()

  for index in "${!CONNECTOR_NAMES[@]}"; do
    connector=${CONNECTOR_NAMES[index]}
    line="${CONNECTOR_BASENAMES[index]}"$'\t'"$connector"$'\t'"${CONNECTOR_EDIDS[index]:-invalid}"$'\t'"${CONNECTOR_BUSES[index]:-none}"$'\t'"${BACKLIGHT_FOR_CONNECTOR[$connector]:-none}"
    lines+=([${#lines[@]}]="$line")
  done
  if ((${#lines[@]} == 0)); then
    sorted=''
  else
    sorted=$(printf '%s\n' "${lines[@]}" | "$SORT_COMMAND")
  fi
  TOPOLOGY=$(hash_text "$sorted")
}

find_connector_index() {
  local wanted=$1
  local index
  local found=-1
  local count=0

  for index in "${!CONNECTOR_NAMES[@]}"; do
    if [[ ${CONNECTOR_NAMES[index]} == "$wanted" ]]; then
      found=$index
      ((count += 1))
    fi
  done
  ((count == 1)) || return 1
  CONNECTOR_INDEX=$found
}

count_connected_edid() {
  local wanted=$1
  local index
  local count=0

  for index in "${!CONNECTOR_EDIDS[@]}"; do
    [[ ${CONNECTOR_EDIDS[index]} == "$wanted" ]] || continue
    ((count += 1))
  done
  printf '%s\n' "$count"
}

count_connected_bus() {
  local wanted=$1
  local index
  local count=0

  for index in "${!CONNECTOR_BUSES[@]}"; do
    [[ -n ${CONNECTOR_BUSES[index]} && ${CONNECTOR_BUSES[index]} == "$wanted" ]] || continue
    ((count += 1))
  done
  printf '%s\n' "$count"
}

validate_native_pair() {
  local current=$1
  local maximum=$2
  local normalized_current
  local normalized_maximum

  [[ $current =~ ^[0-9]+$ && $maximum =~ ^[0-9]+$ ]] || return 1
  (( ${#current} <= 18 && ${#maximum} <= 18 )) || return 1
  normalized_current=$(normalize_decimal "$current")
  normalized_maximum=$(normalize_decimal "$maximum")
  "$JQ_COMMAND" -n -e --arg current "$normalized_current" --arg maximum "$normalized_maximum" '
    ($current | tonumber) as $current_number
    | ($maximum | tonumber) as $maximum_number
    | ($maximum_number > 0 and $current_number <= $maximum_number)
  ' >/dev/null 2>&1
}

read_backlight_values() {
  local device=$1
  local path=${BACKLIGHT_PATH_BY_NAME[$device]:-}
  local current
  local maximum

  [[ -n $path && -r $path/brightness && -r $path/max_brightness ]] || return 1
  if ! current=$(<"$path/brightness") || ! maximum=$(<"$path/max_brightness"); then
    return 1
  fi
  validate_native_pair "$current" "$maximum" || return 1
  NATIVE_CURRENT=$(normalize_decimal "$current")
  NATIVE_MAXIMUM=$(normalize_decimal "$maximum")
}

calculate_percent() {
  local current=$1
  local maximum=$2
  local result

  result=$("$JQ_COMMAND" -nr --argjson current "$current" --argjson maximum "$maximum" '
    (($current * 100 / $maximum) | round)
  ') || return 1
  [[ $result =~ ^[0-9]+$ ]] || return 1
  ((result > 100)) && result=100
  printf '%s\n' "$result"
}

calculate_raw_target() {
  local requested_percent=$1
  local maximum=$2
  local result

  result=$("$JQ_COMMAND" -nr --argjson requested "$requested_percent" --argjson maximum "$maximum" '
    (($requested * $maximum / 100 + 0.5) | floor)
  ') || return 1
  [[ $result =~ ^[0-9]+$ ]] || return 1
  ((result < 1)) && result=1
  ((result > maximum)) && result=$maximum
  printf '%s\n' "$result"
}

parse_step() {
  local step=$1
  local sign
  local digits

  STEP_KIND=''
  STEP_VALUE=''
  if [[ $step =~ ^([0-9]+)%$ ]]; then
    digits=${BASH_REMATCH[1]}
    if ! "$JQ_COMMAND" -en --arg value "$digits" '$value | tonumber | . >= 1 and . <= 100' >/dev/null 2>&1; then
      return 1
    fi
    STEP_KIND=absolute
    STEP_VALUE=$(normalize_decimal "$digits")
    return 0
  fi
  if [[ $step =~ ^([+-])([0-9]+)%$ ]]; then
    sign=${BASH_REMATCH[1]}
    digits=${BASH_REMATCH[2]}
    if ! "$JQ_COMMAND" -en --arg value "$digits" '$value | tonumber | . >= 0 and . <= 100' >/dev/null 2>&1; then
      return 1
    fi
    STEP_KIND=$sign
    STEP_VALUE=$(normalize_decimal "$digits")
    return 0
  fi
  return 1
}

requested_percent() {
  local current=$1
  local maximum=$2
  local current_percent
  local result

  current_percent=$(calculate_percent "$current" "$maximum") || return 1
  if [[ $STEP_KIND == absolute ]]; then
    printf '%s\n' "$STEP_VALUE"
    return 0
  fi
  result=$current_percent
  if [[ $STEP_KIND == + ]]; then
    result=$((result + STEP_VALUE))
  else
    result=$((result - STEP_VALUE))
  fi
  ((result < 1)) && result=1
  ((result > 100)) && result=100
  printf '%s\n' "$result"
}

parse_vcp_output() {
  local raw=$1
  local current_text
  local maximum_text

  VCP_CURRENT=''
  VCP_MAXIMUM=''
  [[ -n ${raw//[[:space:]]/} ]] || return 1
  [[ $raw != *$'\n'* && $raw != *$'\r'* ]] || return 1
  if [[ $raw =~ ^[[:space:]]*VCP[[:space:]]+10[[:space:]]+C[[:space:]]+([0-9]{1,5})[[:space:]]+([0-9]{1,5})[[:space:]]*$ ]]; then
    current_text=${BASH_REMATCH[1]}
    maximum_text=${BASH_REMATCH[2]}
  else
    return 1
  fi
  VCP_CURRENT=$(normalize_decimal "$current_text")
  VCP_MAXIMUM=$(normalize_decimal "$maximum_text")
  ((VCP_MAXIMUM <= 65535 && VCP_MAXIMUM > 0 && VCP_CURRENT <= VCP_MAXIMUM)) || {
    VCP_CURRENT=''
    VCP_MAXIMUM=''
    return 1
  }
}

run_ddc_detect() {
  local ddcutil_command
  local timeout_command

  if ! ddcutil_command=$(resolve_command ddcutil); then
    LAST_ERROR='ddcutil is unavailable'
    return 1
  fi
  if ! timeout_command=$(resolve_command timeout); then
    LAST_ERROR='timeout is unavailable'
    return 1
  fi
  if ! DETECT_OUTPUT=$("$timeout_command" --signal=TERM --kill-after="$HARDWARE_KILL_GRACE" \
    "$DDC_DETECT_TIMEOUT" "$ddcutil_command" detect --verbose --disable-usb 2>/dev/null); then
    LAST_ERROR='bounded DDC discovery failed'
    return 1
  fi
}

run_ddc_read() {
  local selector_kind=$1
  local selector=$2
  local ddcutil_command
  local timeout_command
  local raw
  local -a command=()

  [[ $selector_kind == bus || $selector_kind == edid ]] || {
    LAST_ERROR='invalid DDC selector'
    return 1
  }
  [[ -n $selector ]] || {
    LAST_ERROR='empty DDC selector'
    return 1
  }
  if ! ddcutil_command=$(resolve_command ddcutil); then
    LAST_ERROR='ddcutil is unavailable'
    return 1
  fi
  if ! timeout_command=$(resolve_command timeout); then
    LAST_ERROR='timeout is unavailable'
    return 1
  fi
  if [[ $selector_kind == bus ]]; then
    command=("$ddcutil_command" --bus "$selector" getvcp "$VCP_BRIGHTNESS_CODE" --terse)
  else
    command=("$ddcutil_command" --edid "$selector" getvcp "$VCP_BRIGHTNESS_CODE" --terse)
  fi
  if ! raw=$("$timeout_command" --signal=TERM --kill-after="$HARDWARE_KILL_GRACE" \
    "$HARDWARE_COMMAND_TIMEOUT" "${command[@]}" 2>/dev/null); then
    LAST_ERROR='bounded DDC brightness read failed'
    return 1
  fi
  if ! parse_vcp_output "$raw"; then
    LAST_ERROR='DDC brightness feature is unsupported or malformed'
    return 1
  fi
}

run_ddc_set() {
  local selector_kind=$1
  local selector=$2
  local raw_target=$3
  local ddcutil_command
  local timeout_command
  local -a command=()

  [[ $selector_kind == bus || $selector_kind == edid ]] || return 1
  [[ -n $selector && $raw_target =~ ^[0-9]+$ ]] || return 1
  if ! ddcutil_command=$(resolve_command ddcutil); then
    LAST_ERROR='ddcutil is unavailable'
    return 1
  fi
  if ! timeout_command=$(resolve_command timeout); then
    LAST_ERROR='timeout is unavailable'
    return 1
  fi
  if [[ $selector_kind == bus ]]; then
    command=("$ddcutil_command" --bus "$selector" setvcp "$VCP_BRIGHTNESS_CODE" "$raw_target")
  else
    command=("$ddcutil_command" --edid "$selector" setvcp "$VCP_BRIGHTNESS_CODE" "$raw_target")
  fi
  if ! "$timeout_command" --signal=TERM --kill-after="$HARDWARE_KILL_GRACE" \
    "$HARDWARE_COMMAND_TIMEOUT" "${command[@]}" >/dev/null 2>&1; then
    LAST_ERROR='bounded DDC brightness write failed'
    return 1
  fi
}

run_backlight_set() {
  local device=$1
  local raw_target=$2
  local brightnessctl_command
  local timeout_command
  local -a command=()

  if ! brightnessctl_command=$(resolve_command brightnessctl); then
    LAST_ERROR='brightnessctl is unavailable'
    return 1
  fi
  if ! timeout_command=$(resolve_command timeout); then
    LAST_ERROR='timeout is unavailable'
    return 1
  fi
  command=("$brightnessctl_command" -d "$device" set "$raw_target")
  if ! "$timeout_command" --signal=TERM --kill-after="$HARDWARE_KILL_GRACE" \
    "$HARDWARE_COMMAND_TIMEOUT" "${command[@]}" >/dev/null 2>&1; then
    LAST_ERROR='bounded backlight write failed'
    return 1
  fi
}

reset_detect_block() {
  DETECT_BLOCK_BUS=''
  DETECT_BLOCK_EDID=''
  DETECT_BLOCK_CONNECTOR=''
  DETECT_IN_EDID=false
}

flush_detect_block() {
  local edid

  if [[ -n $DETECT_BLOCK_BUS && ${#DETECT_BLOCK_EDID} -ge 256 ]]; then
    edid=${DETECT_BLOCK_EDID:0:256}
    if validate_edid_hex "$edid"; then
      DISCOVERY_BUSES+=([${#DISCOVERY_BUSES[@]}]="$DETECT_BLOCK_BUS")
      DISCOVERY_EDIDS+=([${#DISCOVERY_EDIDS[@]}]="$edid")
      DISCOVERY_CONNECTORS+=([${#DISCOVERY_CONNECTORS[@]}]="$DETECT_BLOCK_CONNECTOR")
    fi
  fi
  reset_detect_block
}

append_detect_inline_edid() {
  local payload=$1
  local token
  local -a tokens=()

  IFS=$' \t' read -r -a tokens <<<"$payload" || true
  for token in "${tokens[@]}"; do
    [[ $token == \|* ]] && break
    if [[ $token =~ ^[[:xdigit:]]{2}$ ]]; then
      DETECT_BLOCK_EDID+=${token,,}
    elif [[ $token =~ ^[[:xdigit:]]{256,}$ && $((${#token} % 2)) -eq 0 ]]; then
      DETECT_BLOCK_EDID+=${token,,}
    else
      break
    fi
    if ((${#DETECT_BLOCK_EDID} >= 256)); then
      DETECT_IN_EDID=false
    fi
  done
}

append_detect_dump_line() {
  local line=$1
  local offset_text
  local payload
  local offset
  local expected_offset
  local token
  local byte_count=0
  local -a tokens=()

  if [[ $line =~ ^[[:space:]]*[+]?([[:xdigit:]]{2,8})[[:space:]]*:[[:space:]]+(.*)$ ]]; then
    offset_text=${BASH_REMATCH[1]}
    payload=${BASH_REMATCH[2]}
  elif [[ $line =~ ^[[:space:]]*[+]([[:xdigit:]]{4,8})[[:space:]]{2,}(.*)$ ]]; then
    offset_text=${BASH_REMATCH[1]}
    payload=${BASH_REMATCH[2]}
  else
    return 1
  fi

  offset=$((16#$offset_text))
  expected_offset=$(( ${#DETECT_BLOCK_EDID} / 2 ))
  ((offset == expected_offset && offset < 128)) || return 1
  IFS=$' \t' read -r -a tokens <<<"$payload" || true
  for token in "${tokens[@]}"; do
    [[ $token == \|* ]] && break
    [[ $token =~ ^[[:xdigit:]]{2}$ ]] || break
    DETECT_BLOCK_EDID+=${token,,}
    ((byte_count += 1))
    ((byte_count == 16)) && break
  done
  ((byte_count == 16)) || return 1
  if ((${#DETECT_BLOCK_EDID} >= 256)); then
    DETECT_IN_EDID=false
  fi
}

normalize_detect_connector() {
  local connector=$1

  if [[ $connector =~ ^card[0-9]+-(.+)$ ]]; then
    connector=${BASH_REMATCH[1]}
  fi
  valid_connector_name "$connector" || return 1
  printf '%s\n' "$connector"
}

parse_detect_output() {
  local line
  local upper
  local payload
  local connector

  DISCOVERY_BUSES=()
  DISCOVERY_EDIDS=()
  DISCOVERY_CONNECTORS=()
  reset_detect_block

  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    upper=${line^^}
    if [[ $line =~ ^[[:space:]]*Display[[:space:]]+[0-9]+ ]]; then
      flush_detect_block
      continue
    fi
    if [[ $line =~ [Ii]2[Cc][[:space:]]+[Bb]us:[[:space:]]*([^[:space:]]+) ]]; then
      if [[ -n $DETECT_BLOCK_BUS ]]; then
        flush_detect_block
      fi
      if [[ ${BASH_REMATCH[1]} =~ i2c-([0-9]+) ]]; then
        DETECT_BLOCK_BUS=$(normalize_decimal "${BASH_REMATCH[1]}")
      elif [[ ${BASH_REMATCH[1]} =~ ^[0-9]+$ ]]; then
        DETECT_BLOCK_BUS=$(normalize_decimal "${BASH_REMATCH[1]}")
      fi
      continue
    fi
    if [[ $line =~ [Dd][Rr][Mm][[:space:]]+[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Oo][Rr]:[[:space:]]*([^[:space:]]+) ]]; then
      if connector=$(normalize_detect_connector "${BASH_REMATCH[1]}"); then
        DETECT_BLOCK_CONNECTOR=$connector
      fi
      continue
    fi
    if [[ $upper == *'EDID HEX DUMP'* || $upper == *'EDID:'* ]]; then
      payload=${line#*:}
      DETECT_IN_EDID=true
      if [[ -n ${payload//[[:space:]]/} ]]; then
        append_detect_inline_edid "$payload"
      fi
      continue
    fi
    if [[ $DETECT_IN_EDID == true ]]; then
      if [[ -z ${line//[[:space:]]/} ]]; then
        DETECT_IN_EDID=false
        continue
      fi
      if [[ $line =~ ^[[:space:]]*[+][[:xdigit:]][[:space:]]+[+][[:xdigit:]] ]]; then
        continue
      fi
      append_detect_dump_line "$line" || DETECT_IN_EDID=false
    fi
  done <<<"$DETECT_OUTPUT"
  flush_detect_block
}

set_mapping() {
  local connector=$1
  local backend=$2
  local selector_kind=$3
  local selector=$4
  local edid=$5
  local error=${6:-}

  MAP_BACKEND["$connector"]=$backend
  MAP_KIND["$connector"]=$selector_kind
  MAP_VALUE["$connector"]=$selector
  MAP_EDID["$connector"]=$edid
  MAP_ERROR["$connector"]=$error
}

previous_record() {
  local connector=$1

  PREVIOUS_RECORD=''
  if PREVIOUS_RECORD=$("$JQ_COMMAND" -c --arg connector "$connector" '.monitors[$connector] // empty' <<<"$PREVIOUS_SNAPSHOT" 2>/dev/null) \
    && [[ -n $PREVIOUS_RECORD && $PREVIOUS_RECORD != null ]]; then
    return 0
  fi
  PREVIOUS_RECORD=''
  return 1
}

valid_previous_mapping() {
  local connector=$1
  local edid=$2
  local kind
  local value
  local identity
  local expected_identity

  [[ -n $PREVIOUS_RECORD ]] || return 1
  "$JQ_COMMAND" -e --arg topology "$TOPOLOGY" --arg connector "$connector" --arg edid "$edid" '
     ((.available == true and .stale == false)
       or (.available == false and .stale == true))
    and .backend == "ddc"
    and .connector == $connector
    and .topology == $topology
    and .edid == $edid
    and (.selector | type) == "object"
    and (.selector.kind | type) == "string"
    and (.selector.value | type) == "string"
  ' <<<"$PREVIOUS_RECORD" >/dev/null 2>&1 || return 1
  kind=$("$JQ_COMMAND" -r '.selector.kind' <<<"$PREVIOUS_RECORD")
  value=$("$JQ_COMMAND" -r '.selector.value' <<<"$PREVIOUS_RECORD")
  case $kind in
    bus) [[ $value =~ ^[0-9]+$ ]] || return 1; value=$(normalize_decimal "$value") ;;
    edid) [[ $value == "$edid" ]] || return 1; value=$edid ;;
    backlight) valid_device_name "$value" || return 1 ;;
    *) return 1 ;;
  esac
  identity=$("$JQ_COMMAND" -r '.identity' <<<"$PREVIOUS_RECORD")
  expected_identity=$(record_identity "$connector" "${MAP_BACKEND[$connector]}" "$edid" "$TOPOLOGY" "$kind" "$value")
  [[ $identity == "$expected_identity" ]] || return 1
  valid_previous_stale_measurement "$connector" ddc "$edid" "$kind" "$value" || return 1
  PREVIOUS_KIND=$kind
}

build_mappings() {
  local connector
  local index
  local edid
  local bus
  local bus_count

  MAP_BACKEND=()
  MAP_KIND=()
  MAP_VALUE=()
  MAP_EDID=()
  MAP_ERROR=()
  PENDING_CONNECTORS=()

  for connector in "${MONITOR_NAMES[@]}"; do
    if ! find_connector_index "$connector"; then
      if is_internal_connector "$connector"; then
        set_mapping "$connector" backlight '' '' '' 'connector is not uniquely connected in DRM'
      else
        set_mapping "$connector" ddc '' '' '' 'connector is not uniquely connected in DRM'
      fi
      continue
    fi
    index=$CONNECTOR_INDEX
    edid=${CONNECTOR_EDIDS[index]}
    if [[ -z $edid ]]; then
      if is_internal_connector "$connector"; then
        set_mapping "$connector" backlight '' '' '' 'connector EDID is missing or invalid'
      else
        set_mapping "$connector" ddc '' '' '' 'connector EDID is missing or invalid'
      fi
      continue
    fi

    if [[ -n ${BACKLIGHT_FOR_CONNECTOR[$connector]:-} ]]; then
      set_mapping "$connector" backlight backlight "${BACKLIGHT_FOR_CONNECTOR[$connector]}" "$edid"
      continue
    fi
    if is_internal_connector "$connector"; then
      set_mapping "$connector" backlight '' '' "$edid" 'no attributable internal backlight is available'
      continue
    fi

    bus=${CONNECTOR_BUSES[index]}
    if [[ -n $bus ]]; then
      bus_count=$(count_connected_bus "$bus")
      if ((bus_count == 1)); then
        set_mapping "$connector" ddc bus "$bus" "$edid"
        continue
      fi
    fi

    set_mapping "$connector" ddc '' '' "$edid"
    if previous_record "$connector" && valid_previous_mapping "$connector" "$edid"; then
      if [[ $PREVIOUS_KIND == edid ]] && [[ $(count_connected_edid "$edid") -eq 1 ]]; then
        set_mapping "$connector" ddc edid "$edid" "$edid"
        continue
      fi
    fi
    PENDING_CONNECTORS+=([${#PENDING_CONNECTORS[@]}]="$connector")
  done
}

find_discovery_record() {
  local connector=$1
  local index
  local connector_index
  local wanted_edid
  local kernel_count
  local matches=0
  local found=-1
  local bus_count
  local direct_count

  find_connector_index "$connector" || return 1
  connector_index=$CONNECTOR_INDEX
  wanted_edid=${CONNECTOR_EDIDS[connector_index]}
  kernel_count=$(count_connected_edid "$wanted_edid")
  ((kernel_count == 1)) || {
    MAP_ERROR["$connector"]='EDID is ambiguous across connected DRM connectors'
    return 1
  }

  for index in "${!DISCOVERY_EDIDS[@]}"; do
    [[ ${DISCOVERY_EDIDS[index]} == "$wanted_edid" ]] || continue
    if [[ -n ${DISCOVERY_CONNECTORS[index]} && ${DISCOVERY_CONNECTORS[index]} != "$connector" ]]; then
      continue
    fi
    ((matches += 1))
    found=$index
  done
  ((matches == 1)) || {
    MAP_ERROR["$connector"]='EDID was not uniquely discovered by DDC'
    return 1
  }

  bus_count=0
  for index in "${!DISCOVERY_BUSES[@]}"; do
    [[ ${DISCOVERY_BUSES[index]} == "${DISCOVERY_BUSES[found]}" ]] || continue
    ((bus_count += 1))
  done
  ((bus_count == 1)) || {
    MAP_ERROR["$connector"]='DDC bus discovery is ambiguous'
    return 1
  }
  direct_count=$(count_connected_bus "${DISCOVERY_BUSES[found]}")
  ((direct_count == 0)) || {
    MAP_ERROR["$connector"]='DDC bus is already attributable to another connector'
    return 1
  }

  set_mapping "$connector" ddc edid "$wanted_edid" "$wanted_edid"
}

discover_pending_mappings() {
  local connector

  ((${#PENDING_CONNECTORS[@]} == 0)) && return 0
  if ! run_ddc_detect; then
    for connector in "${PENDING_CONNECTORS[@]}"; do
      MAP_ERROR["$connector"]=$LAST_ERROR
    done
    return 0
  fi
  parse_detect_output
  for connector in "${PENDING_CONNECTORS[@]}"; do
    if ! find_discovery_record "$connector"; then
      [[ -n ${MAP_ERROR[$connector]:-} ]] || MAP_ERROR["$connector"]='DDC display mapping is unavailable'
    fi
  done
}

record_identity() {
  local connector=$1
  local backend=$2
  local edid=$3
  local topology=$4
  local selector_kind=$5
  local selector=$6

  hash_text "$connector"$'\n'"$backend"$'\n'"$edid"$'\n'"$topology"$'\n'"$selector_kind"$'\n'"$selector"
}

valid_previous_stale_measurement() {
  local connector=$1
  local backend=$2
  local edid=$3
  local selector_kind=$4
  local selector=$5
  local current
  local maximum
  local percent
  local expected_percent
  local expected_identity
  local identity

  PREVIOUS_CURRENT_JSON=null
  PREVIOUS_MAXIMUM_JSON=null
  PREVIOUS_PERCENT_JSON=null
  [[ -n $PREVIOUS_RECORD && -n $selector_kind ]] || return 1
  "$JQ_COMMAND" -e \
    --arg connector "$connector" \
    --arg backend "$backend" \
    --arg topology "$TOPOLOGY" \
    --arg edid "$edid" \
    --arg selector_kind "$selector_kind" \
    --arg selector "$selector" '
      type == "object"
       and ((.available == true and .stale == false)
         or (.available == false and .stale == true))
      and .connector == $connector
      and .backend == $backend
      and .topology == $topology
      and .edid == $edid
      and (.error | type) == "string"
      and .selector == {kind: $selector_kind, value: $selector}
      and (.current | type) == "number" and (.current | floor) == .current and .current >= 0
      and (.maximum | type) == "number" and (.maximum | floor) == .maximum and .maximum > 0
      and .current <= .maximum
      and (.percent | type) == "number" and (.percent | floor) == .percent and .percent >= 0 and .percent <= 100
      and (.identity | type) == "string"
    ' <<<"$PREVIOUS_RECORD" >/dev/null 2>&1 || return 1

  current=$("$JQ_COMMAND" -r '.current | tostring' <<<"$PREVIOUS_RECORD")
  maximum=$("$JQ_COMMAND" -r '.maximum | tostring' <<<"$PREVIOUS_RECORD")
  percent=$("$JQ_COMMAND" -r '.percent | tostring' <<<"$PREVIOUS_RECORD")
  validate_native_pair "$current" "$maximum" || return 1
  if [[ $backend == ddc ]] \
    && ! "$JQ_COMMAND" -n -e --arg maximum "$maximum" '$maximum | tonumber <= 65535' >/dev/null 2>&1; then
    return 1
  fi
  expected_percent=$(calculate_percent "$current" "$maximum") || return 1
  [[ $percent == "$expected_percent" ]] || return 1
  expected_identity=$(record_identity "$connector" "$backend" "$edid" "$TOPOLOGY" "$selector_kind" "$selector")
  identity=$("$JQ_COMMAND" -r '.identity' <<<"$PREVIOUS_RECORD")
  [[ $identity == "$expected_identity" ]] || return 1

  PREVIOUS_CURRENT_JSON=$("$JQ_COMMAND" -c '.current' <<<"$PREVIOUS_RECORD")
  PREVIOUS_MAXIMUM_JSON=$("$JQ_COMMAND" -c '.maximum' <<<"$PREVIOUS_RECORD")
  PREVIOUS_PERCENT_JSON=$("$JQ_COMMAND" -c '.percent' <<<"$PREVIOUS_RECORD")
}

build_record() {
  local connector=$1
  local backend=$2
  local available=$3
  local stale=$4
  local error=$5
  local current_json=$6
  local maximum_json=$7
  local percent_json=$8
  local edid=$9
  local selector_kind=${10}
  local selector=${11}
  local selector_json=null
  local identity=''

  if [[ -n $selector_kind ]]; then
    selector_json=$("$JQ_COMMAND" -cn --arg kind "$selector_kind" --arg value "$selector" \
      '{kind: $kind, value: $value}')
    identity=$(record_identity "$connector" "$backend" "$edid" "$TOPOLOGY" "$selector_kind" "$selector")
  fi
  "$JQ_COMMAND" -cn \
    --arg connector "$connector" \
    --arg backend "$backend" \
    --argjson available "$available" \
    --argjson stale "$stale" \
    --arg error "$error" \
    --argjson current "$current_json" \
    --argjson maximum "$maximum_json" \
    --argjson percent "$percent_json" \
    --arg identity "$identity" \
    --arg topology "$TOPOLOGY" \
    --arg edid "$edid" \
    --argjson selector "$selector_json" \
    '{connector: $connector, backend: $backend, available: $available, stale: $stale,
      error: $error, current: $current, maximum: $maximum, percent: $percent,
      identity: $identity, topology: $topology, edid: $edid, selector: $selector}'
}

unavailable_record() {
  local connector=$1
  local backend=${MAP_BACKEND[$connector]:-none}
  local error=${MAP_ERROR[$connector]:-brightness mapping is unavailable}
  local edid=${MAP_EDID[$connector]:-}
  local kind=${MAP_KIND[$connector]:-}
  local selector=${MAP_VALUE[$connector]:-}
  local current_json=null
  local maximum_json=null
  local percent_json=null
  local stale=false

  if valid_previous_stale_measurement "$connector" "$backend" "$edid" "$kind" "$selector"; then
    current_json=$PREVIOUS_CURRENT_JSON
    maximum_json=$PREVIOUS_MAXIMUM_JSON
    percent_json=$PREVIOUS_PERCENT_JSON
    stale=true
  fi
  build_record "$connector" "$backend" false "$stale" "$error" "$current_json" "$maximum_json" \
    "$percent_json" "$edid" "$kind" "$selector"
}

read_snapshot_record() {
  local connector=$1
  local backend=${MAP_BACKEND[$connector]:-none}
  local error=${MAP_ERROR[$connector]:-}
  local edid=${MAP_EDID[$connector]:-}
  local kind=${MAP_KIND[$connector]:-}
  local selector=${MAP_VALUE[$connector]:-}
  local current
  local maximum
  local percent

  if [[ -n $error || -z $kind ]]; then
    unavailable_record "$connector"
    return 0
  fi
  if [[ $backend == backlight ]]; then
    if ! read_backlight_values "$selector"; then
      MAP_ERROR["$connector"]='validated backlight could not be read'
      unavailable_record "$connector"
      return 0
    fi
    current=$NATIVE_CURRENT
    maximum=$NATIVE_MAXIMUM
  elif [[ $backend == ddc ]]; then
    if ! run_ddc_read "$kind" "$selector"; then
      MAP_ERROR["$connector"]=$LAST_ERROR
      unavailable_record "$connector"
      return 0
    fi
    current=$VCP_CURRENT
    maximum=$VCP_MAXIMUM
  else
    MAP_ERROR["$connector"]='unsupported brightness backend'
    unavailable_record "$connector"
    return 0
  fi
  if ! percent=$(calculate_percent "$current" "$maximum"); then
    MAP_ERROR["$connector"]='brightness values could not be scaled'
    unavailable_record "$connector"
    return 0
  fi
  build_record "$connector" "$backend" true false '' "$current" "$maximum" "$percent" "$edid" "$kind" "$selector"
}

validate_snapshot_arguments() {
  local previous=$1
  local monitors=$2
  local connector=${3:-}

  "$JQ_COMMAND" -e 'type == "object"' <<<"$previous" >/dev/null 2>&1 \
    || invocation_error 'previous snapshot must be a JSON object'
  "$JQ_COMMAND" -e '
    type == "array"
    and all(.[]; type == "object" and (.name | type) == "string"
      and (.name | test("^[[:alnum:]_.:-]+$")))
    and ([.[] | select(.disabled != true) | .name] | length == (unique | length))
  ' <<<"$monitors" >/dev/null 2>&1 || invocation_error 'monitors must be a valid native monitor array'
  if [[ -n $connector ]]; then
    valid_connector_name "$connector" || invocation_error 'connector is malformed'
  fi
}

load_monitor_names() {
  local monitors=$1
  local connector=${2:-}
  local names
  local name

  names=$("$JQ_COMMAND" -r '[.[] | select(.disabled != true) | .name] | .[]' <<<"$monitors")
  MONITOR_NAMES=()
  while IFS= read -r name; do
    [[ -n $name ]] && MONITOR_NAMES+=([${#MONITOR_NAMES[@]}]="$name")
  done <<<"$names"
  if [[ -n $connector ]]; then
    MONITOR_NAMES=("$connector")
  fi
}

snapshot_command() {
  local previous=$1
  local monitors=$2
  local requested_connector=${3:-}
  local connector
  local record
  local monitor_json='{}'

  PREVIOUS_SNAPSHOT=$previous
  validate_snapshot_arguments "$previous" "$monitors" "$requested_connector"
  load_monitor_names "$monitors" "$requested_connector"
  collect_connected_connectors
  build_backlight_mappings
  compute_topology
  build_mappings
  discover_pending_mappings

  for connector in "${MONITOR_NAMES[@]}"; do
    previous_record "$connector" || true
    record=$(read_snapshot_record "$connector")
    monitor_json=$("$JQ_COMMAND" -cn --arg connector "$connector" --argjson record "$record" \
      --argjson monitors "$monitor_json" '$monitors + {($connector): $record}')
  done
  "$JQ_COMMAND" -cn --arg topology "$TOPOLOGY" --argjson monitors "$monitor_json" \
    '{version: 1, topology: $topology, monitors: $monitors}'
}

validate_target_json() {
  local target=$1

  "$JQ_COMMAND" -e '
    type == "object"
    and (.connector | type) == "string" and (.connector | test("^[[:alnum:]_.:-]+$"))
    and (.backend == "backlight" or .backend == "ddc")
    and .available == true and .stale == false
    and (.error | type) == "string"
    and (.current | type) == "number" and (.current | floor) == .current and .current >= 0
    and (.maximum | type) == "number" and (.maximum | floor) == .maximum and .maximum > 0
    and .current <= .maximum
    and (.percent | type) == "number" and (.percent | floor) == .percent and .percent >= 0 and .percent <= 100
    and (.identity | type) == "string" and (.identity | test("^[0-9a-f]{64}$"))
    and (.topology | type) == "string" and (.topology | test("^[0-9a-f]{64}$"))
    and (.edid | type) == "string" and (.edid | test("^[0-9a-f]{256}$"))
    and (.selector | type) == "object"
    and (.selector.kind | type) == "string" and (.selector.value | type) == "string"
    and ((.backend == "backlight" and .selector.kind == "backlight")
      or (.backend == "ddc" and (.selector.kind == "bus" or .selector.kind == "edid")))
  ' <<<"$target" >/dev/null 2>&1 || return 1
}

set_command() {
  local step=$1
  local target=$2
  local connector
  local backend
  local target_kind
  local target_selector
  local target_edid
  local target_identity
  local target_topology
  local target_index
  local current_backend
  local current_kind
  local current_selector
  local current_edid
  local current_bus
  local current
  local maximum
  local requested
  local raw_target
  local confirmed_current
  local confirmed_maximum
  local confirmed_percent

  parse_step "$step" || invocation_error 'step must be an absolute 1%-100% or signed relative percent'
  validate_target_json "$target" || invocation_error 'target record is malformed or unavailable'
  target_edid=$("$JQ_COMMAND" -r '.edid' <<<"$target")
  validate_edid_hex "$target_edid" || invocation_error 'target EDID is not a valid base EDID'
  connector=$("$JQ_COMMAND" -r '.connector' <<<"$target")
  backend=$("$JQ_COMMAND" -r '.backend' <<<"$target")
  target_kind=$("$JQ_COMMAND" -r '.selector.kind' <<<"$target")
  target_selector=$("$JQ_COMMAND" -r '.selector.value' <<<"$target")
  target_identity=$("$JQ_COMMAND" -r '.identity' <<<"$target")
  target_topology=$("$JQ_COMMAND" -r '.topology' <<<"$target")

  if [[ $target_kind == bus ]]; then
    [[ $target_selector =~ ^[0-9]+$ ]] || operational_error 'target bus selector is malformed'
    target_selector=$(normalize_decimal "$target_selector")
  elif [[ $target_kind == edid ]]; then
    [[ $target_selector == "$target_edid" ]] || operational_error 'target EDID selector does not match its identity'
  elif [[ $target_kind == backlight ]]; then
    valid_device_name "$target_selector" || operational_error 'target backlight selector is malformed'
  fi

  collect_connected_connectors
  build_backlight_mappings
  compute_topology
  [[ $target_topology == "$TOPOLOGY" ]] || operational_error 'target topology changed; refresh is required'
  find_connector_index "$connector" || operational_error 'target connector is not uniquely connected'
  target_index=$CONNECTOR_INDEX
  current_edid=${CONNECTOR_EDIDS[target_index]}
  [[ -n $current_edid && $current_edid == "$target_edid" ]] || operational_error 'target EDID changed or is unreadable'

  current_backend=''
  current_kind=''
  current_selector=''
  if [[ -n ${BACKLIGHT_FOR_CONNECTOR[$connector]:-} ]]; then
    current_backend=backlight
    current_kind=backlight
    current_selector=${BACKLIGHT_FOR_CONNECTOR[$connector]}
  elif ! is_internal_connector "$connector"; then
    current_bus=${CONNECTOR_BUSES[target_index]}
    if [[ -n $current_bus && $(count_connected_bus "$current_bus") -eq 1 ]]; then
      current_backend=ddc
      current_kind=bus
      current_selector=$current_bus
    elif [[ $(count_connected_edid "$current_edid") -eq 1 ]]; then
      current_backend=ddc
      current_kind=edid
      current_selector=$current_edid
    fi
  fi
  [[ $current_backend == "$backend" && $current_kind == "$target_kind" && $current_selector == "$target_selector" ]] \
    || operational_error 'target selector is no longer attributable to the connector'

  target_identity=$(record_identity "$connector" "$current_backend" "$current_edid" "$TOPOLOGY" "$current_kind" "$current_selector")
  [[ $target_identity == $("$JQ_COMMAND" -r '.identity' <<<"$target") ]] \
    || operational_error 'target hardware identity changed; refresh is required'

  if [[ $backend == backlight ]]; then
    read_backlight_values "$current_selector" || operational_error 'validated backlight could not be read'
    current=$NATIVE_CURRENT
    maximum=$NATIVE_MAXIMUM
  else
    run_ddc_read "$current_kind" "$current_selector" || operational_error "$LAST_ERROR"
    current=$VCP_CURRENT
    maximum=$VCP_MAXIMUM
  fi
  requested=$(requested_percent "$current" "$maximum") || operational_error 'brightness request could not be scaled'
  raw_target=$(calculate_raw_target "$requested" "$maximum") || operational_error 'brightness target could not be scaled'

  if [[ $backend == backlight ]]; then
    run_backlight_set "$current_selector" "$raw_target" || operational_error "$LAST_ERROR"
    read_backlight_values "$current_selector" || operational_error 'backlight verification failed'
    confirmed_current=$NATIVE_CURRENT
    confirmed_maximum=$NATIVE_MAXIMUM
  else
    run_ddc_set "$current_kind" "$current_selector" "$raw_target" || operational_error "$LAST_ERROR"
    run_ddc_read "$current_kind" "$current_selector" || operational_error "$LAST_ERROR"
    confirmed_current=$VCP_CURRENT
    confirmed_maximum=$VCP_MAXIMUM
  fi
  [[ $confirmed_maximum == "$maximum" && $confirmed_current == "$raw_target" ]] \
    || operational_error 'brightness write verification did not confirm the requested value'
  confirmed_percent=$(calculate_percent "$confirmed_current" "$confirmed_maximum") \
    || operational_error 'confirmed brightness could not be scaled'
  build_record "$connector" "$backend" true false '' "$confirmed_current" "$confirmed_maximum" \
    "$confirmed_percent" "$current_edid" "$current_kind" "$current_selector"
}

(( $# >= 1 )) || usage
case $1 in
  snapshot)
    (( $# == 3 || $# == 4 )) || usage
    snapshot_command "$2" "$3" "${4:-}"
    ;;
  set)
    (( $# == 3 )) || usage
    set_command "$2" "$3"
    ;;
  *)
    usage
    ;;
esac
