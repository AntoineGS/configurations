#!/bin/bash

# Toggles the window gaps globally between no gaps and the default 10/5/2.

gaps=$(hyprctl getoption general:gaps_out -j | jq -r '.css' | awk '{print $1}')

if [[ $gaps == "0" ]]; then
  hyprctl eval 'hl.config({general = {gaps_out = 10, gaps_in = 5, border_size = 2}})'
else
  hyprctl eval 'hl.config({general = {gaps_out = 0,  gaps_in = 0, border_size = 0}})'
fi
