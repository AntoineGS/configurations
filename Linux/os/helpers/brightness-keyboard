#!/usr/bin/env bash
set -Eeuo pipefail

direction="${1:-up}"
case "$direction" in
  up) operation=keyboard-up ;;
  down) operation=keyboard-down ;;
  cycle) operation=keyboard-cycle ;;
  *)
    printf 'usage: brightness-keyboard <up|down|cycle>\n' >&2
    exit 2
    ;;
esac

exec desktop-osd "$operation"
