#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'usage: %s <--copy-only|--shift-insert> --history-index INDEX\n' "${0##*/}" >&2
  exit 2
}

(( $# == 3 )) || usage
mode=$1
[[ $2 == --history-index ]] || usage
index=$3
[[ $mode == --copy-only || $mode == --shift-insert ]] || usage
[[ $index =~ ^[0-9]+$ ]] || usage

history_file=${XDG_STATE_HOME:-$HOME/.local/state}/desktop-shell/clipboard-history.json
[[ -f $history_file && ! -L $history_file ]] || exit 1

jq -ej --argjson index "$index" '.[$index] | select(.type == "text") | .text' "$history_file" | wl-copy

if [[ $mode == --shift-insert ]]; then
  sleep 0.15
  wtype -M shift -k Insert -m shift 2>/dev/null || true
fi
