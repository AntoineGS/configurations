#!/bin/sh
set -u

real_wl_paste=${WL_PASTE_REAL:-/usr/bin/wl-paste}

if [ "${HERDR_ENV-}" = 1 ] && command -v herdr-waypipe-env >/dev/null 2>&1; then
  newline='
'
  if snapshot=$(
    herdr-waypipe-env read 2>/dev/null
    read_status=$?
    printf x || exit 1
    exit "$read_status"
  ); then
    snapshot=${snapshot%x}
    case $snapshot in
      *"$newline"*)
        line1=${snapshot%%"$newline"*}
        remainder=${snapshot#*"$newline"}
        case $remainder in
          *"$newline"*)
            line2=${remainder%%"$newline"*}
            remainder=${remainder#*"$newline"}
            case $remainder in
              *"$newline"*)
                line3=${remainder%%"$newline"*}
                remainder=${remainder#*"$newline"}
                [ -z "$remainder" ] || line3=
                ;;
              *) line3= ;;
            esac
            ;;
          *) line2=; line3= ;;
        esac
        ;;
      *) line1=; line2=; line3= ;;
    esac

    case $line1 in
      WAYLAND_DISPLAY=*) wayland_display=${line1#WAYLAND_DISPLAY=} ;;
      *) wayland_display= ;;
    esac
    case $line2 in
      XDG_RUNTIME_DIR=*) xdg_runtime_dir=${line2#XDG_RUNTIME_DIR=} ;;
      *) xdg_runtime_dir= ;;
    esac
    case $line3 in
      DISPLAY=*) display=${line3#DISPLAY=} ;;
      *) line3= ;;
    esac

    if [ -n "$wayland_display" ] && [ -n "$xdg_runtime_dir" ] && [ -n "$line3" ]; then
      WAYLAND_DISPLAY=$wayland_display
      XDG_RUNTIME_DIR=$xdg_runtime_dir
      export WAYLAND_DISPLAY XDG_RUNTIME_DIR

      if [ -n "$display" ]; then
        DISPLAY=$display
        export DISPLAY
      else
        unset DISPLAY
      fi
    fi
  fi
fi

exec "$real_wl_paste" "$@"
