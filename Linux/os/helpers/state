#!/bin/bash

set -Eeuo pipefail

# Manage persistent state files for system toggles and settings.
# Usage: state <set|clear> <state-name-or-pattern>
# Used to track whether features like suspend, idle lock, etc are enabled or disabled.

STATE_DIR="$HOME/.local/state/configurations"
mkdir -p "$STATE_DIR"

COMMAND="${1:-}"
STATE_NAME="${2:-}"

if [[ -z $COMMAND ]]; then
  echo "Usage: state <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z $STATE_NAME ]]; then
  echo "Usage: state $COMMAND <state-name>"
  exit 1
fi

if [[ $STATE_NAME == */* || $STATE_NAME == . || $STATE_NAME == .. ]]; then
  echo "State name must not contain a path separator or be a dot path" >&2
  exit 1
fi

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
*)
  echo "Usage: state <set|clear> <state-name-or-pattern>"
  exit 1
  ;;
esac
