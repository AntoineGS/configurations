#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob

readonly VM_LIBVIRT_URI=qemu:///system

usage() {
  printf 'usage: %s <power|monitor|tailscale|vm|bluetooth>\n' "${0##*/}" >&2
  exit 2
}

(( $# == 1 )) || usage
domain=$1
case $domain in
  power|monitor|tailscale|vm|bluetooth) ;;
  *) usage ;;
esac

command -v jq >/dev/null 2>&1 || {
  printf '%s: jq is required\n' "${0##*/}" >&2
  exit 1
}

sysfs_root=${DESKTOP_HARDWARE_SYSFS_ROOT:-/sys}
helper_dir=${DESKTOP_HARDWARE_HELPER_DIR:-}
state_dir=${DESKTOP_HARDWARE_STATE_DIR:-${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/desktop-shell/hardware}
cache_file="$state_dir/$domain.json"

current_time() {
  date +%s
}

current_time_ns() {
  local value=${DESKTOP_HARDWARE_NOW_NS:-}
  local uptime_seconds
  local uptime_fraction
  local fraction
  local seconds

  if [[ -z $value ]]; then
    if ! read -r uptime_seconds _ < /proc/uptime; then
      return 1
    fi
    [[ $uptime_seconds =~ ^([0-9]+)(\.([0-9]+))?$ ]] || return 1
    seconds=$((10#${BASH_REMATCH[1]}))
    uptime_fraction=${BASH_REMATCH[3]:-}
    uptime_fraction="${uptime_fraction}000000000"
    uptime_fraction=${uptime_fraction:0:9}
    fraction=$((10#$uptime_fraction))

    # Keep the conversion inside signed 64-bit nanosecond arithmetic.
    if (( seconds > 9223372036 )) || (( seconds == 9223372036 && fraction > 854775807 )); then
      return 1
    fi
    value=$((seconds * 1000000000 + fraction))
  fi
  [[ $value =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$value"
}

resolve_helper() {
  local name=$1
  local candidate

  if [[ -n $helper_dir ]]; then
    candidate="$helper_dir/$name"
    [[ -x $candidate ]] || return 1
    printf '%s\n' "$candidate"
    return 0
  fi

  command -v "$name" 2>/dev/null
}

resolve_command() {
  command -v "$1" 2>/dev/null
}

emit_payload() {
  local available=$1
  local stale=$2
  local updated_at=$3
  local error=$4
  local data=$5

  if [[ -n $error ]]; then
    jq -cn \
      --argjson available "$available" \
      --argjson stale "$stale" \
      --argjson updatedAt "$updated_at" \
      --arg error "$error" \
      --argjson data "$data" \
      '{available: $available, stale: $stale, updatedAt: $updatedAt, error: $error, data: $data}'
  else
    jq -cn \
      --argjson available "$available" \
      --argjson stale "$stale" \
      --argjson updatedAt "$updated_at" \
      --argjson data "$data" \
      '{available: $available, stale: $stale, updatedAt: $updatedAt, error: null, data: $data}'
  fi
}

write_cache() {
  local payload=$1
  local temporary=''

  if ! mkdir -p -- "$state_dir"; then
    return 0
  fi
  if ! temporary=$(mktemp "$state_dir/.${domain}.XXXXXX"); then
    return 0
  fi
  if ! printf '%s\n' "$payload" >"$temporary"; then
    rm -f -- "$temporary"
    return 0
  fi
  chmod 600 "$temporary" 2>/dev/null || true
  if ! mv -f -- "$temporary" "$cache_file"; then
    rm -f -- "$temporary"
  fi
}

read_cache() {
  local cached

  [[ -r $cache_file ]] || return 1
  cached=$(<"$cache_file") || return 1
  jq -e '
    type == "object" and
    (.available | type == "boolean") and
    (.stale == false) and
    (.updatedAt | type == "number") and
    (.error == null) and
    (.data | type == "object")
  ' <<<"$cached" >/dev/null 2>&1 || return 1
  printf '%s\n' "$cached"
}

emit_unavailable() {
  local data=$1
  local payload

  payload=$(emit_payload false false "$(current_time)" '' "$data")
  write_cache "$payload"
  printf '%s\n' "$payload"
  exit 0
}

emit_available() {
  local data=$1
  local payload

  payload=$(emit_payload true false "$(current_time)" '' "$data")
  write_cache "$payload"
  printf '%s\n' "$payload"
  exit 0
}

emit_stale() {
  local message=$1
  local fallback_data=${2:-'{}'}
  local cached

  if cached=$(read_cache); then
    jq -c --arg error "$message" '.stale = true | .error = $error' <<<"$cached"
  else
    emit_payload false true "$(current_time)" "$message" "$fallback_data"
  fi
  exit 1
}

vm_empty_data() {
  jq -cn '
    {
      name: "",
      vcpus: 0,
      cpuTimeNs: 0,
      sampledAtNs: 0,
      cpu: {available: false, percent: null},
      memory: {
        allocationAvailable: false,
        usageAvailable: false,
        currentKiB: null,
        maximumKiB: null,
        usableKiB: null,
        usedKiB: null,
        percent: null
      }
    }
  '
}

parse_vm_stats() {
  local raw=$1
  local key
  local value
  local state=''
  local cpu_time=''
  local vcpus=''
  local current=''
  local maximum=''
  local usable=''

  while IFS='=' read -r key value; do
    key=${key//[[:space:]]/}
    value=${value//[[:space:]]/}
    case $key in
      state.state) state=$value ;;
      cpu.time) cpu_time=$value ;;
      vcpu.current) vcpus=$value ;;
      balloon.current) current=$value ;;
      balloon.maximum) maximum=$value ;;
      balloon.usable) usable=$value ;;
    esac
  done <<<"$raw"

  jq -cn \
    --arg state "$state" \
    --arg cpu "$cpu_time" \
    --arg vcpus "$vcpus" \
    --arg current "$current" \
    --arg maximum "$maximum" \
    --arg usable "$usable" \
    '{state:$state,cpuTimeNs:$cpu,vcpus:$vcpus,currentKiB:$current,maximumKiB:$maximum,usableKiB:$usable}'
}

read_backlight() {
  local candidate
  local device=''
  local current
  local maximum
  local percent

  for candidate in \
    "$sysfs_root"/class/backlight/amdgpu_bl* \
    "$sysfs_root"/class/backlight/intel_backlight \
    "$sysfs_root"/class/backlight/acpi_video* \
    "$sysfs_root"/class/backlight/*; do
    [[ -d $candidate && -r $candidate/brightness && -r $candidate/max_brightness ]] || continue
    current=$(<"$candidate/brightness")
    maximum=$(<"$candidate/max_brightness")
    [[ $current =~ ^[0-9]+$ && $maximum =~ ^[0-9]+$ && $maximum -gt 0 ]] || continue
    device=${candidate##*/}
    percent=$((current * 100 / maximum))
    if (( percent > 100 )); then percent=100; fi
    jq -cn --arg device "$device" --argjson percent "$percent" \
      '{available: true, device: $device, percent: $percent}'
    return 0
  done

  printf '%s\n' '{"available":false,"device":"","percent":0}'
}

read_keyboard_backlight() {
  local candidate
  local device=''
  local current
  local maximum
  local percent

  for candidate in "$sysfs_root"/class/leds/*kbd_backlight*; do
    [[ -d $candidate && -r $candidate/brightness && -r $candidate/max_brightness ]] || continue
    current=$(<"$candidate/brightness")
    maximum=$(<"$candidate/max_brightness")
    [[ $current =~ ^[0-9]+$ && $maximum =~ ^[0-9]+$ && $maximum -gt 0 ]] || continue
    device=${candidate##*/}
    percent=$((current * 100 / maximum))
    if (( percent > 100 )); then percent=100; fi
    jq -cn --arg device "$device" --argjson percent "$percent" \
      '{available: true, device: $device, percent: $percent}'
    return 0
  done

  printf '%s\n' '{"available":false,"device":"","percent":0}'
}

state_power() {
  local battery_present=''
  local battery_available=false
  local status=0
  local battery_status=''
  local battery_capacity=''
  local battery_remaining=''
  local profiles_available=false
  local active_profile=''
  local profiles='[]'
  local profile_command
  local active_raw
  local profiles_raw
  local profile_data
  local data

  if battery_present=$(resolve_helper battery-present); then
    "$battery_present" >/dev/null 2>&1 || status=$?
    if (( status == 0 )); then
      battery_available=true
    elif (( status != 1 )); then
      emit_stale 'battery presence check failed'
    fi
  fi

  if [[ $battery_available == true ]]; then
    if ! battery_status=$("$(resolve_helper battery-status)" 2>/dev/null); then
      emit_stale 'battery status helper failed'
    fi
    if ! battery_capacity=$("$(resolve_helper battery-capacity)" 2>/dev/null); then
      emit_stale 'battery capacity helper failed'
    fi
    if ! battery_remaining=$("$(resolve_helper battery-remaining-time)" 2>/dev/null); then
      emit_stale 'battery remaining-time helper failed'
    fi
  fi

  if profile_command=$(resolve_command powerprofilesctl); then
    if ! active_raw=$("$profile_command" get 2>/dev/null); then
      emit_stale 'power profile query failed'
    fi
    if ! profiles_raw=$("$profile_command" list 2>/dev/null); then
      emit_stale 'power profile list failed'
    fi

    active_profile=${active_raw%%$'\n'*}
    active_profile=${active_profile//$'\r'/}
    active_profile="${active_profile#"${active_profile%%[![:space:]]*}"}"
    active_profile="${active_profile%"${active_profile##*[![:space:]]}"}"
    if [[ ! $active_profile =~ ^[[:alnum:]][[:alnum:]_.+-]*$ ]]; then
      active_profile=''
    fi

    if ! profiles=$(printf '%s\n' "$profiles_raw" | jq -Rsc '
      split("\n")
      | map(sub("^\\s*\\*?\\s*"; "") | sub(":$"; "") | select(test("^[A-Za-z0-9][A-Za-z0-9_.+-]*$")))
      | unique
    '); then
      emit_stale 'power profile list was malformed'
    fi
    profiles_available=true
  fi

  profile_data=$(jq -cn \
    --arg available "$profiles_available" \
    --arg active "$active_profile" \
    --argjson profiles "$profiles" \
    '{available: ($available == "true"), active: $active, profiles: $profiles}')
  data=$(jq -cn \
    --arg status "$battery_status" \
    --arg capacity "$battery_capacity" \
    --arg remaining "$battery_remaining" \
    --argjson profile "$profile_data" \
    '{battery: {status: $status, capacity: $capacity, remainingTime: $remaining}, profile: $profile}')
  if [[ $battery_available == true || $profiles_available == true ]]; then
    emit_available "$data"
  fi
  emit_unavailable "$data"
}

state_monitor() {
  local hyprctl_command
  local raw_monitors
  local monitors
  local brightness
  local keyboard_brightness
  local focused_monitor
  local internal_monitor
  local internal_enabled
  local mirror_enabled
  local data
  local available

  if ! hyprctl_command=$(resolve_command hyprctl); then
    emit_unavailable '{"monitors":[],"brightness":{"available":false,"device":"","percent":0},"keyboardBrightness":{"available":false,"device":"","percent":0}}'
  fi
  if ! raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null); then
    emit_stale 'hyprctl monitor query failed'
  fi
  if ! monitors=$(jq -ce '
    if type != "array" then error("monitor response is not an array") else
      map(select(type == "object") | {
        name: (if (.name | type) == "string" then .name else "" end),
        description: (if (.description | type) == "string" then .description else "" end),
        width: (if (.width | type) == "number" then .width else 0 end),
        height: (if (.height | type) == "number" then .height else 0 end),
        scale: (if (.scale | type) == "number" then .scale else 1 end),
        focused: (.focused == true),
        enabled: (.disabled != true),
        mirrorOf: (if (.mirrorOf | type) == "string" then .mirrorOf else "none" end)
      })
      | map(select(.name != ""))
    end
  ' <<<"$raw_monitors" 2>/dev/null); then
    emit_stale 'hyprctl monitor response was malformed'
  fi

  brightness=$(read_backlight)
  keyboard_brightness=$(read_keyboard_backlight)
  focused_monitor=$(jq -r '[.[] | select(.focused == true) | .name][0] // ""' <<<"$monitors")
  internal_monitor=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"; "i")) | .name][0] // ""' <<<"$monitors")
  internal_enabled=$(jq -r --arg name "$internal_monitor" 'any(.[]; .name == $name and .enabled)' <<<"$monitors")
  mirror_enabled=$(jq -r --arg internal "$internal_monitor" '$internal != "" and any(.[]; .enabled and .mirrorOf == $internal)' <<<"$monitors")
  available=$(jq -r 'length > 0' <<<"$monitors")
  data=$(jq -cn \
    --argjson monitors "$monitors" \
    --argjson brightness "$brightness" \
    --argjson keyboardBrightness "$keyboard_brightness" \
    --arg focusedMonitor "$focused_monitor" \
    --arg internalMonitor "$internal_monitor" \
    --argjson internalEnabled "$internal_enabled" \
    --argjson mirrorEnabled "$mirror_enabled" \
    '{monitors: $monitors, focusedMonitor: $focusedMonitor, internalMonitor: $internalMonitor, internalEnabled: $internalEnabled, mirrorEnabled: $mirrorEnabled, brightness: $brightness, keyboardBrightness: $keyboardBrightness}')

  if [[ $available == true ]]; then
    emit_available "$data"
  fi
  emit_unavailable "$data"
}

state_vm() {
  local virsh_command
  local raw_domains=''
  local raw_stats=''
  local parsed_stats=''
  local domain_name=''
  local state=''
  local cpu_time_ns=''
  local vcpus=''
  local current_kib=''
  local maximum_kib=''
  local usable_kib=''
  local sampled_at_ns=''
  local previous_cache=''
  local previous_name=''
  local previous_cpu_time_ns=''
  local previous_sampled_at_ns=''
  local previous_vcpus=''
  local cpu_delta=''
  local wall_delta=''
  local cpu_available=false
  local cpu_percent=null
  local allocation_available=false
  local usage_available=false
  local current_json=null
  local maximum_json=null
  local usable_json=null
  local used_json=null
  local memory_percent_json=null
  local used_kib=''
  local data
  local empty_data
  local domain_names=()

  empty_data=$(vm_empty_data)
  if ! virsh_command=$(resolve_command virsh); then
    emit_unavailable "$empty_data"
  fi
  if ! raw_domains=$(
    "$virsh_command" --connect "$VM_LIBVIRT_URI" list --state-running --name 2>&1
  ); then
    emit_stale "virsh list failed: ${raw_domains//$'\n'/ }" "$empty_data"
  fi

  mapfile -t domain_names < <(
    while IFS= read -r domain_name; do
      domain_name=${domain_name%$'\r'}
      if [[ -n ${domain_name//[[:space:]]/} ]]; then
        printf '%s\n' "$domain_name"
      fi
    done <<<"$raw_domains"
  )

  case ${#domain_names[@]} in
    0)
      emit_unavailable "$empty_data"
      ;;
    1)
      domain_name=${domain_names[0]}
      ;;
    *)
      emit_stale 'more than one running VM was found' "$empty_data"
      ;;
  esac

  if ! raw_stats=$(
    "$virsh_command" --connect "$VM_LIBVIRT_URI" domstats --domain "$domain_name" \
      --state --cpu-total --balloon --vcpu --nowait 2>&1
  ); then
    emit_stale "virsh domstats failed: ${raw_stats//$'\n'/ }" "$empty_data"
  fi
  if ! parsed_stats=$(parse_vm_stats "$raw_stats"); then
    emit_stale 'virsh domstats response could not be parsed' "$empty_data"
  fi

  state=$(jq -r '.state' <<<"$parsed_stats")
  cpu_time_ns=$(jq -r '.cpuTimeNs' <<<"$parsed_stats")
  vcpus=$(jq -r '.vcpus' <<<"$parsed_stats")
  current_kib=$(jq -r '.currentKiB' <<<"$parsed_stats")
  maximum_kib=$(jq -r '.maximumKiB' <<<"$parsed_stats")
  usable_kib=$(jq -r '.usableKiB' <<<"$parsed_stats")

  if [[ $state != 1 ]]; then
    emit_stale "virsh domstats reported non-running state: $state" "$empty_data"
  fi
  if [[ ! $cpu_time_ns =~ ^[0-9]+$ ]]; then
    emit_stale 'virsh domstats did not include a valid cpu.time' "$empty_data"
  fi
  if [[ ! $vcpus =~ ^[0-9]+$ ]] || (( vcpus <= 0 )); then
    emit_stale 'virsh domstats did not include a valid vcpu.current' "$empty_data"
  fi
  if [[ -n $current_kib && ! $current_kib =~ ^[0-9]+$ ]]; then
    emit_stale 'virsh domstats included an invalid balloon.current' "$empty_data"
  fi
  if [[ -n $maximum_kib && ! $maximum_kib =~ ^[0-9]+$ ]]; then
    emit_stale 'virsh domstats included an invalid balloon.maximum' "$empty_data"
  fi
  if [[ -n $usable_kib && ! $usable_kib =~ ^[0-9]+$ ]]; then
    emit_stale 'virsh domstats included an invalid balloon.usable' "$empty_data"
  fi

  if ! sampled_at_ns=$(current_time_ns); then
    emit_stale 'invalid VM sample timestamp' "$empty_data"
  fi

  if [[ -n $current_kib ]]; then
    current_json=$current_kib
  fi
  if [[ -n $maximum_kib ]]; then
    maximum_json=$maximum_kib
  fi
  if [[ -n $usable_kib ]]; then
    usable_json=$usable_kib
  fi

  if [[ -n $current_kib && -n $maximum_kib ]]; then
    allocation_available=true
  fi
  if [[ -n $current_kib && -n $usable_kib ]] && (( current_kib > 0 )); then
    usage_available=true
    used_kib=$(jq -cn --argjson current "$current_kib" --argjson usable "$usable_kib" \
      'if ($current - $usable) < 0 then 0 else ($current - $usable) end')
    memory_percent_json=$(jq -cn --argjson current "$current_kib" --argjson usable "$usable_kib" \
      '((($current - $usable) / $current) * 100) | ([0, (if . > 100 then 100 else . end)] | max) | round')
    used_json=$used_kib
  fi

  if previous_cache=$(read_cache); then
    previous_name=$(jq -r '.data.name // empty' <<<"$previous_cache")
    previous_cpu_time_ns=$(jq -r '.data.cpuTimeNs // empty' <<<"$previous_cache")
    previous_sampled_at_ns=$(jq -r '.data.sampledAtNs // empty' <<<"$previous_cache")
    previous_vcpus=$(jq -r '.data.vcpus // empty' <<<"$previous_cache")

    if [[ $previous_name == "$domain_name" ]] \
      && [[ $previous_cpu_time_ns =~ ^[0-9]+$ ]] \
      && [[ $previous_sampled_at_ns =~ ^[0-9]+$ ]] \
      && [[ $previous_vcpus =~ ^[0-9]+$ ]] \
      && (( previous_vcpus > 0 )) \
      && (( cpu_time_ns >= previous_cpu_time_ns )) \
      && (( sampled_at_ns > previous_sampled_at_ns )); then
      cpu_delta=$((cpu_time_ns - previous_cpu_time_ns))
      wall_delta=$((sampled_at_ns - previous_sampled_at_ns))
      cpu_percent=$(jq -cn \
        --argjson cpuDelta "$cpu_delta" \
        --argjson wallDelta "$wall_delta" \
        --argjson vcpus "$vcpus" \
        '($cpuDelta / $wallDelta / $vcpus * 100) | ([0, (if . > 100 then 100 else . end)] | max) | round')
      cpu_available=true
    fi
  fi

  data=$(jq -cn \
    --arg name "$domain_name" \
    --argjson vcpus "$vcpus" \
    --argjson cpuTimeNs "$cpu_time_ns" \
    --argjson sampledAtNs "$sampled_at_ns" \
    --argjson cpuAvailable "$cpu_available" \
    --argjson cpuPercent "$cpu_percent" \
    --argjson allocationAvailable "$allocation_available" \
    --argjson usageAvailable "$usage_available" \
    --argjson currentKiB "$current_json" \
    --argjson maximumKiB "$maximum_json" \
    --argjson usableKiB "$usable_json" \
    --argjson usedKiB "$used_json" \
    --argjson memoryPercent "$memory_percent_json" \
    '{
      name: $name,
      vcpus: $vcpus,
      cpuTimeNs: $cpuTimeNs,
      sampledAtNs: $sampledAtNs,
      cpu: {available: $cpuAvailable, percent: $cpuPercent},
      memory: {
        allocationAvailable: $allocationAvailable,
        usageAvailable: $usageAvailable,
        currentKiB: $currentKiB,
        maximumKiB: $maximumKiB,
        usableKiB: $usableKiB,
        usedKiB: $usedKiB,
        percent: $memoryPercent
      }
    }')
  emit_available "$data"
}

state_bluetooth() {
  local busctl_command
  local timeout_command
  local raw_objects
  local objects
  local path
  local percentage
  local characteristic_path
  local is_peripheral
  local reply
  local device_rows
  local characteristic_rows
  local remaining
  local gatt_deadline
  local devices='{}'
  local central_json
  local peripheral_json
  # Two complete two-second reads fit within this supplemental collection window.
  local -r gatt_budget_seconds=4
  declare -A included=()
  declare -A central=()
  declare -A peripheral=()

  if ! busctl_command=$(resolve_command busctl); then
    emit_unavailable '{"devices":{}}'
  fi

  if ! raw_objects=$("$busctl_command" --system --json=short --timeout=2 call \
      org.bluez / org.freedesktop.DBus.ObjectManager GetManagedObjects 2>/dev/null); then
    emit_stale 'unable to query BlueZ objects' '{"devices":{}}'
  fi
  if ! objects=$(jq -ce '
    if type != "object" then error("invalid ObjectManager response")
    elif .type != "a{oa{sa{sv}}}" then error("invalid ObjectManager signature")
    elif (.data | type) != "array" then error("invalid ObjectManager data")
    elif (.data | length) != 1 then error("invalid ObjectManager return count")
    elif (.data[0] | type) != "object" then error("invalid ObjectManager object map")
    else .data[0]
    end
  ' <<<"$raw_objects" 2>/dev/null); then
    emit_stale 'BlueZ object response was malformed' '{"devices":{}}'
  fi

  if ! device_rows=$(jq -r '
    def typed($value; $wanted):
      if ($value | type) != "object" then null
      elif ($value.type | type) != "string" then null
      elif $value.type != $wanted then null
      else $value
      end;
    def prop($object; $name; $wanted):
      if ($object | type) != "object" then null
      else typed($object[$name]; $wanted)
      end;
    def percent($property):
      if ($property | type) != "object" then null
      elif ($property.data | type) != "number" then null
      elif $property.data < 0 or $property.data > 100 or (($property.data | floor) != $property.data) then null
      else $property.data
      end;
    to_entries[]
    | select((.value | type) == "object")
    | . as $entry
    | ($entry.value["org.bluez.Device1"] // null) as $device
    | (prop($device; "Connected"; "b")) as $connected
    | select(($connected | type) == "object")
    | select(($connected.data | type) == "boolean" and $connected.data == true)
    | (prop($device; "ServicesResolved"; "b")) as $resolved
    | select(($resolved | type) == "object")
    | select(($resolved.data | type) == "boolean" and $resolved.data == true)
    | (percent(prop($entry.value["org.bluez.Battery1"] // null; "Percentage"; "y")) // "") as $central
    | [$entry.key, $central]
    | @tsv
  ' <<<"$objects" 2>/dev/null); then
    emit_stale 'BlueZ device response was malformed' '{"devices":{}}'
  fi

  while IFS=$'\t' read -r path percentage; do
    [[ -n $path ]] || continue
    included["$path"]=1
    if [[ $percentage =~ ^[0-9]+$ ]] && (( percentage <= 100 )); then
      central["$path"]=$percentage
    fi
  done <<<"$device_rows"

  if ! characteristic_rows=$(jq -r '
    def typed($value; $wanted):
      if ($value | type) != "object" then null
      elif ($value.type | type) != "string" then null
      elif $value.type != $wanted then null
      else $value
      end;
    def prop($object; $name; $wanted):
      if ($object | type) != "object" then null
      else typed($object[$name]; $wanted)
      end;
    def string_prop($object; $name; $wanted):
      (prop($object; $name; $wanted)) as $property
      | if ($property | type) != "object" then null
        elif ($property.data | type) != "string" then null
        else $property.data
        end;
    def descriptor_matches($value; $characteristic):
      if ($value | type) != "object" then false
      else ($value["org.bluez.GattDescriptor1"] // null) as $descriptor
        | if ($descriptor | type) != "object" then false
          else (string_prop($descriptor; "Characteristic"; "o")) as $parent
            | if $parent != $characteristic then false
              else ((string_prop($descriptor; "UUID"; "s") // "") | ascii_downcase)
                == "00002901-0000-1000-8000-00805f9b34fb"
              end
          end
        end;
    . as $objects
    | to_entries[]
    | select((.value | type) == "object")
    | . as $entry
    | ($entry.value["org.bluez.GattCharacteristic1"] // null) as $characteristic
    | select(($characteristic | type) == "object")
    | (string_prop($characteristic; "UUID"; "s") // "") as $characteristic_uuid
    | select(($characteristic_uuid | ascii_downcase)
      == "00002a19-0000-1000-8000-00805f9b34fb")
    | (string_prop($characteristic; "Service"; "o") // "") as $service
    | select($service != "")
    | ($objects[$service] // null) as $service_object
    | select(($service_object | type) == "object")
    | ($service_object["org.bluez.GattService1"] // null) as $service_interface
    | select(($service_interface | type) == "object")
    | (string_prop($service_interface; "UUID"; "s") // "") as $service_uuid
    | select(($service_uuid | ascii_downcase)
      == "0000180f-0000-1000-8000-00805f9b34fb")
    | (string_prop($service_interface; "Device"; "o") // "") as $device
    | select($device != "")
    | [$device, $entry.key, (any($objects | to_entries[];
        descriptor_matches(.value; $entry.key)))]
    | @tsv
  ' <<<"$objects" 2>/dev/null); then
    emit_stale 'BlueZ GATT response was malformed' '{"devices":{}}'
  fi

  timeout_command=$(resolve_command timeout || true)
  gatt_deadline=$((SECONDS + gatt_budget_seconds))
  while IFS=$'\t' read -r path characteristic_path is_peripheral; do
    [[ -n $path ]] || continue
    [[ -n ${included[$path]:-} ]] || continue
    if [[ $is_peripheral != true && -n ${central[$path]:-} ]]; then
      continue
    fi
    remaining=$((gatt_deadline - SECONDS))
    (( remaining > 0 )) || break
    if (( remaining > 2 )); then remaining=2; fi
    [[ -n $timeout_command ]] || break
    if ! reply=$("$timeout_command" --signal=TERM "${remaining}s" "$busctl_command" \
        --system --json=short --timeout=2 call \
        org.bluez "$characteristic_path" org.bluez.GattCharacteristic1 ReadValue 'a{sv}' 0 \
        2>/dev/null); then
      continue
    fi
    if ! percentage=$(jq -er '
      if (type != "object") then error("invalid GATT reply")
      elif .type != "ay" then error("invalid GATT type")
      elif (.data | type) != "array" then error("invalid GATT data")
      elif (.data | length) != 1 then error("GATT reply had multiple return values")
      elif (.data[0] | type) != "array" then error("invalid GATT byte array")
      elif (.data[0] | length) != 1 then error("GATT reply did not contain one byte")
      else .data[0][0] as $byte
        | if ($byte | type) != "number"
          or $byte < 0 or $byte > 100 or (($byte | floor) != $byte)
          then error("invalid GATT battery byte")
          else $byte
          end
      end
    ' <<<"$reply" 2>/dev/null); then
      continue
    fi
    if [[ $is_peripheral == true ]]; then
      peripheral["$path"]=$percentage
    elif [[ -z ${central[$path]:-} ]]; then
      central["$path"]=$percentage
    fi
  done <<<"$characteristic_rows"

  for path in "${!included[@]}"; do
    central_json=${central[$path]:-null}
    peripheral_json=${peripheral[$path]:-null}
    devices=$(jq -c --arg path "$path" --argjson central "$central_json" \
      --argjson peripheral "$peripheral_json" \
      '. + {($path): {central: $central, peripheral: $peripheral}}' <<<"$devices")
  done

  emit_available "$(jq -cn --argjson devices "$devices" '{devices: $devices}')"
}

state_tailscale() {
  local tailscale_command
  local raw_status=''
  local status=0
  local data
  local available

  if ! tailscale_command=$(resolve_command tailscale); then
    emit_unavailable '{}'
  fi

  raw_status=$("$tailscale_command" status --json 2>/dev/null) || status=$?
  if [[ -z ${raw_status//[[:space:]]/} ]]; then
    emit_unavailable '{}'
  fi
  if ! data=$(jq -ce '
    if type != "object" then error("tailscale response is not an object") else
      . as $root
      | (if ($root.Self | type) == "object" then $root.Self else {} end) as $self
      | (if ($root.BackendState | type) == "string" then $root.BackendState else "Unknown" end) as $backend
      | {
          backendState: $backend,
          running: ($backend == "Running"),
          needsLogin: ($backend == "NeedsLogin"),
          self: {
            name: (if ($self.HostName | type) == "string" and ($self.HostName | length) > 0 then $self.HostName elif ($self.DNSName | type) == "string" then $self.DNSName else "" end),
            dnsName: (if ($self.DNSName | type) == "string" then ($self.DNSName | sub("\\.$"; "")) else "" end),
            addresses: (if ($self.TailscaleIPs | type) == "array" then [$self.TailscaleIPs[] | strings | select(test("^100\\."))] else [] end),
            exitNode: ($self.ExitNode == true)
          },
          peers: (if ($root.Peer | type) == "object" then [
            $root.Peer
            | to_entries[]
            | select(.value | type == "object")
            | . as $entry
            | $entry.value as $peer
            | {
                id: ($entry.key | tostring),
                name: (if ($peer.HostName | type) == "string" then $peer.HostName elif ($peer.DNSName | type) == "string" then $peer.DNSName else "" end),
                dnsName: (if ($peer.DNSName | type) == "string" then ($peer.DNSName | sub("\\.$"; "")) else "" end),
                addresses: (if ($peer.TailscaleIPs | type) == "array" then [$peer.TailscaleIPs[] | strings | select(test("^100\\."))] else [] end),
                online: ($peer.Online == true),
                exitNodeOption: ($peer.ExitNodeOption == true),
                exitNode: ($peer.ExitNode == true),
                os: (if ($peer.OS | type) == "string" then $peer.OS else "" end)
              }
            | select(.name != "")
            ] | sort_by(.name) else [] end)
        }
    end
  ' <<<"$raw_status" 2>/dev/null); then
    emit_stale 'tailscale status response was malformed'
  fi

  available=$(jq -r '.running' <<<"$data")
  if (( status != 0 )) && [[ $available == true ]]; then
    emit_stale 'tailscale status command failed'
  fi
  if [[ $available == true ]]; then
    emit_available "$data"
  fi
  emit_unavailable "$data"
}

case $domain in
  power) state_power ;;
  monitor) state_monitor ;;
  tailscale) state_tailscale ;;
  vm) state_vm ;;
  bluetooth) state_bluetooth ;;
esac
