#!/bin/bash

if (($# > 1)); then
  printf '%s\n' 'usage: turn-off-screens [seconds]' >&2
  exit 2
fi

delay=${1-0}
if [[ ! $delay =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  printf '%s\n' 'turn-off-screens: seconds must be a non-negative number' >&2
  exit 2
fi

# remote-wake-monitor holds this unit while a Moonlight client is connected.
# DPMS off stalls Sunshine's capture, which then leaks GPU memory (~1 GB/min).
if systemctl --user is-active --quiet sunshine-idle-inhibit.service 2>/dev/null; then
  printf '%s\n' 'turn-off-screens: a Moonlight client is connected to Sunshine; not turning off the screens' >&2
  notify-send '󰍹    Screens left on' 'A Moonlight client is connected to this PC' || true
  exit 1
fi

nohup bash -c 'sleep "$1"; shift; exec "$@"' _ "$delay" \
  hyprctl eval 'hl.dispatch(hl.dsp.dpms({action="off"}))' \
  </dev/null >/dev/null 2>&1 &
