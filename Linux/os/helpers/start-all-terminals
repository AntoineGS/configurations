#!/bin/bash

set -Eeuo pipefail

export PATH="$HOME/.local/share/helpers:$PATH"
exec </dev/null >/dev/null 2>&1

if [[ ${START_ALL_TERMINALS_LOCKED:-false} != true ]]; then
  START_ALL_TERMINALS_LOCKED=true flock --exclusive --nonblock --conflict-exit-code 0 --close \
    "$XDG_RUNTIME_DIR/start-all-terminals.lock" "$0" "$@"
  exit $?
fi

rename_workspace() {
  local workspace=$1
  local name=$2

  hyprctl eval "hl.dispatch(hl.dsp.focus({workspace=$workspace})); hl.dispatch(hl.dsp.workspace.rename({workspace=$workspace, name=\"$name\"}))"
}

move_window() {
  local address=$1
  local workspace=$2

  hyprctl eval "hl.dispatch(hl.dsp.window.move({workspace=$workspace, follow=false, window=\"address:$address\"}))"
}

launch_on_workspace() {
  local workspace=$1
  local window_class=$2
  local reuse_existing=$3
  local existing_clients clients address active_window
  local attempt launcher_pid
  local reused=false
  shift 3

  existing_clients=$(hyprctl clients -j | jq -c --arg class "$window_class" \
    '[.[] | select((.class // "") | test($class)) | .address]')
  "$@" &
  launcher_pid=$!

  for ((attempt = 0; attempt < 100; attempt++)); do
    clients=$(hyprctl clients -j)
    address=$(jq -r --arg class "$window_class" --argjson existing "$existing_clients" \
      '[.[] | select((.class // "") | test($class)) | .address as $address | select($existing | index($address) | not) | $address] | first // empty' \
      <<<"$clients")

    # launch-or-focus may reuse an existing Brave window instead of creating one.
    if [[ -z $address && $reuse_existing == true ]]; then
      active_window=$(hyprctl activewindow -j)
      address=$(jq -r --arg class "$window_class" \
        'select((.class // "") | test($class)) | .address // empty' <<<"$active_window")
      [[ -z $address ]] || reused=true
    fi

    if [[ -n $address ]]; then
      if [[ $reused == true ]]; then
        wait "$launcher_pid" || return 1
        active_window=$(hyprctl activewindow -j)
        address=$(jq -r --arg class "$window_class" \
          'select((.class // "") | test($class)) | .address // empty' <<<"$active_window")
        [[ -n $address ]] || return 1
      fi

      move_window "$address" "$workspace" || return 1
      return 0
    fi

    sleep 0.1
  done

  return 1
}

failed=0

rename_workspace 1 local
launch_on_workspace 1 '^desktop-shell-local$' false \
  uwsm-app -- env "HERDR_NAV_PASSTHROUGH_RE=^(shell-picker|fzf)$" \
  xdg-terminal-exec --app-id=desktop-shell-local herdr || failed=1

rename_workspace 2 pc
launch_on_workspace 2 '^desktop-shell-pc$' false \
  uwsm-app -- xdg-terminal-exec --app-id=desktop-shell-pc waypipe ssh antoinegs@desktop-e07vtrn || failed=1

rename_workspace 3 work
launch_on_workspace 3 '^desktop-shell-work$' false \
  uwsm-app -- xdg-terminal-exec --app-id=desktop-shell-work ssh 'MULTIDEV\a.simard'@antoinews-linux || failed=1

rename_workspace 4 browser
launch_on_workspace 4 '^brave-browser$' true \
  launch-or-focus brave-browser \
  "uwsm app -- brave --enable-features=UseOzonePlatform --ozone-platform=wayland --enable-wayland-ime" || failed=1

hyprctl eval 'hl.dispatch(hl.dsp.focus({workspace=1}))'

if ((failed)); then
  notify-send "Start All Terminals" "One or more windows could not be placed on its workspace."
  exit 1
fi
