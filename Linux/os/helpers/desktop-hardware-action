#!/usr/bin/env bash
set -Eeuo pipefail

# Keep user input below the signed 64-bit arithmetic range used for the limit check.
readonly MAX_VM_MEMORY_GIB_DIGITS=18
readonly VM_LIBVIRT_URI=qemu:///system
readonly MONITOR_LAYOUT_STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-shell/monitor-layout"

usage() {
  printf 'usage: %s <power|monitor|tailscale|vm> <action> [args...]\n' "${0##*/}" >&2
  exit 2
}

run_command() {
  "$@" >/dev/null 2>&1 || exit 1
}

resolve_helper() {
  local name=$1
  local helper_dir=${DESKTOP_HARDWARE_HELPER_DIR:-}
  local candidate

  if [[ -n $helper_dir ]]; then
    candidate="$helper_dir/$name"
    [[ -x $candidate ]] || return 1
    printf '%s\n' "$candidate"
    return 0
  fi

  command -v "$name" 2>/dev/null
}

resolve_command() {
  command -v "$1" 2>/dev/null
}

valid_profile() {
  [[ $1 =~ ^[[:alnum:]][[:alnum:]_.+-]*$ ]]
}

valid_percent() {
  [[ $1 =~ ^([1-9]|[1-9][0-9]|100)$ ]]
}

valid_target() {
  [[ $1 =~ ^[[:alnum:]_.:@+-]+$ ]]
}

valid_monitor_scale() {
  [[ $1 =~ ^(1(\.[0-9]{1,7})?|2(\.0{1,7})?)$ ]]
}

valid_positive_integer() {
  local value=$1

  [[ $value =~ ^[1-9][0-9]*$ ]] || return 1
  ((${#value} <= MAX_VM_MEMORY_GIB_DIGITS))
}

set_vm_memory() {
  local gib=$1 state name maximum_kib maximum_gib virsh_command detail

  valid_positive_integer "$gib" || usage

  state=$("$(resolve_helper desktop-hardware-state)" vm) || {
    printf '%s\n' 'desktop-hardware-action: VM state is unavailable' >&2
    exit 1
  }
  jq -e '.available == true and .stale == false and .data.memory.allocationAvailable == true' \
    <<<"$state" >/dev/null || {
    printf '%s\n' 'desktop-hardware-action: no fresh running VM allocation is available' >&2
    exit 1
  }
  name=$(jq -er '.data.name | select(type == "string" and length > 0)' <<<"$state") || {
    printf '%s\n' 'desktop-hardware-action: VM state is missing a domain name' >&2
    exit 1
  }
  maximum_kib=$(jq -er '.data.memory.maximumKiB | select(type == "number" and . > 0)' <<<"$state") || {
    printf '%s\n' 'desktop-hardware-action: VM maximum memory is unavailable' >&2
    exit 1
  }
  maximum_gib=$((maximum_kib / 1048576))
  ((gib <= maximum_gib)) || {
    printf 'desktop-hardware-action: requested %s GiB exceeds maximum %s GiB\n' "$gib" "$maximum_gib" >&2
    exit 1
  }
  virsh_command=$(resolve_command virsh) || {
    printf '%s\n' 'desktop-hardware-action: virsh is required' >&2
    exit 1
  }
  if ! detail=$("$virsh_command" --connect "$VM_LIBVIRT_URI" setmem --domain "$name" --size "${gib}GiB" --live --config 2>&1); then
    printf 'desktop-hardware-action: memory resize failed: %s\n' "${detail//$'\n'/ }" >&2
    exit 1
  fi
}

persist_monitor_layout() {
  local mode=$1
  local monitor=${2:-}
  local state_dir=${MONITOR_LAYOUT_STATE_FILE%/*}
  local temp_file

  mkdir -p "$state_dir" || exit 1
  temp_file=$(mktemp "$state_dir/.monitor-layout.XXXXXX") || exit 1
  if ! printf '%s%s\n' "$mode" "${monitor:+ $monitor}" >"$temp_file" \
      || ! mv -f "$temp_file" "$MONITOR_LAYOUT_STATE_FILE"; then
    rm -f "$temp_file"
    exit 1
  fi
}

wait_for_monitor_enabled() {
  local hyprctl_command=$1
  local name=$2
  local expected=$3
  local raw_monitors
  local attempt

  for ((attempt = 0; attempt < 20; attempt++)); do
    raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null) || exit 1
    if [[ $expected == true ]]; then
      jq -e --arg name "$name" 'any(.[]; .name == $name and .disabled != true)' \
        <<<"$raw_monitors" >/dev/null 2>&1 && return
    else
      jq -e --arg name "$name" 'any(.[]; .name == $name and .disabled == true)' \
        <<<"$raw_monitors" >/dev/null 2>&1 && return
    fi
    sleep 0.05
  done

  exit 1
}

stage_desktop_monitors() {
  local hyprctl_command=$1

  run_command "$hyprctl_command" eval \
    'hl.monitor({output="DP-1", mode="1920x1080@60", position="10000x0", scale=1, disabled=false}); hl.monitor({output="DP-2", mode="1920x1080@60", position="11920x0", scale=1, disabled=false}); hl.monitor({output="HEADLESS-1", mode="2560x1440@60", position="13840x0", scale=1, disabled=false})'
  wait_for_monitor_enabled "$hyprctl_command" DP-1 true
  wait_for_monitor_enabled "$hyprctl_command" DP-2 true
  wait_for_monitor_enabled "$hyprctl_command" HEADLESS-1 true
}

move_workspace_to_monitor() {
  local hyprctl_command=$1
  local workspace=$2
  local monitor=$3
  local raw_workspaces
  local attempt

  for ((attempt = 0; attempt < 20; attempt++)); do
    if ! "$hyprctl_command" eval \
        "hl.dispatch(hl.dsp.workspace.move({workspace=${workspace}, monitor=\"${monitor}\"}))" \
        >/dev/null 2>&1; then
      sleep 0.05
      continue
    fi
    raw_workspaces=$("$hyprctl_command" -j workspaces 2>/dev/null) || exit 1
    jq -e --argjson workspace "$workspace" --arg monitor "$monitor" \
      'any(.[]; .id == $workspace and .monitor == $monitor)' \
      <<<"$raw_workspaces" >/dev/null 2>&1 && return
    sleep 0.05
  done

  exit 1
}

set_desktop_monitor_layout() {
  local mode=$1
  local hyprctl_command=$2
  local target_monitor=${3:-}
  local raw_monitors
  local raw_workspaces
  local active_workspace
  local monitor
  local workspace
  local -a other_monitors
  local -a workspace_ids

  if [[ $(hostname) != antoinews-linux ]]; then
    printf '%s\n' 'desktop-hardware-action: monitor layouts are only available on antoinews-linux' >&2
    exit 1
  fi

  raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null) || exit 1
  if ! jq -e 'any(.[]; .name == "HEADLESS-1")' <<<"$raw_monitors" >/dev/null 2>&1; then
    run_command "$hyprctl_command" output create headless
    raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null) || exit 1
  fi
  jq -e '
    any(.[]; .name == "DP-1")
    and any(.[]; .name == "DP-2")
    and any(.[]; .name == "HEADLESS-1")
  ' <<<"$raw_monitors" >/dev/null 2>&1 || exit 1
  if [[ $mode == single ]]; then
    case $target_monitor in
      DP-1|DP-2|HEADLESS-1) ;;
      *) exit 1 ;;
    esac
  fi

  active_workspace=$("$hyprctl_command" -j activeworkspace 2>/dev/null) || exit 1
  active_workspace=$(jq -er '.id | select(type == "number" and . > 0 and floor == .)' <<<"$active_workspace") || exit 1
  if [[ $mode == single ]]; then
    raw_workspaces=$("$hyprctl_command" -j workspaces 2>/dev/null) || exit 1
    mapfile -t workspace_ids < <(jq -r --argjson active "$active_workspace" '
      .[]
      | select(.id > 0 and (.id | floor) == .id)
      | select((.windows // 0) > 0 or .id == $active
          or .id == 2 or .id == 3 or .id == 4 or .id == 5
          or .id == 6 or .id == 8 or .id == 9 or .id == 10)
      | .id
    ' <<<"$raw_workspaces")
  fi
  stage_desktop_monitors "$hyprctl_command"

  case $mode in
    headless)
      run_command "$hyprctl_command" eval \
        'hl.monitor({output="DP-1", mode="1920x1080@60", position="0x0", scale=1, disabled=false}); hl.monitor({output="HEADLESS-1", mode="2560x1440@60", position="1920x0", scale=1, disabled=false}); hl.monitor({output="DP-2", mode="1920x1080@60", position="4480x0", scale=1, disabled=false})'
      run_command "$hyprctl_command" eval 'hl.monitor({output="DP-2", disabled=true})'
      wait_for_monitor_enabled "$hyprctl_command" DP-2 false
      for workspace in 2 4 5 8; do
        move_workspace_to_monitor "$hyprctl_command" "$workspace" HEADLESS-1
      done
      for workspace in 3 6 9 10; do
        move_workspace_to_monitor "$hyprctl_command" "$workspace" DP-1
      done
      run_command "$hyprctl_command" eval "hl.dispatch(hl.dsp.focus({workspace=${active_workspace}}))"
      ;;
    physical)
      run_command "$hyprctl_command" eval \
        'hl.monitor({output="DP-2", mode="1920x1080@60", position="0x0", scale=1, disabled=false}); hl.monitor({output="DP-1", mode="1920x1080@60", position="1920x0", scale=1, disabled=false}); hl.monitor({output="HEADLESS-1", mode="2560x1440@60", position="3840x0", scale=1, disabled=false})'
      run_command "$hyprctl_command" eval 'hl.monitor({output="HEADLESS-1", disabled=true})'
      wait_for_monitor_enabled "$hyprctl_command" HEADLESS-1 false
      for workspace in 2 4 5 8; do
        move_workspace_to_monitor "$hyprctl_command" "$workspace" DP-2
      done
      for workspace in 3 6 9 10; do
        move_workspace_to_monitor "$hyprctl_command" "$workspace" DP-1
      done
      run_command "$hyprctl_command" eval "hl.dispatch(hl.dsp.focus({workspace=${active_workspace}}))"
      ;;
    single)
      case $target_monitor in
        DP-1)
          run_command "$hyprctl_command" eval \
            'hl.monitor({output="DP-1", mode="1920x1080@60", position="0x0", scale=1, disabled=false}); hl.monitor({output="DP-2", mode="1920x1080@60", position="1920x0", scale=1, disabled=false}); hl.monitor({output="HEADLESS-1", mode="2560x1440@60", position="3840x0", scale=1, disabled=false})'
          ;;
        DP-2)
          run_command "$hyprctl_command" eval \
            'hl.monitor({output="DP-2", mode="1920x1080@60", position="0x0", scale=1, disabled=false}); hl.monitor({output="DP-1", mode="1920x1080@60", position="1920x0", scale=1, disabled=false}); hl.monitor({output="HEADLESS-1", mode="2560x1440@60", position="3840x0", scale=1, disabled=false})'
          ;;
        HEADLESS-1)
          run_command "$hyprctl_command" eval \
            'hl.monitor({output="HEADLESS-1", mode="2560x1440@60", position="0x0", scale=1, disabled=false}); hl.monitor({output="DP-1", mode="1920x1080@60", position="2560x0", scale=1, disabled=false}); hl.monitor({output="DP-2", mode="1920x1080@60", position="4480x0", scale=1, disabled=false})'
          ;;
      esac

      for workspace in "${workspace_ids[@]}"; do
        [[ $workspace =~ ^[1-9][0-9]*$ ]] || exit 1
        move_workspace_to_monitor "$hyprctl_command" "$workspace" "$target_monitor"
      done

      raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null) || exit 1
      mapfile -t other_monitors < <(jq -r --arg target "$target_monitor" \
        '.[] | select(.name != $target and .disabled != true) | .name' <<<"$raw_monitors")
      for monitor in "${other_monitors[@]}"; do
        [[ -n $monitor && $monitor != *[!A-Za-z0-9_.:-]* ]] || exit 1
        run_command "$hyprctl_command" eval "hl.monitor({output=\"${monitor}\", disabled=true})"
        wait_for_monitor_enabled "$hyprctl_command" "$monitor" false
      done
      for workspace in "${workspace_ids[@]}"; do
        move_workspace_to_monitor "$hyprctl_command" "$workspace" "$target_monitor"
      done
      run_command "$hyprctl_command" eval "hl.dispatch(hl.dsp.focus({workspace=${active_workspace}}))"
      ;;
    *)
      exit 1
      ;;
  esac

  raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null) || exit 1
  case $mode in
    headless)
      jq -e '
        any(.[]; .name == "DP-1" and .disabled != true)
        and any(.[]; .name == "DP-2" and .disabled == true)
        and any(.[]; .name == "HEADLESS-1" and .disabled != true)
      ' <<<"$raw_monitors" >/dev/null 2>&1 || exit 1
      ;;
    physical)
      jq -e '
        any(.[]; .name == "DP-1" and .disabled != true)
        and any(.[]; .name == "DP-2" and .disabled != true)
        and any(.[]; .name == "HEADLESS-1" and .disabled == true)
      ' <<<"$raw_monitors" >/dev/null 2>&1 || exit 1
      ;;
    single)
      jq -e --arg target "$target_monitor" '
        ([.[] | select(.disabled != true)] | length) == 1
        and any(.[]; .name == $target and .disabled != true)
      ' <<<"$raw_monitors" >/dev/null 2>&1 || exit 1
      ;;
  esac

  persist_monitor_layout "$mode" "$target_monitor"
}

set_monitor_state() {
  local action=$1
  local hyprctl_command
  local raw_monitors
  local internal
  local external
  local enabled
  local mirrored
  local mode
  local target_monitor=""

  hyprctl_command=$(resolve_command hyprctl) || exit 1
  raw_monitors=$("$hyprctl_command" -j monitors all 2>/dev/null) || exit 1

  case $action in
    restore-layout)
      mode=physical
      if [[ -r $MONITOR_LAYOUT_STATE_FILE ]]; then
        read -r mode target_monitor <"$MONITOR_LAYOUT_STATE_FILE" || exit 1
      fi
      case $mode in
        headless|physical) target_monitor="" ;;
        single)
          case $target_monitor in
            DP-1|DP-2|HEADLESS-1) ;;
            *) mode=physical; target_monitor="" ;;
          esac
          ;;
        *) mode=physical; target_monitor="" ;;
      esac
      set_desktop_monitor_layout "$mode" "$hyprctl_command" "$target_monitor"
      return
      ;;
  esac

  internal=$(jq -r '[.[] | select(type == "object") | select(.name | type == "string") | select(.name | test("^(eDP|LVDS|DSI)-"; "i")) | .name][0] // ""' <<<"$raw_monitors" 2>/dev/null) || exit 1
  [[ -n $internal && $internal != *[!A-Za-z0-9_.:-]* ]] || exit 1

  case $action in
    toggle-internal)
      enabled=$(jq -r --arg name "$internal" 'any(.[]; .name == $name and .disabled != true)' <<<"$raw_monitors" 2>/dev/null) || exit 1
      if [[ $enabled == true ]]; then
        run_command "$hyprctl_command" keyword monitor "${internal},disable"
      else
        run_command "$hyprctl_command" keyword monitor "${internal},preferred,auto,auto"
      fi
      ;;
    toggle-mirror)
      external=$(jq -r --arg internal "$internal" '
        [.[] | select(type == "object") | select(.name | type == "string") | select(.name != $internal)]
        | ([.[] | select(.mirrorOf == $internal) | .name][0]
          // [.[] | select(.disabled != true) | .name][0]
          // [.[].name][0]
          // "")
      ' <<<"$raw_monitors" 2>/dev/null) || exit 1
      [[ -n $external && $external != *[!A-Za-z0-9_.:-]* ]] || exit 1
      mirrored=$(jq -r --arg name "$external" --arg internal "$internal" 'any(.[]; .name == $name and .mirrorOf == $internal)' <<<"$raw_monitors" 2>/dev/null) || exit 1
      if [[ $mirrored == true ]]; then
        run_command "$hyprctl_command" keyword monitor "${external},preferred,auto,auto"
      else
        run_command "$hyprctl_command" keyword monitor "${external},preferred,auto,1,mirror,${internal}"
      fi
      ;;
    *)
      usage
      ;;
  esac
}

set_monitor_scale() {
  local monitor=$1
  local scale=$2
  local hyprctl_command
  local raw_monitors
  local layout_axis
  local eval_command=""
  local name x y
  local -a positions

  valid_target "$monitor" || usage
  valid_monitor_scale "$scale" || usage
  hyprctl_command=$(resolve_command hyprctl) || exit 1
  raw_monitors=$("$hyprctl_command" -j monitors 2>/dev/null) || exit 1
  jq -e --arg monitor "$monitor" 'any(.[]; .name == $monitor and .disabled != true)' \
    <<<"$raw_monitors" >/dev/null 2>&1 || exit 1
  jq -e --arg monitor "$monitor" --argjson scale "$scale" '
    .[] | select(.name == $monitor and .disabled != true)
    | (.width / $scale) as $logical_width
    | (.height / $scale) as $logical_height
    | (($logical_width - ($logical_width | round)) | fabs) < 0.001
      and (($logical_height - ($logical_height | round)) | fabs) < 0.001
  ' <<<"$raw_monitors" >/dev/null 2>&1 || exit 1

  layout_axis=$(jq -r '
    def rotated: .transform == 1 or .transform == 3 or .transform == 5 or .transform == 7;
    def logical_width: (if rotated then .height else .width end) / .scale;
    def logical_height: (if rotated then .width else .height end) / .scale;
    [.[] | select(.disabled != true and (.mirrorOf // "none") == "none")] as $monitors
    | ($monitors | sort_by(.x, .y)) as $horizontal
    | ($monitors | sort_by(.y, .x)) as $vertical
    | if ($monitors | length) < 2 then "single"
      elif all(range(1; $horizontal | length);
        (($horizontal[.].x - ($horizontal[. - 1].x + ($horizontal[. - 1] | logical_width))) | fabs) < 0.01)
        then "horizontal"
      elif all(range(1; $vertical | length);
        (($vertical[.].y - ($vertical[. - 1].y + ($vertical[. - 1] | logical_height))) | fabs) < 0.01)
        then "vertical"
      else "irregular"
      end
  ' <<<"$raw_monitors") || exit 1

  case $layout_axis in
    horizontal)
      mapfile -t positions < <(jq -r --arg target "$monitor" --argjson target_scale "$scale" '
        def rotated: .transform == 1 or .transform == 3 or .transform == 5 or .transform == 7;
        def effective_scale: if .name == $target then $target_scale else .scale end;
        def logical_width: (if rotated then .height else .width end) / effective_scale;
        def logical_height: (if rotated then .width else .height end) / effective_scale;
        [.[] | select(.disabled != true and (.mirrorOf // "none") == "none")] | sort_by(.x, .y)
        | (map(.x) | min) as $left
        | (map(.y) | min) as $top
        | (map(logical_height) | max) as $height
        | reduce .[] as $item ({ x: $left, rows: [] };
            .rows += [[$item.name, (.x | round), ($top + (($height - ($item | logical_height)) / 2) | round)]]
            | .x += ($item | logical_width))
        | .rows[] | @tsv
      ' <<<"$raw_monitors")
      ;;
    vertical)
      mapfile -t positions < <(jq -r --arg target "$monitor" --argjson target_scale "$scale" '
        def rotated: .transform == 1 or .transform == 3 or .transform == 5 or .transform == 7;
        def effective_scale: if .name == $target then $target_scale else .scale end;
        def logical_width: (if rotated then .height else .width end) / effective_scale;
        def logical_height: (if rotated then .width else .height end) / effective_scale;
        [.[] | select(.disabled != true and (.mirrorOf // "none") == "none")] | sort_by(.y, .x)
        | (map(.x) | min) as $left
        | (map(.y) | min) as $top
        | (map(logical_width) | max) as $width
        | reduce .[] as $item ({ y: $top, rows: [] };
            .rows += [[$item.name, ($left + (($width - ($item | logical_width)) / 2) | round), (.y | round)]]
            | .y += ($item | logical_height))
        | .rows[] | @tsv
      ' <<<"$raw_monitors")
      ;;
    single|irregular)
      run_command "$hyprctl_command" eval "hl.monitor({output=\"${monitor}\", scale=${scale}})"
      return
      ;;
    *) exit 1 ;;
  esac

  for position in "${positions[@]}"; do
    IFS=$'\t' read -r name x y <<<"$position"
    valid_target "$name" || exit 1
    [[ $x =~ ^[0-9]+$ && $y =~ ^[0-9]+$ ]] || exit 1
    if [[ $name == "$monitor" ]]; then
      eval_command+="hl.monitor({output=\"${name}\", position=\"${x}x${y}\", scale=${scale}}); "
    else
      eval_command+="hl.monitor({output=\"${name}\", position=\"${x}x${y}\"}); "
    fi
  done
  [[ -n $eval_command ]] || exit 1
  run_command "$hyprctl_command" eval "$eval_command"
}

(( $# >= 2 )) || usage

domain=$1
action=$2

case $domain in
  power)
    case $action in
      set-profile)
        (($# == 3)) || usage
        valid_profile "$3" || usage
        powerprofilesctl_command=$(resolve_command powerprofilesctl) || exit 1
        run_command "$powerprofilesctl_command" set "$3"
        ;;
      *)
        usage
        ;;
    esac
    ;;
  monitor)
    case $action in
      set-display-brightness)
        (($# == 3)) || usage
        valid_percent "$3" || usage
        display_helper=$(resolve_helper brightness-display) || exit 1
        run_command "$display_helper" "${3}%"
        ;;
      set-keyboard-brightness)
        (($# == 3)) || usage
        case $3 in
          up|down|cycle) ;;
          *) usage ;;
        esac
        keyboard_helper=$(resolve_helper brightness-keyboard) || exit 1
        run_command "$keyboard_helper" "$3"
        ;;
      set-scale)
        (($# == 4)) || usage
        command -v jq >/dev/null 2>&1 || exit 1
        set_monitor_scale "$3" "$4"
        ;;
      set-layout)
        case ${3:-} in
          headless|physical)
            (($# == 3)) || usage
            ;;
          single)
            (($# == 4)) || usage
            ;;
          *) usage ;;
        esac
        command -v jq >/dev/null 2>&1 || exit 1
        hyprctl_command=$(resolve_command hyprctl) || exit 1
        set_desktop_monitor_layout "$3" "$hyprctl_command" "${4:-}"
        ;;
      restore-layout|toggle-internal|toggle-mirror)
        (($# == 2)) || usage
        command -v jq >/dev/null 2>&1 || exit 1
        set_monitor_state "$action"
        ;;
      *)
        usage
        ;;
    esac
    ;;
  tailscale)
    case $action in
      up|down|clear-exit-node|logout)
        (($# == 2)) || usage
        tailscale_command=$(resolve_command tailscale) || exit 1
        case $action in
          up) run_command "$tailscale_command" up ;;
          down) run_command "$tailscale_command" down ;;
          clear-exit-node) run_command "$tailscale_command" set --exit-node= ;;
          logout) run_command "$tailscale_command" logout ;;
        esac
        ;;
      set-exit-node)
        (($# == 3)) || usage
        valid_target "$3" || usage
        tailscale_command=$(resolve_command tailscale) || exit 1
        run_command "$tailscale_command" set "--exit-node=$3"
        ;;
      switch-account)
        (($# == 3)) || usage
        valid_target "$3" || usage
        tailscale_command=$(resolve_command tailscale) || exit 1
        run_command "$tailscale_command" switch "$3"
        ;;
      *)
        usage
        ;;
    esac
    ;;
  vm)
    case $action in
      set-memory)
        (($# == 3)) || usage
        set_vm_memory "$3"
        ;;
      *)
        usage
        ;;
    esac
    ;;
  *)
    usage
    ;;
esac
