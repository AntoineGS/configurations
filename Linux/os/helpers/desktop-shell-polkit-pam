#!/usr/bin/env bash
set -Eeuo pipefail

readonly PAM_ROOT_DEFAULT="/etc/pam.d"
readonly PAM_VENDOR_ROOT_DEFAULT="/usr/lib/pam.d"
readonly MAX_DEPTH=16
readonly MAX_SERVICE_LENGTH=128
readonly MAX_FILE_BYTES=1048576
readonly MAX_UNIQUE_FILES=64
readonly MAX_TOTAL_BYTES=4194304
readonly MAX_TOTAL_LINES=16384

fail() {
  printf 'desktop-shell-polkit-pam: %s\n' "$1" >&2
  exit 1
}

validate_service_name() {
  local service=$1
  [[ ${#service} -gt 0 && ${#service} -le $MAX_SERVICE_LENGTH ]] || \
    fail 'invalid PAM service name length'
  [[ $service =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] || \
    fail "invalid PAM service name: $service"
  [[ $service != . && $service != .. ]] || fail "invalid PAM service name: $service"
}

path_under_root() {
  local candidate=$1
  local root
  for root in "${pam_roots[@]}"; do
    if [[ $root == / ]]; then
      [[ $candidate == /* ]] && return 0
      continue
    fi
    [[ $candidate == "$root" || $candidate == "$root/"* ]] && return 0
  done
  return 1
}

# PAM reads /etc/pam.d/<service> first and falls back to the vendor directory.
service_path() {
  local service=$1
  local root
  for root in "${pam_roots[@]}"; do
    if [[ -e $root/$service ]]; then
      printf '%s' "$root/$service"
      return
    fi
  done
  printf '%s' "${pam_roots[0]}/$service"
}

resolve_existing_path() {
  local requested=$1
  local description=$2
  local resolved

  [[ -n $requested && $requested != *$'\n'* && $requested != *$'\r'* ]] || \
    fail "invalid $description path"
  resolved=$(realpath -e -- "$requested" 2>/dev/null) || \
    fail "unable to resolve $description: $requested"
  path_under_root "$resolved" || fail "$description escapes PAM root: $requested"
  [[ -f $resolved && -r $resolved ]] || fail "$description is not readable: $requested"
  printf '%s' "$resolved"
}

resolve_service_file() {
  local service=$1
  validate_service_name "$service"
  resolve_existing_path "$(service_path "$service")" "PAM service"
}

resolve_at_include_file() {
  local target=$1
  local requested

  [[ -n $target && ${#target} -le $MAX_SERVICE_LENGTH ]] || \
    fail 'invalid @include target length'
  [[ $target != *$'\n'* && $target != *$'\r'* ]] || fail 'invalid @include target'
  if [[ $target == /* ]]; then
    [[ $target != *"/../"* && $target != ../* && $target != */.. && $target != .. ]] || \
      fail "invalid @include target: $target"
    path_under_root "$target" || fail "@include escapes PAM root: $target"
    requested=$target
  else
    validate_service_name "$target"
    requested=$(service_path "$target")
  fi
  resolve_existing_path "$requested" "PAM include"
}

check_file_size() {
  local path=$1
  local bytes

  bytes=$(wc -c <"$path" 2>/dev/null) || fail "unable to inspect PAM file: $path"
  bytes=${bytes//[[:space:]]/}
  [[ $bytes =~ ^[0-9]+$ ]] || fail "invalid PAM file size: $path"
  ((bytes <= MAX_FILE_BYTES)) || fail "PAM file is too large: $path"
  printf '%s\n' "$bytes"
}

declare -A active_files=()
declare -A completed_files=()
fingerprint_found=false
total_unique_files=0
total_bytes=0
total_lines=0

reserve_file_budget() {
  local bytes=$1
  local lines=$2

  ((total_unique_files < MAX_UNIQUE_FILES)) || fail 'PAM unique file limit exceeded'
  ((total_bytes + bytes <= MAX_TOTAL_BYTES)) || fail 'PAM aggregate byte limit exceeded'
  ((total_lines + lines <= MAX_TOTAL_LINES)) || fail 'PAM aggregate line limit exceeded'
  total_unique_files=$((total_unique_files + 1))
  total_bytes=$((total_bytes + bytes))
  total_lines=$((total_lines + lines))
}

parse_file() {
  local requested=$1
  local depth=$2
  local resolved
  local line
  local bytes
  local -a lines=()

  ((depth <= MAX_DEPTH)) || fail 'PAM include depth exceeded'
  resolved=$(resolve_existing_path "$requested" "PAM file")
  [[ ${active_files[$resolved]:-0} == 0 ]] || fail "PAM include cycle: $resolved"
  [[ ${completed_files[$resolved]:-0} == 0 ]] || return 0
  active_files["$resolved"]=1
  bytes=$(check_file_size "$resolved")
  if ! mapfile -t lines <"$resolved"; then
    fail "unable to read PAM file: $resolved"
  fi
  reserve_file_budget "$bytes" "${#lines[@]}"
  for line in "${lines[@]}"; do
    parse_line "$line" "$depth"
  done
  active_files["$resolved"]=0
  completed_files["$resolved"]=1
}

parse_line() {
  local raw=$1
  local depth=$2
  local line
  local control
  local module
  local module_name
  local remainder
  local service
  local include_file

  line=${raw%%#*}
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  [[ -n $line ]] || return 0

  if [[ $line =~ ^@include[[:space:]]+([^[:space:]]+)[[:space:]]*$ ]]; then
    include_file=$(resolve_at_include_file "${BASH_REMATCH[1]}")
    parse_file "$include_file" "$((depth + 1))"
    return 0
  fi
  [[ $line == @include* ]] && fail "malformed @include entry: $line"

  [[ $line =~ ^auth[[:space:]] ]] || return 0
  [[ $line =~ ^auth[[:space:]]+(\[[^]]+\]|[^[:space:]]+)[[:space:]]+([^[:space:]]+)([[:space:]]+.*)?$ ]] || \
    fail "malformed auth entry: $line"

  control=${BASH_REMATCH[1]}
  module=${BASH_REMATCH[2]}
  remainder=${BASH_REMATCH[3]-}
  if [[ $control == include || $control == substack ]]; then
    [[ -z $remainder ]] || \
      fail "malformed auth $control entry: $line"
    service=$module
    include_file=$(resolve_service_file "$service")
    parse_file "$include_file" "$((depth + 1))"
    return 0
  fi

  module_name=${module##*/}
  if [[ $module_name == pam_fprintd.so ]]; then
    fingerprint_found=true
  fi
}

pam_root_input=${DESKTOP_SHELL_PAM_DIR:-$PAM_ROOT_DEFAULT}
[[ $pam_root_input == /* ]] || fail 'PAM root must be an absolute path'
[[ $pam_root_input != *$'\n'* && $pam_root_input != *$'\r'* ]] || fail 'PAM root contains a line break'
[[ -d $pam_root_input && -r $pam_root_input ]] || fail "PAM root is not readable: $pam_root_input"
pam_root=$(realpath -e -- "$pam_root_input" 2>/dev/null) || fail "unable to resolve PAM root: $pam_root_input"
[[ -d $pam_root ]] || fail "PAM root is not a directory: $pam_root"
pam_roots=("$pam_root")

# An explicit PAM root (tests) only gets a vendor root when one is also given.
if [[ -n ${DESKTOP_SHELL_PAM_DIR:-} ]]; then
  pam_vendor_input=${DESKTOP_SHELL_PAM_VENDOR_DIR:-}
else
  pam_vendor_input=${DESKTOP_SHELL_PAM_VENDOR_DIR:-$PAM_VENDOR_ROOT_DEFAULT}
fi
if [[ -n $pam_vendor_input && -d $pam_vendor_input && -r $pam_vendor_input ]]; then
  [[ $pam_vendor_input == /* ]] || fail 'PAM vendor root must be an absolute path'
  [[ $pam_vendor_input != *$'\n'* && $pam_vendor_input != *$'\r'* ]] || fail 'PAM vendor root contains a line break'
  pam_vendor_root=$(realpath -e -- "$pam_vendor_input" 2>/dev/null) || \
    fail "unable to resolve PAM vendor root: $pam_vendor_input"
  [[ $pam_vendor_root == "$pam_root" ]] || pam_roots+=("$pam_vendor_root")
fi

parse_file "$(service_path polkit-1)" 0
if [[ $fingerprint_found == true ]]; then
  printf '%s\n' true
else
  printf '%s\n' false
fi
