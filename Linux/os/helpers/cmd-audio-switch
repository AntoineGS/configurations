#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C

command -v jq >/dev/null 2>&1 || {
  printf 'cmd-audio-switch: jq is required\n' >&2
  exit 1
}

deliver_osd() {
  local payload=$1
  local response
  local status

  if response=$(desktop-shell call desktop.osd show "$payload"); then
    if [[ $response == ok ]]; then
      return 0
    fi
    printf 'cmd-audio-switch: OSD returned an invalid response\n' >&2
    return 1
  else
    status=$?
    if (( status == 3 )); then
      return 0
    fi
    printf 'cmd-audio-switch: OSD delivery failed\n' >&2
    return "$status"
  fi
}

read_sinks() {
  local sinks_json

  if ! sinks_json=$(pactl -f json list sinks 2>/dev/null); then
    printf 'cmd-audio-switch: failed to list audio devices\n' >&2
    return 1
  fi
  if ! sinks=$(jq -c '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]' <<<"$sinks_json"); then
    printf 'cmd-audio-switch: malformed audio device list\n' >&2
    return 1
  fi
  sinks_count=$(jq -er 'length' <<<"$sinks")
}

description_missing() {
  case "$1" in
    ''|null|'(null)') return 0 ;;
    *) return 1 ;;
  esac
}

lookup_wpctl_description() {
  local id=$1
  local status_text

  [[ $id =~ ^[0-9]+$ ]] || return 0
  if ! status_text=$(wpctl status 2>/dev/null); then
    return 0
  fi
  awk -v id="$id" \
    '$0 ~ ("(^|[[:space:]])" id "\\.") {
       line = $0
       sub(/^.*[0-9]+\.[[:space:]]+/, "", line)
       sub(/[[:space:]]+\[.*$/, "", line)
       print line
       exit
     }' <<<"$status_text"
}

read_sink_description() {
  local sink=$1
  local description
  local device_id
  local sink_id

  description=$(jq -r '.description // ""' <<<"$sink")
  if ! description_missing "$description"; then
    printf '%s\n' "$description"
    return 0
  fi

  device_id=$(jq -r '.properties["device.id"] // ""' <<<"$sink")
  description=$(lookup_wpctl_description "$device_id")
  if [[ -z $description ]]; then
    sink_id=$(jq -r '.properties["object.id"] // ""' <<<"$sink")
    description=$(lookup_wpctl_description "$sink_id")
  fi
  printf '%s\n' "$description"
}

read_sink_details() {
  local sink=$1

  next_sink_name=$(jq -er '.name | strings' <<<"$sink")
  next_sink_description=$(read_sink_description "$sink")
  next_sink_volume=$(jq -er '.volume | to_entries[0].value.value_percent | tostring | sub("%$"; "") | tonumber' <<<"$sink")
  next_sink_is_muted=$(jq -r '.mute == true' <<<"$sink")
}

select_icon_state() {
  if [[ $next_sink_is_muted == true ]] || (( next_sink_volume == 0 )); then
    icon_state=muted
  elif (( next_sink_volume <= 33 )); then
    icon_state=low
  elif (( next_sink_volume <= 66 )); then
    icon_state=medium
  else
    icon_state=high
  fi
}

read_sinks

if (( sinks_count == 0 )); then
  payload=$(jq -cn \
    --arg icon volume-muted \
    --arg message 'No audio devices found' \
    '{icon: $icon, message: $message}')
  deliver_osd "$payload" || true
  exit 1
fi

current_sink_name=$(pactl get-default-sink)
current_sink_index=$(jq -r --arg name "$current_sink_name" 'map(.name) | index($name)' <<<"$sinks")
if [[ $current_sink_index != null ]]; then
  next_sink_index=$(((current_sink_index + 1) % sinks_count))
else
  next_sink_index=0
fi

next_sink=$(jq -c --argjson index "$next_sink_index" '.[$index]' <<<"$sinks")
read_sink_details "$next_sink"
select_icon_state

if [[ $next_sink_name != "$current_sink_name" ]]; then
  pactl set-default-sink "$next_sink_name"
  current_sink_name=$(pactl get-default-sink)
  if [[ $current_sink_name != "$next_sink_name" ]]; then
    printf 'cmd-audio-switch: default sink readback did not match requested sink\n' >&2
    exit 1
  fi
  read_sinks
  if ! next_sink=$(jq -c --arg name "$current_sink_name" \
    '[.[] | select(.name == $name)] | if length == 1 then .[0] else error("selected sink is unavailable") end' \
    <<<"$sinks"); then
    printf 'cmd-audio-switch: selected sink disappeared after mutation\n' >&2
    exit 1
  fi
  read_sink_details "$next_sink"
  select_icon_state
fi

payload=$(jq -cn \
  --arg icon "volume-$icon_state" \
  --arg message "$next_sink_description" \
  '{icon: $icon, message: $message}')
deliver_osd "$payload"
