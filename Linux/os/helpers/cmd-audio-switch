#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C

command -v jq >/dev/null 2>&1 || {
  printf 'cmd-audio-switch: jq is required\n' >&2
  exit 1
}

deliver_osd() {
  local payload=$1
  local response
  local status

  if response=$(desktop-shell call desktop.osd show "$payload"); then
    if [[ $response == ok ]]; then
      return 0
    fi
    printf 'cmd-audio-switch: OSD returned an invalid response\n' >&2
    return 1
  else
    status=$?
    if (( status == 3 )); then
      return 0
    fi
    printf 'cmd-audio-switch: OSD delivery failed\n' >&2
    return "$status"
  fi
}

if ! sinks_json=$(pactl -f json list sinks 2>/dev/null); then
  printf 'cmd-audio-switch: failed to list audio devices\n' >&2
  exit 1
fi
if ! sinks=$(jq -c '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]' <<<"$sinks_json"); then
  printf 'cmd-audio-switch: malformed audio device list\n' >&2
  exit 1
fi
sinks_count=$(jq -er 'length' <<<"$sinks")

if (( sinks_count == 0 )); then
  payload=$(jq -cn \
    --arg icon volume-muted \
    --arg message 'No audio devices found' \
    '{icon: $icon, message: $message}')
  deliver_osd "$payload" || true
  exit 1
fi

current_sink_name=$(pactl get-default-sink)
current_sink_index=$(jq -r --arg name "$current_sink_name" 'map(.name) | index($name)' <<<"$sinks")
if [[ $current_sink_index != null ]]; then
  next_sink_index=$(((current_sink_index + 1) % sinks_count))
else
  next_sink_index=0
fi

next_sink=$(jq -c --argjson index "$next_sink_index" '.[$index]' <<<"$sinks")
next_sink_name=$(jq -er '.name | strings' <<<"$next_sink")
next_sink_description=$(jq -r '.description // ""' <<<"$next_sink")
if [[ -z $next_sink_description ]]; then
  device_id=$(jq -r '.properties["device.id"] // ""' <<<"$next_sink")
  if [[ -n $device_id ]]; then
    if status_text=$(wpctl status 2>/dev/null); then
      next_sink_description=$(awk -v id="$device_id" \
        'index($0, id ".") { sub(/^.*[0-9]+\.[[:space:]]+/, ""); sub(/[[:space:]]+\[.*$/, ""); print; exit }' \
        <<<"$status_text")
    fi
  fi
  if [[ -z $next_sink_description ]]; then
    sink_id=$(jq -r '.properties["object.id"] // ""' <<<"$next_sink")
    if [[ -n $sink_id ]]; then
      if status_text=$(wpctl status 2>/dev/null); then
        next_sink_description=$(awk -v id="$sink_id" \
          'index($0, id ".") { sub(/^.*[0-9]+\.[[:space:]]+/, ""); sub(/[[:space:]]+\[.*$/, ""); print; exit }' \
          <<<"$status_text")
      fi
    fi
  fi
fi

next_sink_volume=$(jq -er '.volume | to_entries[0].value.value_percent | tostring | sub("%$"; "") | tonumber' <<<"$next_sink")
next_sink_is_muted=$(jq -r '.mute == true' <<<"$next_sink")
if [[ $next_sink_is_muted == true ]] || (( next_sink_volume == 0 )); then
  icon_state=muted
elif (( next_sink_volume <= 33 )); then
  icon_state=low
elif (( next_sink_volume <= 66 )); then
  icon_state=medium
else
  icon_state=high
fi

if [[ $next_sink_name != "$current_sink_name" ]]; then
  pactl set-default-sink "$next_sink_name"
fi

payload=$(jq -cn \
  --arg icon "volume-$icon_state" \
  --arg message "$next_sink_description" \
  '{icon: $icon, message: $message}')
deliver_osd "$payload"
