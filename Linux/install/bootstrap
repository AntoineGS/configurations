#!/usr/bin/env bash
set -Eeuo pipefail

readonly EXIT_ERROR=1
readonly EXIT_USAGE=2
readonly EXIT_DECLINED=3
readonly EXIT_INCOMPLETE_PREVIEW=4
readonly SNAPPER_INITIALIZER=/usr/local/libexec/antoinews-linux/snapper-initialize
readonly SNAPPER_CONFIG_DIRECTORY=/etc/snapper/configs
readonly SNAPPER_REGISTRATION_DIRECTORY=/etc/conf.d
readonly SNAPPER_RECOVERY_DIRECTORY=/var/lib/configurations/snapper-bootstrap
readonly SNAPPER_JOURNAL_FILE=/var/lib/configurations/snapper-bootstrap/state
readonly SNAPPER_MANIFEST_FILE=/var/lib/configurations/snapper-bootstrap/manifest
readonly SNAPPER_BACKUP_DIRECTORY=/var/lib/configurations/snapper-bootstrap/backups
readonly SNAPPER_FIXED_PATH=/usr/bin:/bin
readonly SNAPPER_PRODUCTION_LIFECYCLE_LOCK=/run/lock/antoinews-linux-snapper.lock
SNAPPER_LIFECYCLE_LOCK="$SNAPPER_PRODUCTION_LIFECYCLE_LOCK"
DRY_RUN=false
PRIVILEGED_OPERATIONS_CONFIRMED=false
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PREREQUISITE_TEMP_DIR=""
SNAPPER_ROLLBACK_DIR=""
SNAPPER_STAGED_TEMP=""
SNAPPER_DEPLOYMENT_ACTIVE=false
SNAPPER_CLEANUP_STARTED=false
SNAPPER_JOURNAL_PHASE=""
SNAPPER_HAS_GETFACL=false
SNAPPER_HAS_GETFATTR=false
SNAPPER_LEGACY_CONFIG_LINK=false
SNAPPER_LEGACY_REGISTRATION_LINK=false
SNAPPER_LIFECYCLE_LOCK_FD=""
SNAPPER_LIFECYCLE_LOCK_HELD=false
HOSTNAME_PROFILE=""
SNAPPER_CAPABILITY=""

bootstrap_exit() {
  local -r exit_status="$?"
  local cleanup_status=0

  if [[ "$SNAPPER_DEPLOYMENT_ACTIVE" == true && "$SNAPPER_CLEANUP_STARTED" == false ]]; then
    if ! rollback_snapper_deployment; then
      printf 'bootstrap: Snapper rollback failed during exit\n' >&2
      cleanup_status=1
    fi
  fi
  if ! cleanup_prerequisite_temp; then
    printf 'bootstrap: prerequisite temporary directory cleanup failed\n' >&2
    cleanup_status=1
  fi
  if ! release_snapper_lifecycle_lock; then
    printf 'bootstrap: Snapper lifecycle lock release failed\n' >&2
    cleanup_status=1
  fi
  if (( cleanup_status != 0 )); then
    return 1
  fi
  return "$exit_status"
}

trap bootstrap_exit EXIT

usage() {
  printf 'Usage: %s [--dry-run] [--repo PATH] [--help]\n' "${BASH_SOURCE[0]##*/}"
  printf '\n'
  printf 'Run the Arch bootstrap preflight, install prerequisites, and apply tidydots phases.\n'
  printf '\n'
  printf 'Options:\n'
  printf '  --dry-run    Run all read-only checks and display plans without applying changes.\n'
  printf '  --repo PATH  Use PATH as the repository checkout.\n'
  printf '  --help       Show this help text.\n'
  printf '  Exit %s means a prerequisite or tidydots phase was declined.\n' "$EXIT_DECLINED"
  printf '  Exit %s means the dry-run was incomplete because tidydots phases were skipped.\n' "$EXIT_INCOMPLETE_PREVIEW"
}

die() {
  printf 'bootstrap: %s\n' "$1" >&2
  exit "$EXIT_ERROR"
}

usage_error() {
  printf 'bootstrap: %s\n' "$1" >&2
  usage >&2
  exit "$EXIT_USAGE"
}

command_available() {
  command -v "$1" >/dev/null 2>&1
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=true
        shift
        ;;
      --repo)
        [[ $# -ge 2 && "$2" != --* ]] || usage_error 'missing value for --repo'
        REPO_ROOT="$2"
        shift 2
        ;;
      --help)
        usage
        exit 0
        ;;
      *)
        usage_error "unknown option: $1"
        ;;
    esac
  done
}

check_user() {
  [[ "$EUID" -ne 0 ]] || die 'must not run as root'
}

check_arch() {
  local -r os_release=/etc/os-release
  local line=""
  local os_id=""

  [[ -r "$os_release" ]] || die "cannot read os-release: $os_release"

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == ID=* ]]; then
      os_id="${line#ID=}"
      os_id="${os_id#\"}"
      os_id="${os_id%\"}"
      break
    fi
  done <"$os_release"

  [[ "$os_id" == arch ]] || die "unsupported operating system: require ID=arch"
}

resolve_hostname() {
  local static_hostname
  local kernel_hostname

  command_available hostnamectl || die 'missing required command: hostnamectl'
  command_available hostname || die 'missing required command: hostname'
  static_hostname="$(hostnamectl --static)" || die 'could not resolve the static hostname'
  kernel_hostname="$(hostname)" || die 'could not resolve the kernel hostname'
  [[ -n "$static_hostname" ]] || die 'could not resolve the static hostname'
  [[ -n "$kernel_hostname" ]] || die 'could not resolve the kernel hostname'
  [[ "$static_hostname" == "$kernel_hostname" ]] ||
    die "hostname mismatch: hostnamectl --static='$static_hostname', hostname='$kernel_hostname'"

  printf '%s\n' "$static_hostname"
}

check_hostname() {
  HOSTNAME_PROFILE="$(resolve_hostname)"

  case "$HOSTNAME_PROFILE" in
    DESKTOP-E07VTRN|omarchbook|server|antoinews-linux)
      ;;
    *)
      die "unknown hostname: $HOSTNAME_PROFILE"
      ;;
  esac

  case "$HOSTNAME_PROFILE" in
    antoinews-linux) SNAPPER_CAPABILITY=custom-archinstall-layout ;;
    DESKTOP-E07VTRN) SNAPPER_CAPABILITY=tidydots-config ;;
    omarchbook) SNAPPER_CAPABILITY=snapshots-disabled ;;
    server) SNAPPER_CAPABILITY=unmanaged-layout ;;
  esac
}

check_commands() {
  local command_name

  for command_name in bash curl env find flock git hostname hostnamectl pacman sudo systemctl; do
    if ! command_available "$command_name"; then
      die "missing required command: $command_name"
    fi
  done
}

check_repository() {
  [[ -d "$REPO_ROOT" ]] || die "repository directory does not exist: $REPO_ROOT"
  REPO_ROOT="$(cd -- "$REPO_ROOT" 2>/dev/null && pwd)" || die "repository path is not accessible: $REPO_ROOT"
  [[ "$REPO_ROOT" != *'|'* && "$REPO_ROOT" != *$'\n'* ]] ||
    die 'repository path cannot contain manifest delimiters'
  [[ -f "$REPO_ROOT/tidydots.yaml" ]] || die "missing repository file: $REPO_ROOT/tidydots.yaml"
}

check_network() {
  curl --fail --silent --show-error --head https://aur.archlinux.org/ \
    || die 'network check failed: https://aur.archlinux.org/'
}

preflight() {
  check_user
  check_arch
  check_hostname
  check_commands
  check_repository
  check_network
  if [[ "$DRY_RUN" == true ]]; then
    printf 'bootstrap preflight passed (dry-run): %s\n' "$REPO_ROOT"
  else
    printf 'bootstrap preflight passed (read-only): %s\n' "$REPO_ROOT"
  fi
}

confirm() {
  local response=""

  printf 'Apply prerequisite installation plan? Type yes to continue: '
  if ! IFS= read -r response; then
    response=""
  fi

  if [[ "$response" != yes ]]; then
    printf 'bootstrap: prerequisite installation declined\n' >&2
    exit "$EXIT_DECLINED"
  fi
}

confirm_privileged_operations() {
  local response=""

  [[ "$DRY_RUN" == true || "$PRIVILEGED_OPERATIONS_CONFIRMED" == true ]] && return 0

  printf 'Apply privileged bootstrap operations? Type yes to continue: '
  if ! IFS= read -r response; then
    response=""
  fi

  if [[ "$response" != yes ]]; then
    printf 'bootstrap: privileged bootstrap operations declined\n' >&2
    exit "$EXIT_DECLINED"
  fi

  if ! sudo -v; then
    die 'could not validate sudo credentials'
  fi
  PRIVILEGED_OPERATIONS_CONFIRMED=true
}

cleanup_prerequisite_temp() {
  if [[ -n "$PREREQUISITE_TEMP_DIR" ]]; then
    rm -rf -- "$PREREQUISITE_TEMP_DIR"
  fi
}

install_yay_bin() {
  PREREQUISITE_TEMP_DIR="$(mktemp -d)" || die 'failed to create temporary yay-bin build directory'
  [[ -d "$PREREQUISITE_TEMP_DIR" ]] || die 'failed to create temporary yay-bin build directory'
  trap cleanup_prerequisite_temp EXIT

  if ! git clone https://aur.archlinux.org/yay-bin.git "$PREREQUISITE_TEMP_DIR/yay-bin"; then
    die 'failed to clone yay-bin'
  fi

  if ! (cd -- "$PREREQUISITE_TEMP_DIR/yay-bin" && makepkg -si --needed --noconfirm); then
    die 'failed to build yay-bin'
  fi
}

install_prerequisites() {
  local need_yay=false
  local need_tidydots=false

  command_available yay || need_yay=true
  command_available tidydots || need_tidydots=true

  if [[ "$need_yay" == false && "$need_tidydots" == false ]]; then
    printf 'bootstrap prerequisites already installed\n'
    return 0
  fi

  printf 'Prerequisite installation plan:\n'
  if [[ "$need_yay" == true ]]; then
    printf '  mktemp -d\n'
    printf '  git clone https://aur.archlinux.org/yay-bin.git <temporary-directory>/yay-bin\n'
    printf '  (cd <temporary-directory>/yay-bin && makepkg -si --needed --noconfirm)\n'
  fi
  if [[ "$need_tidydots" == true ]]; then
    printf '  yay -S --needed --noconfirm tidydots-git\n'
  fi

  if [[ "$DRY_RUN" == true ]]; then
    return 0
  fi

  confirm
  confirm_privileged_operations

  if [[ "$need_yay" == true ]]; then
    install_yay_bin
  fi

  if [[ "$need_tidydots" == true ]]; then
    if ! yay -S --needed --noconfirm tidydots-git; then
      die 'failed to install tidydots-git'
    fi
  fi
}

confirm_tidydots() {
  local -r action="$1"
  local -r scope_label="${2:-}"
  local response=""

  if [[ -n "$scope_label" ]]; then
    printf 'Apply tidydots %s %s? Type yes to continue: ' "$action" "$scope_label"
  else
    printf 'Apply tidydots %s? Type yes to continue: ' "$action"
  fi
  if ! IFS= read -r response; then
    response=""
  fi

  if [[ "$response" != yes ]]; then
    if [[ -n "$scope_label" ]]; then
      printf 'bootstrap: tidydots %s %s declined\n' "$action" "$scope_label" >&2
    else
      printf 'bootstrap: tidydots %s declined\n' "$action" >&2
    fi
    exit "$EXIT_DECLINED"
  fi
}

print_snapper_deployment_plan() {
  printf 'Snapper deployment plan:\n'
  printf '  custom rollback-assisted per-file deployment with persistent recovery state:\n'
  printf '    /etc/snapper/configs/root\n'
  printf '    /etc/snapper/configs/home\n'
  printf '    /etc/conf.d/snapper\n'
  printf '    %s\n' "$SNAPPER_INITIALIZER"
  printf '  preserve managed legacy Snapper directory links in root-owned recovery state\n'
  printf '  recovery state survives reboot after sync; filesystem power-loss durability still depends on the filesystem\n'
}

confirm_snapper_deployment() {
  local response=""

  printf 'Apply custom Snapper deployment? Type yes to continue: '
  if ! IFS= read -r response; then
    response=""
  fi

  if [[ "$response" != yes ]]; then
    printf 'bootstrap: custom Snapper deployment declined\n' >&2
    exit "$EXIT_DECLINED"
  fi
}

run_tidydots_phase() {
  local -r action="$1"
  local -a scope=("${@:2}")
  local -r scope_label="${scope[*]:-}"

  if ! (cd -- "$REPO_ROOT" && tidydots --dir "$REPO_ROOT" "$action" "${scope[@]}" -n); then
    if [[ -n "$scope_label" ]]; then
      die "failed to plan tidydots $action $scope_label"
    fi
    die "failed to plan tidydots $action"
  fi

  [[ "$DRY_RUN" == true ]] && return 0
  confirm_tidydots "$action" "$scope_label"

  if ! (cd -- "$REPO_ROOT" && tidydots --dir "$REPO_ROOT" "$action" "${scope[@]}"); then
    if [[ -n "$scope_label" ]]; then
      die "failed to apply tidydots $action $scope_label"
    fi
    die "failed to apply tidydots $action"
  fi
}

root_exec() {
  sudo -n -- "$@"
}

root_capture() {
  sudo -n -- "$@"
}

root_test() {
  root_exec test "$@"
}

validate_snapper_topology() {
  local -r initializer_source="$REPO_ROOT/Linux/Snapper/snapper-initialize"

  [[ "$SNAPPER_CAPABILITY" == custom-archinstall-layout ]] || return 0
  [[ "$DRY_RUN" == true ]] && return 0
  [[ -f "$initializer_source" && ! -L "$initializer_source" && -x "$initializer_source" ]] ||
    die "Snapper topology validator is not a regular executable: $initializer_source"

  if ! root_exec env -i "PATH=$SNAPPER_FIXED_PATH" "$initializer_source" --validate-topology; then
    die 'Snapper topology validation failed; require Btrfs /@ and /@home on the same filesystem'
  fi
}

root_stat() {
  local -r format="$1"
  local -r path="$2"

  root_capture stat -c "$format" -- "$path"
}

ensure_snapper_lifecycle_lock_file() {
  local lock_directory="${SNAPPER_LIFECYCLE_LOCK%/*}"
  local mode

  validate_root_directory "$lock_directory"
  root_test ! -L "$SNAPPER_LIFECYCLE_LOCK" || die "Snapper lifecycle lock must not be a symlink: $SNAPPER_LIFECYCLE_LOCK"
  if ! root_test -e "$SNAPPER_LIFECYCLE_LOCK"; then
    root_exec touch -- "$SNAPPER_LIFECYCLE_LOCK" || die "could not create Snapper lifecycle lock: $SNAPPER_LIFECYCLE_LOCK"
  fi
  root_test -f "$SNAPPER_LIFECYCLE_LOCK" || die "Snapper lifecycle lock is not a regular file: $SNAPPER_LIFECYCLE_LOCK"
  root_exec chown root:root -- "$SNAPPER_LIFECYCLE_LOCK" || die "could not set Snapper lifecycle lock ownership: $SNAPPER_LIFECYCLE_LOCK"
  root_exec chmod 0644 -- "$SNAPPER_LIFECYCLE_LOCK" || die "could not secure Snapper lifecycle lock: $SNAPPER_LIFECYCLE_LOCK"
  validate_root_metadata "$SNAPPER_LIFECYCLE_LOCK" 'Snapper lifecycle lock'
  mode="$(root_stat %a "$SNAPPER_LIFECYCLE_LOCK")" || die "could not inspect Snapper lifecycle lock mode: $SNAPPER_LIFECYCLE_LOCK"
  [[ "$mode" == 644 ]] || die "Snapper lifecycle lock must be mode 0644: $SNAPPER_LIFECYCLE_LOCK (mode $mode)"
}

acquire_snapper_lifecycle_lock() {
  [[ "$SNAPPER_LIFECYCLE_LOCK_HELD" == true ]] && return 0
  ensure_snapper_lifecycle_lock_file
  exec {SNAPPER_LIFECYCLE_LOCK_FD}<"$SNAPPER_LIFECYCLE_LOCK" ||
    die "could not open Snapper lifecycle lock: $SNAPPER_LIFECYCLE_LOCK"
  if ! flock -n "$SNAPPER_LIFECYCLE_LOCK_FD"; then
    exec {SNAPPER_LIFECYCLE_LOCK_FD}<&-
    SNAPPER_LIFECYCLE_LOCK_FD=""
    die "could not acquire Snapper lifecycle lock: $SNAPPER_LIFECYCLE_LOCK"
  fi
  SNAPPER_LIFECYCLE_LOCK_HELD=true
}

release_snapper_lifecycle_lock() {
  [[ "$SNAPPER_LIFECYCLE_LOCK_HELD" == true ]] || return 0
  flock -u "$SNAPPER_LIFECYCLE_LOCK_FD" || return 1
  exec {SNAPPER_LIFECYCLE_LOCK_FD}<&-
  SNAPPER_LIFECYCLE_LOCK_FD=""
  SNAPPER_LIFECYCLE_LOCK_HELD=false
}

validate_root_metadata() {
  local -r path="$1"
  local -r description="$2"
  local uid
  local gid
  local mode
  local mode_bits

  uid="$(root_stat %u "$path")" || die "could not inspect $description owner: $path"
  gid="$(root_stat %g "$path")" || die "could not inspect $description group: $path"
  mode="$(root_stat %a "$path")" || die "could not inspect $description mode: $path"
  [[ "$uid" == 0 && "$gid" == 0 ]] || die "$description must be root:root: $path"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "$description has an invalid mode: $path ($mode)"
  mode_bits="${mode: -3}"
  (( (8#$mode_bits & 0022) == 0 )) || die "$description must not be group/world writable: $path (mode $mode)"
}

validate_root_directory() {
  local -r path="$1"

  root_test -d "$path" || die "root-controlled directory is missing: $path"
  root_test ! -L "$path" || die "root-controlled directory must not be a symlink: $path"
  validate_root_metadata "$path" 'root-controlled directory'
}

validate_root_directory_chain() {
  local -r path="$1"
  local component
  local current="/"
  local remainder

  [[ "$path" == /* ]] || die "root-controlled path must be absolute: $path"
  remainder="${path#/}"
  validate_root_directory /

  while [[ -n "$remainder" ]]; do
    component="${remainder%%/*}"
    if [[ "$remainder" == */* ]]; then
      remainder="${remainder#*/}"
    else
      remainder=""
    fi

    [[ -n "$component" ]] || continue
    current="$current$component"
    validate_root_directory "$current"
    current="$current/"
  done
}

ensure_root_directory() {
  local -r path="$1"
  local -r mode="$2"
  local -r description="$3"
  local actual_mode
  local expected_mode="${mode#0}"

  root_test -L "$path" && die "$description must not be a symlink: $path"
  if root_test -e "$path"; then
    validate_root_directory "$path"
    root_exec chown root:root -- "$path" || die "could not set $description ownership: $path"
    root_exec chmod "$mode" -- "$path" || die "could not secure $description: $path"
  else
    root_exec mkdir -- "$path" || die "could not create $description: $path"
    root_exec chown root:root -- "$path" || die "could not set $description ownership: $path"
    root_exec chmod "$mode" -- "$path" || die "could not secure $description: $path"
  fi
  validate_root_directory "$path"
  actual_mode="$(root_stat %a "$path")" || die "could not inspect $description mode: $path"
  [[ "$actual_mode" == "$expected_mode" ]] || die "$description must be mode $mode: $path (mode $actual_mode)"
}

validate_root_file() {
  local -r path="$1"
  local -r description="$2"

  root_test ! -L "$path" || die "$description must not be a symlink: $path"
  root_test -f "$path" || die "$description is not a regular file: $path"
  validate_root_metadata "$path" "$description"
}

validate_snapper_initializer_path() {
  local -r initializer_parent="${SNAPPER_INITIALIZER%/*}"

  validate_root_directory_chain "$initializer_parent"
  validate_root_file "$SNAPPER_INITIALIZER" 'deployed Snapper initializer'
  root_test -x "$SNAPPER_INITIALIZER" || die "deployed Snapper initializer is not executable: $SNAPPER_INITIALIZER"
}

root_failure() {
  local -r message="$1"
  local rollback_status=0

  if [[ -n "$SNAPPER_JOURNAL_PHASE" && "$SNAPPER_CLEANUP_STARTED" == false ]]; then
    rollback_snapper_deployment || rollback_status=$?
  fi
  SNAPPER_DEPLOYMENT_ACTIVE=false
  if (( rollback_status != 0 )); then
    die "$message; Snapper rollback failed"
  fi
  die "$message"
}

write_root_text_atomic() {
  local -r path="$1"
  local -r content="$2"
  local -r directory="${path%/*}"
  local -r name="${path##*/}"
  local temp_file

  if ! temp_file="$(root_capture mktemp "$directory/.${name}.XXXXXX")"; then
    return 1
  fi
  [[ "$temp_file" == "$directory"/* && "$temp_file" != *$'\n'* ]] || return 1
  if ! printf '%s\n' "$content" | root_exec tee -- "$temp_file" >/dev/null; then
    root_exec rm -f -- "$temp_file" || true
    return 1
  fi
  root_exec chown root:root -- "$temp_file" || return 1
  root_exec chmod 0600 -- "$temp_file" || return 1
  root_exec mv -f -- "$temp_file" "$path" || return 1
  root_exec sync || return 1
  return 0
}

write_snapper_journal_state() {
  local -r phase="$1"
  local -r target="${2:-}"
  local -r staged="${3:-}"

  write_root_text_atomic "$SNAPPER_JOURNAL_FILE" $'version=1\nphase='"$phase"$'\ntarget='"$target"$'\nstaged='"$staged" ||
    die "could not persist Snapper recovery state: $phase"
  SNAPPER_JOURNAL_PHASE="$phase"
}

write_snapper_manifest() {
  write_root_text_atomic "$SNAPPER_MANIFEST_FILE" "$SNAPPER_MANIFEST_CONTENT" ||
    die 'could not persist Snapper recovery manifest'
}

append_snapper_manifest() {
  SNAPPER_MANIFEST_CONTENT+="$1"$'\n'
}

SNAPPER_MANIFEST_CONTENT=""

plan_root_directory_chain() {
  local -r path="$1"
  local component
  local current="/"
  local remainder

  [[ "$path" == /* ]] || die "root-controlled path must be absolute: $path"
  remainder="${path#/}"
  while [[ -n "$remainder" ]]; do
    component="${remainder%%/*}"
    if [[ "$remainder" == */* ]]; then
      remainder="${remainder#*/}"
    else
      remainder=""
    fi
    [[ -n "$component" ]] || continue
    current="$current$component"
    if root_test -L "$current"; then
      die "root-controlled directory must not be a symlink: $current"
    fi
    if root_test -e "$current"; then
      root_test -d "$current" || die "root-controlled path is not a directory: $current"
      validate_root_metadata "$current" 'root-controlled directory'
    else
      append_snapper_manifest "dir|$current"
    fi
    current="$current/"
  done
}

plan_snapper_target() {
  local -r target="$1"
  local -r backup="$2"
  local uid=""
  local gid=""
  local mode=""

  if [[ "$target" == "$SNAPPER_CONFIG_DIRECTORY"/* && "$SNAPPER_LEGACY_CONFIG_LINK" == true ]] ||
    [[ "$target" == "$SNAPPER_REGISTRATION_DIRECTORY"/* && "$SNAPPER_LEGACY_REGISTRATION_LINK" == true ]]; then
    append_snapper_manifest "file|$target|$backup|no|||"
    return 0
  fi

  if root_test -L "$target"; then
    die "Snapper deployment target must not be a symlink: $target"
  fi
  if root_test -e "$target"; then
    root_test -f "$target" || die "Snapper deployment target is not a regular file: $target"
    uid="$(root_stat %u "$target")" || die "could not inspect Snapper target owner: $target"
    gid="$(root_stat %g "$target")" || die "could not inspect Snapper target group: $target"
    mode="$(root_stat %a "$target")" || die "could not inspect Snapper target mode: $target"
    append_snapper_manifest "file|$target|$backup|yes|$uid|$gid|$mode"
  else
    append_snapper_manifest "file|$target|$backup|no|||"
  fi
}

plan_legacy_snapper_directory() {
  local -r target="$1"
  local -r expected_target="$2"
  local -r backup="$3"
  local link_target

  if root_test -L "$target"; then
    link_target="$(root_capture readlink -- "$target")" || die "could not inspect legacy Snapper link: $target"
    [[ "$link_target" == "$expected_target" ]] ||
      die "refusing to remove unmanaged Snapper link: $target -> $link_target"
    if [[ "$target" == "$SNAPPER_CONFIG_DIRECTORY" ]]; then
      SNAPPER_LEGACY_CONFIG_LINK=true
    elif [[ "$target" == "$SNAPPER_REGISTRATION_DIRECTORY" ]]; then
      SNAPPER_LEGACY_REGISTRATION_LINK=true
    fi
    append_snapper_manifest "legacy|$target|$backup|$expected_target"
  elif root_test -e "$target"; then
    validate_root_directory "$target"
  else
    append_snapper_manifest "dir|$target"
  fi
}

prepare_snapper_rollback() {
  local recovery_exists=false

  ensure_root_directory_chain "${SNAPPER_RECOVERY_DIRECTORY%/*}"
  root_test -L "$SNAPPER_RECOVERY_DIRECTORY" && die 'Snapper recovery directory must not be a symlink'
  if root_test -e "$SNAPPER_RECOVERY_DIRECTORY"; then
    recovery_exists=true
  fi
  [[ "$recovery_exists" == true ]] || SNAPPER_ROLLBACK_DIR="$SNAPPER_RECOVERY_DIRECTORY"
  ensure_root_directory "$SNAPPER_RECOVERY_DIRECTORY" 0700 'Snapper recovery directory'
  ensure_root_directory "$SNAPPER_BACKUP_DIRECTORY" 0700 'Snapper backup directory'
  if root_test -x /usr/bin/getfacl; then
    SNAPPER_HAS_GETFACL=true
  fi
  if root_test -x /usr/bin/getfattr; then
    SNAPPER_HAS_GETFATTR=true
  fi
}

ensure_root_directory_chain() {
  local -r path="$1"
  local component
  local current="/"
  local remainder

  [[ "$path" == /* ]] || root_failure "root-controlled path must be absolute: $path"
  remainder="${path#/}"
  validate_root_directory /

  while [[ -n "$remainder" ]]; do
    component="${remainder%%/*}"
    if [[ "$remainder" == */* ]]; then
      remainder="${remainder#*/}"
    else
      remainder=""
    fi

    [[ -n "$component" ]] || continue
    current="$current$component"
    if root_test -L "$current"; then
      root_failure "root-controlled directory must not be a symlink: $current"
    fi
    if root_test -e "$current"; then
      root_test -d "$current" || root_failure "root-controlled path is not a directory: $current"
      validate_root_directory "$current"
    else
      root_exec mkdir -- "$current" || root_failure "could not create root-controlled directory: $current"
      root_exec chown root:root -- "$current" || root_failure "could not set root-controlled directory ownership: $current"
      root_exec chmod 0755 -- "$current" || root_failure "could not secure root-controlled directory: $current"
    fi
    validate_root_directory "$current"
    current="$current/"
  done
}

move_legacy_snapper_directory() {
  local -r target="$1"
  local -r expected_target="$2"
  local -r backup="$3"
  local link_target

  if root_test -L "$target"; then
    link_target="$(root_capture readlink -- "$target")" || root_failure "could not inspect legacy Snapper link: $target"
    [[ "$link_target" == "$expected_target" ]] ||
      root_failure "refusing to remove unmanaged Snapper link: $target -> $link_target"
    root_exec mv -- "$target" "$backup" || root_failure "could not preserve managed legacy Snapper link: $target"
    root_exec mkdir -- "$target" || root_failure "could not create Snapper deployment directory: $target"
    root_exec chown root:root -- "$target" || root_failure "could not set Snapper deployment directory ownership: $target"
    root_exec chmod 0755 -- "$target" || root_failure "could not secure Snapper deployment directory: $target"
    return 0
  fi

  root_test -e "$target" || {
    root_exec mkdir -- "$target" || root_failure "could not create Snapper deployment directory: $target"
    root_exec chown root:root -- "$target" || root_failure "could not set Snapper deployment directory ownership: $target"
    root_exec chmod 0755 -- "$target" || root_failure "could not secure Snapper deployment directory: $target"
    return 0
  }
  validate_root_directory "$target"
}

capture_optional_metadata() {
  local -r target="$1"
  local -r backup="$2"
  local metadata

  if [[ "$SNAPPER_HAS_GETFACL" == true ]]; then
    if metadata="$(root_capture /usr/bin/getfacl --absolute-names -- "$target")"; then
      metadata="$(awk '/^(user|group|mask|other|default:)/ { print }' <<<"$metadata")"
      write_root_text_atomic "$backup.acl" "$metadata" || root_failure "could not preserve Snapper ACL: $target"
    fi
  fi
  if [[ "$SNAPPER_HAS_GETFATTR" == true ]]; then
    if metadata="$(root_capture /usr/bin/getfattr --absolute-names --dump -- "$target")"; then
      metadata="$(awk -v target="$target" '
        /^# file:/ {
          if (!replaced) {
            print "# file: " target
            replaced = 1
          }
          next
        }
        { print }
      ' <<<"$metadata")"
      write_root_text_atomic "$backup.xattr" "$metadata" || root_failure "could not preserve Snapper xattrs: $target"
    fi
  fi
}

backup_snapper_targets() {
  local kind
  local target
  local backup
  local present
  local uid
  local gid
  local mode

  while IFS='|' read -r kind target backup present uid gid mode; do
    [[ -n "$kind" ]] || continue
    case "$kind" in
      file)
        if [[ "$present" == yes ]]; then
          root_exec cp --preserve=all -- "$target" "$backup" || root_failure "could not preserve Snapper target: $target"
          capture_optional_metadata "$target" "$backup"
        fi
        ;;
      legacy|dir)
        ;;
      *)
        root_failure "unknown Snapper recovery manifest entry: $kind"
        ;;
    esac
  done <<<"$SNAPPER_MANIFEST_CONTENT"
}

restore_optional_metadata() {
  local -r backup="$1"
  local -r target="$2"

  if [[ "$SNAPPER_HAS_GETFACL" == true ]] && root_test -e "$backup.acl"; then
    root_exec /usr/bin/setfacl --set-file="$backup.acl" -- "$target" || return 1
  fi
  if [[ "$SNAPPER_HAS_GETFATTR" == true ]] && root_test -e "$backup.xattr"; then
    root_exec /usr/bin/setfattr --restore="$backup.xattr" || return 1
  fi
}

restore_snapper_manifest() {
  local status=0
  local -a directories=()
  local target
  local kind
  local index

  while IFS='|' read -r kind target _; do
    [[ "$kind" == dir ]] && directories+=("$target")
  done <<<"$SNAPPER_MANIFEST_CONTENT"

  restore_snapper_manifest_kind file || status=1
  restore_snapper_manifest_kind legacy || status=1
  for ((index = ${#directories[@]} - 1; index >= 0; index--)); do
    target="${directories[$index]}"
    if root_test -e "$target"; then
      root_exec rmdir -- "$target" || status=1
    fi
  done
  return "$status"
}

restore_snapper_manifest_kind() {
  local -r wanted_kind="$1"
  local kind
  local target
  local backup
  local present
  local uid
  local gid
  local mode
  local expected_target
  local link_target
  local status=0

  while IFS='|' read -r kind target backup present uid gid mode expected_target; do
    [[ "$kind" == "$wanted_kind" ]] || continue
    case "$kind" in
      file)
        if root_test -L "$target"; then
          status=1
          continue
        fi
        if root_test -e "$target"; then
          root_exec rm -f -- "$target" || status=1
        fi
        if [[ "$present" == yes ]]; then
          root_exec cp --preserve=all -- "$backup" "$target" || status=1
          root_exec chown "$uid:$gid" -- "$target" || status=1
          root_exec chmod "$mode" -- "$target" || status=1
          restore_optional_metadata "$backup" "$target" || status=1
        fi
        ;;
      legacy)
        expected_target="$present"
        if root_test -L "$target"; then
          link_target="$(root_capture readlink -- "$target")" || status=1
          if [[ "$link_target" != "$expected_target" ]]; then
            status=1
          elif root_test -e "$backup" || root_test -L "$backup"; then
            root_exec rmdir -- "$target" || status=1
            root_exec mv -- "$backup" "$target" || status=1
          fi
        elif root_test -e "$target"; then
          root_exec rmdir -- "$target" || status=1
          if root_test -e "$backup" || root_test -L "$backup"; then
            root_exec mv -- "$backup" "$target" || status=1
          else
            status=1
          fi
        elif root_test -e "$backup" || root_test -L "$backup"; then
          root_exec mv -- "$backup" "$target" || status=1
        fi
        ;;
      *)
        status=1
        ;;
    esac
  done <<<"$SNAPPER_MANIFEST_CONTENT"
  return "$status"
}

read_snapper_recovery_file() {
  local -r path="$1"

  root_capture cat -- "$path"
}

recover_snapper_deployment() {
  local state
  local phase
  local staged

  root_test ! -L "$SNAPPER_RECOVERY_DIRECTORY" || die 'Snapper recovery directory must not be a symlink'
  if ! root_test -e "$SNAPPER_RECOVERY_DIRECTORY"; then
    return 0
  fi
  validate_root_directory_chain "${SNAPPER_RECOVERY_DIRECTORY%/*}"
  validate_root_directory "$SNAPPER_RECOVERY_DIRECTORY"
  [[ "$(root_stat %a "$SNAPPER_RECOVERY_DIRECTORY")" == 700 ]] ||
    die "Snapper recovery directory must be mode 0700: $SNAPPER_RECOVERY_DIRECTORY"
  if root_test -e "$SNAPPER_BACKUP_DIRECTORY" || root_test -L "$SNAPPER_BACKUP_DIRECTORY"; then
    validate_root_directory "$SNAPPER_BACKUP_DIRECTORY"
    [[ "$(root_stat %a "$SNAPPER_BACKUP_DIRECTORY")" == 700 ]] ||
      die "Snapper backup directory must be mode 0700: $SNAPPER_BACKUP_DIRECTORY"
  fi
  root_test -f "$SNAPPER_JOURNAL_FILE" || die 'Snapper recovery journal is missing; manual recovery is required'
  root_test -f "$SNAPPER_MANIFEST_FILE" || die 'Snapper recovery manifest is missing; manual recovery is required'
  state="$(read_snapper_recovery_file "$SNAPPER_JOURNAL_FILE")" || die 'could not read Snapper recovery journal'
  phase="$(awk -F= '$1 == "phase" { print $2; exit }' <<<"$state")"
  staged="$(awk -F= '$1 == "staged" { print $2; exit }' <<<"$state")"
  if [[ -n "$staged" ]]; then
    [[ "$staged" == /* && "$staged" != *$'\n'* && "$staged" != *'/../'* ]] ||
      die 'Snapper recovery staged path is invalid; manual recovery is required'
    root_exec rm -f -- "$staged" || die 'could not remove incomplete staged Snapper file'
  fi
  SNAPPER_MANIFEST_CONTENT="$(read_snapper_recovery_file "$SNAPPER_MANIFEST_FILE")" ||
    die 'could not read Snapper recovery manifest'
  case "$phase" in
    cleanup)
      die 'Snapper deployment cleanup is incomplete; manual recovery is required'
      ;;
    planned|preparing|backing-up|backed-up)
      if ! remove_snapper_manifest_directories; then
        die 'Snapper preparation recovery failed; journal and backups were retained for manual recovery'
      fi
      root_exec rm -rf -- "$SNAPPER_RECOVERY_DIRECTORY" ||
        die 'Snapper recovery state cleanup failed; manual recovery is required'
      printf 'bootstrap: discarded incomplete Snapper preparation before continuing\n'
      ;;
    deploying)
      SNAPPER_HAS_GETFACL=false
      SNAPPER_HAS_GETFATTR=false
      root_test -x /usr/bin/getfacl && SNAPPER_HAS_GETFACL=true
      root_test -x /usr/bin/getfattr && SNAPPER_HAS_GETFATTR=true
      if ! restore_snapper_manifest; then
        die 'Snapper recovery failed; journal and backups were retained for manual recovery'
      fi
      root_exec rm -rf -- "$SNAPPER_RECOVERY_DIRECTORY" ||
        die 'Snapper recovery state cleanup failed; manual recovery is required'
      printf 'bootstrap: recovered incomplete Snapper deployment before continuing\n'
      ;;
    *)
      die "unknown Snapper recovery phase: $phase"
      ;;
  esac
}

stage_snapper_file() {
  local -r source="$1"
  local -r target="$2"
  local -r mode="$3"
  local -r directory="${target%/*}"
  local -r name="${target##*/}"
  local temp_file

  [[ -f "$source" && ! -L "$source" ]] || root_failure "Snapper source is not a regular file: $source"
  if ! temp_file="$(root_capture mktemp "$directory/.${name}.XXXXXX")"; then
    root_failure "could not create staged Snapper file: $target"
  fi
  [[ "$temp_file" == "$directory"/* && "$temp_file" != *$'\n'* ]] ||
    root_failure "staged Snapper file escaped its destination directory: $target"
  SNAPPER_STAGED_TEMP="$temp_file"
  write_snapper_journal_state deploying "$target" "$temp_file"
  root_exec cp -- "$source" "$temp_file" || root_failure "could not stage Snapper file: $target"
  root_exec chown root:root -- "$temp_file" || root_failure "could not set staged Snapper ownership: $target"
  root_exec chmod "$mode" -- "$temp_file" || root_failure "could not set staged Snapper mode: $target"
  root_exec mv -f -- "$temp_file" "$target" || root_failure "could not atomically install Snapper file: $target"
  SNAPPER_STAGED_TEMP=""
  write_snapper_journal_state deploying "$target"
}

rollback_snapper_deployment() {
  local status=0

  if [[ -n "$SNAPPER_STAGED_TEMP" ]]; then
    if root_exec rm -f -- "$SNAPPER_STAGED_TEMP"; then
      SNAPPER_STAGED_TEMP=""
    else
      status=1
    fi
  fi

  if [[ "$SNAPPER_JOURNAL_PHASE" == deploying ]]; then
    if ! restore_snapper_manifest; then
      status=1
    fi
  elif [[ -n "$SNAPPER_JOURNAL_PHASE" ]]; then
    if ! remove_snapper_manifest_directories; then
      status=1
    fi
  fi
  if (( status == 0 )) && [[ -n "$SNAPPER_ROLLBACK_DIR" ]]; then
    root_exec rm -rf -- "$SNAPPER_ROLLBACK_DIR" || status=1
  fi
  return "$status"
}

remove_snapper_manifest_directories() {
  local kind
  local target
  local -a directories=()
  local index
  local status=0

  while IFS='|' read -r kind target _; do
    [[ "$kind" == dir ]] && directories+=("$target")
  done <<<"$SNAPPER_MANIFEST_CONTENT"
  for ((index = ${#directories[@]} - 1; index >= 0; index--)); do
    target="${directories[$index]}"
    if root_test -e "$target"; then
      root_exec rmdir -- "$target" || status=1
    fi
  done
  return "$status"
}

cleanup_snapper_staging_files() {
  local -a directories=(
    "$SNAPPER_CONFIG_DIRECTORY"
    "$SNAPPER_CONFIG_DIRECTORY"
    "$SNAPPER_REGISTRATION_DIRECTORY"
    "${SNAPPER_INITIALIZER%/*}"
  )
  local -a names=(root home snapper snapper-initialize)
  local index

  for ((index = 0; index < ${#directories[@]}; index++)); do
    root_exec find -- "${directories[$index]}" -maxdepth 1 -type f -name ".${names[$index]}.??????" -delete ||
      root_failure "could not clean incomplete staged Snapper file: ${directories[$index]}/${names[$index]}"
  done
}

root_run_initializer() {
  if [[ "${1:-}" == --check ]]; then
    root_exec env -i "PATH=$SNAPPER_FIXED_PATH" "$SNAPPER_INITIALIZER" "$@"
  else
    root_exec env -i "PATH=$SNAPPER_FIXED_PATH" SNAPPER_INTERNAL_LIFECYCLE_LOCK_HELD=1 "$SNAPPER_INITIALIZER" "$@"
  fi
}

retain_snapper_cleanup_state() {
  write_snapper_journal_state cleanup
  write_snapper_manifest
}

finalize_snapper_deployment() {
  SNAPPER_CLEANUP_STARTED=true
  write_snapper_journal_state cleanup
  if ! root_exec rm -rf -- "$SNAPPER_BACKUP_DIRECTORY"; then
    die 'Snapper deployment cleanup failed; backup contents may be partial; journal and manifest were retained for manual recovery'
  fi
  if ! root_exec rm -f -- "$SNAPPER_JOURNAL_FILE" "$SNAPPER_MANIFEST_FILE"; then
    retain_snapper_cleanup_state || die 'Snapper deployment journal cleanup failed and recovery state could not be retained'
    die 'Snapper deployment journal cleanup failed; journal and manifest were retained for manual recovery'
  fi
  if ! root_exec rmdir -- "$SNAPPER_RECOVERY_DIRECTORY"; then
    retain_snapper_cleanup_state || die 'Snapper deployment recovery cleanup failed and recovery state could not be retained'
    die 'Snapper deployment recovery directory cleanup failed; journal and manifest were retained for manual recovery'
  fi
  SNAPPER_ROLLBACK_DIR=""
  SNAPPER_DEPLOYMENT_ACTIVE=false
}

deploy_snapper_files() {
  local -a sources=(
    "$REPO_ROOT/Linux/Snapper/configs/root"
    "$REPO_ROOT/Linux/Snapper/configs/home"
    "$REPO_ROOT/Linux/Snapper/conf.d/snapper"
    "$REPO_ROOT/Linux/Snapper/snapper-initialize"
  )
  local -a targets=(
    "$SNAPPER_CONFIG_DIRECTORY/root"
    "$SNAPPER_CONFIG_DIRECTORY/home"
    "$SNAPPER_REGISTRATION_DIRECTORY/snapper"
    "$SNAPPER_INITIALIZER"
  )
  local -a modes=(0644 0644 0644 0755)
  local -a backup_names=(root home registration initializer)
  local index

  SNAPPER_DEPLOYMENT_ACTIVE=true
  SNAPPER_MANIFEST_CONTENT=""
  SNAPPER_LEGACY_CONFIG_LINK=false
  SNAPPER_LEGACY_REGISTRATION_LINK=false
  prepare_snapper_rollback
  plan_root_directory_chain "${SNAPPER_CONFIG_DIRECTORY%/*}"
  plan_root_directory_chain "${SNAPPER_REGISTRATION_DIRECTORY%/*}"
  plan_root_directory_chain "${SNAPPER_INITIALIZER%/*}"
  if root_test -L "$SNAPPER_INITIALIZER"; then
    root_failure "deployed Snapper initializer must not already be a symlink: $SNAPPER_INITIALIZER"
  fi
  if root_test -e "$SNAPPER_INITIALIZER"; then
    root_test -f "$SNAPPER_INITIALIZER" || root_failure "deployed Snapper initializer target is not a regular file: $SNAPPER_INITIALIZER"
  fi
  plan_legacy_snapper_directory "$SNAPPER_CONFIG_DIRECTORY" "$REPO_ROOT/Linux/Snapper/configs" "$SNAPPER_BACKUP_DIRECTORY/legacy-configs"
  plan_legacy_snapper_directory "$SNAPPER_REGISTRATION_DIRECTORY" "$REPO_ROOT/Linux/Snapper/conf.d" "$SNAPPER_BACKUP_DIRECTORY/legacy-conf.d"

  for ((index = 0; index < ${#targets[@]}; index++)); do
    plan_snapper_target "${targets[$index]}" "$SNAPPER_BACKUP_DIRECTORY/${backup_names[$index]}"
  done
  write_snapper_manifest
  write_snapper_journal_state preparing
  ensure_root_directory_chain "${SNAPPER_CONFIG_DIRECTORY%/*}"
  ensure_root_directory_chain "${SNAPPER_REGISTRATION_DIRECTORY%/*}"
  ensure_root_directory_chain "${SNAPPER_INITIALIZER%/*}"
  cleanup_snapper_staging_files
  write_snapper_journal_state backing-up
  backup_snapper_targets
  write_snapper_journal_state backed-up
  write_snapper_journal_state deploying
  move_legacy_snapper_directory "$SNAPPER_CONFIG_DIRECTORY" "$REPO_ROOT/Linux/Snapper/configs" "$SNAPPER_BACKUP_DIRECTORY/legacy-configs"
  move_legacy_snapper_directory "$SNAPPER_REGISTRATION_DIRECTORY" "$REPO_ROOT/Linux/Snapper/conf.d" "$SNAPPER_BACKUP_DIRECTORY/legacy-conf.d"
  for ((index = 0; index < ${#targets[@]}; index++)); do
    stage_snapper_file "${sources[$index]}" "${targets[$index]}" "${modes[$index]}"
    write_snapper_journal_state deploying "${targets[$index]}"
  done
}

run_snapper_initializer() {
  printf '  sudo -n -- env -i PATH=%s %s --apply\n' "$SNAPPER_FIXED_PATH" "$SNAPPER_INITIALIZER"
  printf '  sudo -n -- env -i PATH=%s %s --create-initial-snapshots\n' "$SNAPPER_FIXED_PATH" "$SNAPPER_INITIALIZER"
  printf '  sudo -n -- env -i PATH=%s %s --check\n' "$SNAPPER_FIXED_PATH" "$SNAPPER_INITIALIZER"

  [[ "$DRY_RUN" == true ]] && return 0

  validate_snapper_initializer_path
  if ! root_run_initializer --apply; then
    root_failure 'failed to apply Snapper initializer'
  fi
  finalize_snapper_deployment
  if ! root_run_initializer --create-initial-snapshots; then
    die 'failed to create initial Snapper recovery snapshots'
  fi
  if ! root_run_initializer --check; then
    die 'failed to validate initial Snapper recovery snapshots'
  fi
}

list_tidydots() {
  if ! (cd -- "$REPO_ROOT" && tidydots --dir "$REPO_ROOT" list); then
    die 'failed to list tidydots configuration'
  fi
}

print_post_install_boundaries() {
  printf '\nPost-install boundaries:\n'
  printf '  SSH private keys, browser profiles, tokens, application data, and personal documents were not restored.\n'
  printf 'Next actions:\n'
  printf '  reboot, authenticate applications, restore personal data separately, and rerun Linux/install/bootstrap --dry-run to confirm convergence.\n'
}

apply_tidydots() {
  if [[ "$DRY_RUN" == false ]]; then
    confirm_privileged_operations
  fi
  if [[ "$SNAPPER_CAPABILITY" == custom-archinstall-layout && "$DRY_RUN" == false ]]; then
    acquire_snapper_lifecycle_lock
    recover_snapper_deployment
  fi
  list_tidydots
  run_tidydots_phase install
  if [[ "$SNAPPER_CAPABILITY" == custom-archinstall-layout ]]; then
    print_snapper_deployment_plan
    if [[ "$DRY_RUN" == true ]]; then
      printf '  Btrfs topology validation is required before apply\n'
    else
      confirm_snapper_deployment
      deploy_snapper_files
    fi
    run_snapper_initializer
  fi
  run_tidydots_phase restore

  [[ "$DRY_RUN" == true ]] || print_post_install_boundaries
}

report_incomplete_dry_run() {
  printf 'bootstrap: incomplete dry-run: tidydots is unavailable\n'
  printf 'Skipped tidydots package phase (install).\n'
  printf 'Skipped tidydots configuration phase (restore).\n'
  printf 'Install tidydots and rerun Linux/install/bootstrap --dry-run.\n'
  exit "$EXIT_INCOMPLETE_PREVIEW"
}

clear_initializer_overrides() {
  local variable

  while IFS= read -r variable; do
    case "$variable" in
      SNAPPER_INITIALIZER_*) unset "$variable" ;;
    esac
  done < <(compgen -e)
}

bootstrap_main() {
  clear_initializer_overrides
  parse_args "$@"
  preflight
  if [[ "$SNAPPER_CAPABILITY" == custom-archinstall-layout && "$DRY_RUN" == false ]]; then
    confirm_privileged_operations
  fi
  validate_snapper_topology
  install_prerequisites
  if command_available tidydots; then
    apply_tidydots
  elif [[ "$DRY_RUN" == true ]]; then
    report_incomplete_dry_run
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  bootstrap_main "$@"
fi
