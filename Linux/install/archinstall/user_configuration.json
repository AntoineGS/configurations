    "base-devel",
    "git",
    "iwd",
    "linux-headers",
    "sudo"
  ],
  "services": [
    "iwd",
    "systemd-networkd",
    "systemd-resolved"
  ],
  "swap": true,
  "timezone": "America/Toronto"
}
