anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

[]
invisible=true

[mode=rustdesk-route-DVI-D-1]
output=DVI-D-1
invisible=false

[mode=rustdesk-route-HDMI-A-1]
output=HDMI-A-1
invisible=false

[mode=rustdesk-route-DP-2]
output=DP-2
invisible=false

[mode=rustdesk-route-DP-1]
output=DP-1
invisible=false

[mode=rustdesk-route-eDP-1]
output=eDP-1
invisible=false

[mode=rustdesk-route-hidden]
invisible=true

[mode=rustdesk-cue]
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[app-name=Spotify]
invisible=1
on-notify=none

[mode=do-not-disturb]
invisible=true
on-notify=none

[mode=rustdesk-route-DVI-D-1 app-name=notify-send]
invisible=false
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[mode=rustdesk-route-HDMI-A-1 app-name=notify-send]
invisible=false
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[mode=rustdesk-route-DP-2 app-name=notify-send]
invisible=false
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[mode=rustdesk-route-DP-1 app-name=notify-send]
invisible=false
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[mode=rustdesk-route-eDP-1 app-name=notify-send]
invisible=false
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[mode=rustdesk-route-hidden app-name=notify-send]
on-notify=exec ~/.config/mako/rustdesk-notification-cue "$id"

[app-name=notify-send category=rustdesk-notification-cue-DVI-D-1 summary~="^(←|→|↑|↓|•)$" body=""]
output=DVI-D-1
invisible=false
on-notify=none
icons=0
actions=0
history=0
format=%s
text-alignment=center
font=sans-serif 28px
default-timeout=5000
layer=overlay

