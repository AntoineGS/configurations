[urgency=critical]
default-timeout=0
layer=overlay

[summary~="Setup Wi-Fi"]
on-button-left=exec sh -c 'notification-dismiss "Setup Wi-Fi"; launch-wifi'

[summary~="Update System"]
on-button-left=exec sh -c 'notification-dismiss "Update System"; launch-floating-terminal-with-presentation update'

[summary~="Learn Keybindings"]
on-button-left=exec sh -c 'notification-dismiss "Learn Keybindings"; menu-keybindings'

[summary~="Screenshot copied & saved"]
max-icon-size=80
format=<b>%s</b>\n%b

text-color=#cdd6f4
border-color=#89b4fa
background-color=#1e1e2e
